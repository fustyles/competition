<xml xmlns="https://developers.google.com/blockly/xml" platform="blockly">
  <variables>
    <variable id="v01">N</variable>
    <variable id="l01">地圖</variable>
    <variable id="v02">數值</variable>
    <variable id="v03">M</variable>
    <variable id="v04">位置</variable>
    <variable id="v05">能量</variable>
    <variable id="v06">最高</variable>
    <variable id="v07">點數</variable>
  </variables>
  <block x="20" y="20" type="javascript_data_input_scratch">
    <value name="TEXT">
      <shadow type="text_noquotes">
        <field name="TEXT"/>
      </shadow>
    </value>
    <next>
      <block type="variables_set_local">
        <field name="VAR" id="v01">N</field>
        <value name="VALUE">
          <block type="javascript_data_input_get_scratch"/>
        </value>
        <next>
          <block type="variables_set_local">
            <field name="VAR" id="l01">地圖</field>
            <value name="VALUE">
              <block type="lists_create_with">
                <mutation items="0"/>
              </block>
            </value>
            <next>
              <block type="controls_repeat_ext">
                <value name="TIMES">
                  <block type="variables_get">
                    <field name="VAR" id="v01">N</field>
                  </block>
                </value>
                <statement name="DO">
                  <block type="javascript_data_input_scratch">
                    <value name="TEXT">
                      <shadow type="text_noquotes">
                        <field name="TEXT"/>
                      </shadow>
                    </value>
                    <next>
                      <block type="variables_set_local">
                        <field name="VAR" id="v02">數值</field>
                        <value name="VALUE">
                          <block type="javascript_data_input_get_scratch"/>
                        </value>
                        <next>
                          <block type="lists_setIndex">
                            <mutation at="false"/>
                            <field name="MODE">INSERT</field>
                            <field name="WHERE">LAST</field>
                            <value name="LIST">
                              <block type="variables_get">
                                <field name="VAR" id="l01">地圖</field>
                              </block>
                            </value>
                            <value name="TO">
                              <block type="variables_get">
                                <field name="VAR" id="v02">數值</field>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </statement>
                <next>
                  <block type="javascript_data_input_scratch">
                    <value name="TEXT">
                      <shadow type="text_noquotes">
                        <field name="TEXT"/>
                      </shadow>
                    </value>
                    <next>
                      <block type="variables_set_local">
                        <field name="VAR" id="v03">M</field>
                        <value name="VALUE">
                          <block type="javascript_data_input_get_scratch"/>
                        </value>
                        <next>
                          <block type="variables_set_local">
                            <field name="VAR" id="v04">位置</field>
                            <value name="VALUE">
                              <block type="math_number">
                                <field name="NUM">1</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set_local">
                                <field name="VAR" id="v05">能量</field>
                                <value name="VALUE">
                                  <block type="math_number">
                                    <field name="NUM">0</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="variables_set_local">
                                    <field name="VAR" id="v06">最高</field>
                                    <value name="VALUE">
                                      <block type="math_number">
                                        <field name="NUM">0</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="controls_repeat_ext">
                                        <value name="TIMES">
                                          <block type="variables_get">
                                            <field name="VAR" id="v03">M</field>
                                          </block>
                                        </value>
                                        <statement name="DO">
                                          <block type="javascript_data_input_scratch">
                                            <value name="TEXT">
                                              <shadow type="text_noquotes">
                                                <field name="TEXT"/>
                                              </shadow>
                                            </value>
                                            <next>
                                              <block type="variables_set_local">
                                                <field name="VAR" id="v07">點數</field>
                                                <value name="VALUE">
                                                  <block type="javascript_data_input_get_scratch"/>
                                                </value>
                                                <next>
                                                  <block type="variables_set_local">
                                                    <field name="VAR" id="v04">位置</field>
                                                    <value name="VALUE">
                                                      <block type="math_arithmetic">
                                                        <field name="OP">ADD</field>
                                                        <value name="A">
                                                          <block type="math_modulo">
                                                            <value name="DIVIDEND">
                                                              <block type="math_arithmetic">
                                                                <field name="OP">MINUS</field>
                                                                <value name="A">
                                                                  <block type="math_arithmetic">
                                                                    <field name="OP">ADD</field>
                                                                    <value name="A">
                                                                      <block type="variables_get">
                                                                        <field name="VAR" id="v04">位置</field>
                                                                      </block>
                                                                    </value>
                                                                    <value name="B">
                                                                      <block type="variables_get">
                                                                        <field name="VAR" id="v07">點數</field>
                                                                      </block>
                                                                    </value>
                                                                  </block>
                                                                </value>
                                                                <value name="B">
                                                                  <block type="math_number">
                                                                    <field name="NUM">1</field>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </value>
                                                            <value name="DIVISOR">
                                                              <block type="variables_get">
                                                                <field name="VAR" id="v01">N</field>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </value>
                                                        <value name="B">
                                                          <block type="math_number">
                                                            <field name="NUM">1</field>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </value>
                                                    <next>
                                                      <block type="variables_set_local">
                                                        <field name="VAR" id="v05">能量</field>
                                                        <value name="VALUE">
                                                          <block type="math_arithmetic">
                                                            <field name="OP">ADD</field>
                                                            <value name="A">
                                                              <block type="variables_get">
                                                                <field name="VAR" id="v05">能量</field>
                                                              </block>
                                                            </value>
                                                            <value name="B">
                                                              <block type="lists_getIndex">
                                                                <mutation statement="false" at="true"/>
                                                                <field name="MODE">GET</field>
                                                                <field name="WHERE">FROM_START</field>
                                                                <value name="VALUE">
                                                                  <block type="variables_get">
                                                                    <field name="VAR" id="l01">地圖</field>
                                                                  </block>
                                                                </value>
                                                                <value name="AT">
                                                                  <block type="variables_get">
                                                                    <field name="VAR" id="v04">位置</field>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </value>
                                                        <next>
                                                          <block type="controls_if">
                                                            <mutation elseif="1" else="0"/>
                                                            <value name="IF0">
                                                              <block type="logic_compare">
                                                                <field name="OP">GT</field>
                                                                <value name="A">
                                                                  <block type="variables_get">
                                                                    <field name="VAR" id="v05">能量</field>
                                                                  </block>
                                                                </value>
                                                                <value name="B">
                                                                  <block type="math_number">
                                                                    <field name="NUM">50</field>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </value>
                                                            <statement name="DO0">
                                                              <block type="variables_set_local">
                                                                <field name="VAR" id="v05">能量</field>
                                                                <value name="VALUE">
                                                                  <block type="math_number">
                                                                    <field name="NUM">50</field>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </statement>
                                                            <value name="IF1">
                                                              <block type="logic_compare">
                                                                <field name="OP">LTE</field>
                                                                <value name="A">
                                                                  <block type="variables_get">
                                                                    <field name="VAR" id="v05">能量</field>
                                                                  </block>
                                                                </value>
                                                                <value name="B">
                                                                  <block type="math_number">
                                                                    <field name="NUM">0</field>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </value>
                                                            <statement name="DO1">
                                                              <block type="variables_set_local">
                                                                <field name="VAR" id="v05">能量</field>
                                                                <value name="VALUE">
                                                                  <block type="math_number">
                                                                    <field name="NUM">5</field>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </statement>
                                                            <next>
                                                              <block type="controls_if">
                                                                <value name="IF0">
                                                                  <block type="logic_compare">
                                                                    <field name="OP">GT</field>
                                                                    <value name="A">
                                                                      <block type="variables_get">
                                                                        <field name="VAR" id="v05">能量</field>
                                                                      </block>
                                                                    </value>
                                                                    <value name="B">
                                                                      <block type="variables_get">
                                                                        <field name="VAR" id="v06">最高</field>
                                                                      </block>
                                                                    </value>
                                                                  </block>
                                                                </value>
                                                                <statement name="DO0">
                                                                  <block type="variables_set_local">
                                                                    <field name="VAR" id="v06">最高</field>
                                                                    <value name="VALUE">
                                                                      <block type="variables_get">
                                                                        <field name="VAR" id="v05">能量</field>
                                                                      </block>
                                                                    </value>
                                                                  </block>
                                                                </statement>
                                                              </block>
                                                            </next>
                                                          </block>
                                                        </next>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </statement>
                                        <next>
                                          <block type="javascript_data_output">
                                            <value name="TEXT">
                                              <shadow type="text"><field name="TEXT"/></shadow>
                                              <block type="variables_get">
                                                <field name="VAR" id="v05">能量</field>
                                              </block>
                                            </value>
                                            <next>
                                              <block type="javascript_data_output">
                                                <value name="TEXT">
                                                  <shadow type="text"><field name="TEXT"/></shadow>
                                                  <block type="variables_get">
                                                    <field name="VAR" id="v06">最高</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

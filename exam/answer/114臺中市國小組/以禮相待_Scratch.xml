<xml xmlns="https://developers.google.com/blockly/xml" platform="scratch">
  <variables>
    <variable type="other" id="v01">花費金額</variable>
    <variable type="other" id="v02">中獎金額</variable>
    <variable type="other" id="v03">盈餘</variable>
  </variables>
  <block type="javascript_start_scratch" x="20" y="20">
    <next>
      <block type="javascript_data_input_scratch">
        <value name="TEXT">
          <shadow type="text_noquotes">
            <field name="TEXT"/>
          </shadow>
        </value>
        <next>
          <block type="variables_set_other">
            <field name="VAR" id="v01" variabletype="other">花費金額</field>
            <value name="VALUE">
              <shadow type="text_noquotes">
                <field name="TEXT">0</field>
              </shadow>
              <block type="javascript_data_input_get_scratch"/>
            </value>
            <next>
              <block type="javascript_data_input_scratch">
                <value name="TEXT">
                  <shadow type="text_noquotes">
                    <field name="TEXT"/>
                  </shadow>
                </value>
                <next>
                  <block type="variables_set_other">
                    <field name="VAR" id="v02" variabletype="other">中獎金額</field>
                    <value name="VALUE">
                      <shadow type="text_noquotes">
                        <field name="TEXT">0</field>
                      </shadow>
                      <block type="javascript_data_input_get_scratch"/>
                    </value>
                    <next>
                      <block type="variables_set_other">
                        <field name="VAR" id="v03" variabletype="other">盈餘</field>
                        <value name="VALUE">
                          <shadow type="text_noquotes">
                            <field name="TEXT">0</field>
                          </shadow>
                          <block type="math_arithmetic">
                            <field name="OP">MINUS</field>
                            <value name="A">
                              <shadow type="math_number">
                                <field name="NUM">0</field>
                              </shadow>
                              <block type="variables_get_other">
                                <field name="VAR" id="v02" variabletype="other">中獎金額</field>
                              </block>
                            </value>
                            <value name="B">
                              <shadow type="math_number">
                                <field name="NUM">0</field>
                              </shadow>
                              <block type="variables_get_other">
                                <field name="VAR" id="v01" variabletype="other">花費金額</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <next>
                          <block type="controls_if_2_scratch">
                            <value name="condition">
                              <block type="logic_compare">
                                <field name="OP">LTE</field>
                                <value name="A">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">0</field>
                                  </shadow>
                                  <block type="variables_get_other">
                                    <field name="VAR" id="v03" variabletype="other">盈餘</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">0</field>
                                  </shadow>
                                </value>
                              </block>
                            </value>
                            <statement name="statement_if">
                              <block type="javascript_data_output_scratch">
                                <value name="TEXT">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">無盈餘</field>
                                  </shadow>
                                </value>
                              </block>
                            </statement>
                            <statement name="statement_else">
                              <block type="controls_if_1_scratch">
                                <value name="condition">
                                  <block type="logic_compare">
                                    <field name="OP">GT</field>
                                    <value name="A">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">0</field>
                                      </shadow>
                                      <block type="variables_get_other">
                                        <field name="VAR" id="v03" variabletype="other">盈餘</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">200</field>
                                      </shadow>
                                    </value>
                                  </block>
                                </value>
                                <statement name="statement_if">
                                  <block type="variables_set_other">
                                    <field name="VAR" id="v03" variabletype="other">盈餘</field>
                                    <value name="VALUE">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">0</field>
                                      </shadow>
                                      <block type="math_arithmetic">
                                        <field name="OP">MINUS</field>
                                        <value name="A">
                                          <shadow type="math_number">
                                            <field name="NUM">0</field>
                                          </shadow>
                                          <block type="variables_get_other">
                                            <field name="VAR" id="v03" variabletype="other">盈餘</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <shadow type="math_number">
                                            <field name="NUM">100</field>
                                          </shadow>
                                        </value>
                                      </block>
                                    </value>
                                  </block>
                                </statement>
                                <next>
                                  <block type="javascript_data_output_scratch">
                                    <value name="TEXT">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT"/>
                                      </shadow>
                                      <block type="text_join_scratch">
                                        <value name="VALUE1">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT">abc</field>
                                          </shadow>
                                          <block type="variables_get_other">
                                            <field name="VAR" id="v03" variabletype="other">盈餘</field>
                                          </block>
                                        </value>
                                        <value name="VALUE2">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT">元</field>
                                          </shadow>
                                        </value>
                                      </block>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </statement>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

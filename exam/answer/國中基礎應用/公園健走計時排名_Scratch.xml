<xml xmlns="https://developers.google.com/blockly/xml" platform="scratch">
  <variables>
    <variable type="other" id="v1">N</variable>
    <variable type="Array" id="l2">時間</variable>
    <variable type="other" id="v3">數</variable>
    <variable type="other" id="v4">位置</variable>
  </variables>
  <block x="20" y="0" type="javascript_start_scratch">
    <next>
      <block type="javascript_data_input_scratch">
        <value name="TEXT">
          <shadow type="text_noquotes">
            <field name="TEXT"/>
          </shadow>
        </value>
        <next>
          <block type="variables_set_other">
            <field name="VAR" id="v1" variabletype="other">N</field>
            <value name="VALUE">
              <shadow type="text_noquotes">
                <field name="TEXT">0</field>
              </shadow>
              <block type="javascript_data_input_get_scratch"/>
            </value>
            <next>
              <block type="list_deletealloflist_scratch">
                <field name="VAR" id="l2" variabletype="Array">時間</field>
                <next>
                  <block type="controls_repeat_ext_scratch">
                    <value name="TIMES">
                      <shadow type="math_number">
                        <field name="NUM">10</field>
                      </shadow>
                      <block type="variables_get_other">
                        <field name="VAR" id="v1" variabletype="other">N</field>
                      </block>
                    </value>
                    <statement name="DO">
                      <block type="javascript_data_input_scratch">
                        <value name="TEXT">
                          <shadow type="text_noquotes">
                            <field name="TEXT"/>
                          </shadow>
                        </value>
                        <next>
                          <block type="variables_set_other">
                            <field name="VAR" id="v3" variabletype="other">數</field>
                            <value name="VALUE">
                              <shadow type="text_noquotes">
                                <field name="TEXT">0</field>
                              </shadow>
                              <block type="javascript_data_input_get_scratch"/>
                            </value>
                            <next>
                              <block type="variables_set_other">
                                <field name="VAR" id="v4" variabletype="other">位置</field>
                                <value name="VALUE">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">1</field>
                                  </shadow>
                                </value>
                                <next>
                                  <block type="controls_whileUntil_scratch">
                                    <field name="MODE">UNTIL</field>
                                    <value name="BOOL">
                                      <block type="logic_operation">
                                        <field name="OP">OR</field>
                                        <value name="A">
                                          <block type="logic_compare">
                                            <value name="A">
                                              <shadow type="text_noquotes">
                                                <field name="TEXT">0</field>
                                              </shadow>
                                              <block type="variables_get_other">
                                                <field name="VAR" id="v4" variabletype="other">位置</field>
                                              </block>
                                            </value>
                                            <field name="OP">GT</field>
                                            <value name="B">
                                              <shadow type="text_noquotes">
                                                <field name="TEXT">0</field>
                                              </shadow>
                                              <block type="list_lengthoflist_scratch">
                                                <field name="VAR" id="l2" variabletype="Array">時間</field>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="logic_compare">
                                            <value name="A">
                                              <shadow type="text_noquotes">
                                                <field name="TEXT">0</field>
                                              </shadow>
                                              <block type="list_itemoflist_scratch">
                                                <field name="VAR" id="l2" variabletype="Array">時間</field>
                                                <value name="INDEX">
                                                  <shadow type="math_number">
                                                    <field name="NUM">1</field>
                                                  </shadow>
                                                  <block type="variables_get_other">
                                                    <field name="VAR" id="v4" variabletype="other">位置</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <field name="OP">GT</field>
                                            <value name="B">
                                              <shadow type="text_noquotes">
                                                <field name="TEXT">0</field>
                                              </shadow>
                                              <block type="variables_get_other">
                                                <field name="VAR" id="v3" variabletype="other">數</field>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <statement name="DO">
                                      <block type="math_change_other">
                                        <field name="VAR" id="v4" variabletype="other">位置</field>
                                        <value name="DELTA">
                                          <shadow type="math_number">
                                            <field name="NUM">1</field>
                                          </shadow>
                                        </value>
                                      </block>
                                    </statement>
                                    <next>
                                      <block type="list_insertatlist_scratch">
                                        <value name="ITEM">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT">thing</field>
                                          </shadow>
                                          <block type="variables_get_other">
                                            <field name="VAR" id="v3" variabletype="other">數</field>
                                          </block>
                                        </value>
                                        <field name="VAR" id="l2" variabletype="Array">時間</field>
                                        <value name="INDEX">
                                          <shadow type="math_number">
                                            <field name="NUM">1</field>
                                          </shadow>
                                          <block type="variables_get_other">
                                            <field name="VAR" id="v4" variabletype="other">位置</field>
                                          </block>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <block type="javascript_data_output_scratch">
                        <value name="TEXT">
                          <shadow type="text_noquotes">
                            <field name="TEXT"/>
                          </shadow>
                          <block type="list_itemoflist_scratch">
                            <field name="VAR" id="l2" variabletype="Array">時間</field>
                            <value name="INDEX">
                              <shadow type="math_number">
                                <field name="NUM">1</field>
                              </shadow>
                            </value>
                          </block>
                        </value>
                        <next>
                          <block type="javascript_data_output_scratch">
                            <value name="TEXT">
                              <shadow type="text_noquotes">
                                <field name="TEXT"/>
                              </shadow>
                              <block type="list_itemoflist_scratch">
                                <field name="VAR" id="l2" variabletype="Array">時間</field>
                                <value name="INDEX">
                                  <shadow type="math_number">
                                    <field name="NUM">2</field>
                                  </shadow>
                                </value>
                              </block>
                            </value>
                            <next>
                              <block type="javascript_data_output_scratch">
                                <value name="TEXT">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT"/>
                                  </shadow>
                                  <block type="list_itemoflist_scratch">
                                    <field name="VAR" id="l2" variabletype="Array">時間</field>
                                    <value name="INDEX">
                                      <shadow type="math_number">
                                        <field name="NUM">3</field>
                                      </shadow>
                                    </value>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

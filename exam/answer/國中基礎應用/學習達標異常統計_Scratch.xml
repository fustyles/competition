<xml xmlns="https://developers.google.com/blockly/xml" platform="scratch">
  <variables>
    <variable type="other" id="v1">每天都超過</variable>
    <variable type="other" id="v2">總數</variable>
  </variables>
  <block x="20" y="0" type="javascript_start_scratch">
    <next>
      <block type="variables_set_other">
        <field name="VAR" id="v1" variabletype="other">每天都超過</field>
        <value name="VALUE">
          <shadow type="text_noquotes">
            <field name="TEXT">是</field>
          </shadow>
        </value>
        <next>
          <block type="variables_set_other">
            <field name="VAR" id="v2" variabletype="other">總數</field>
            <value name="VALUE">
              <shadow type="text_noquotes">
                <field name="TEXT">0</field>
              </shadow>
            </value>
            <next>
              <block type="controls_repeat_ext_scratch">
                <value name="TIMES">
                  <shadow type="math_number">
                    <field name="NUM">5</field>
                  </shadow>
                </value>
                <statement name="DO">
                  <block type="javascript_data_input_scratch">
                    <value name="TEXT">
                      <shadow type="text_noquotes">
                        <field name="TEXT"/>
                      </shadow>
                    </value>
                    <next>
                      <block type="math_change_other">
                        <field name="VAR" id="v2" variabletype="other">總數</field>
                        <value name="DELTA">
                          <shadow type="math_number">
                            <field name="NUM">1</field>
                          </shadow>
                          <block type="javascript_data_input_get_scratch"/>
                        </value>
                        <next>
                          <block type="controls_if_1_scratch">
                            <value name="condition">
                              <block type="logic_compare">
                                <value name="A">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">0</field>
                                  </shadow>
                                  <block type="javascript_data_input_get_scratch"/>
                                </value>
                                <field name="OP">LTE</field>
                                <value name="B">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">50</field>
                                  </shadow>
                                </value>
                              </block>
                            </value>
                            <statement name="statement_if">
                              <block type="variables_set_other">
                                <field name="VAR" id="v1" variabletype="other">每天都超過</field>
                                <value name="VALUE">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">否</field>
                                  </shadow>
                                </value>
                              </block>
                            </statement>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </statement>
                <next>
                  <block type="controls_if_2_scratch">
                    <value name="condition">
                      <block type="logic_operation">
                        <field name="OP">OR</field>
                        <value name="A">
                          <block type="logic_compare">
                            <value name="A">
                              <shadow type="text_noquotes">
                                <field name="TEXT">0</field>
                              </shadow>
                              <block type="variables_get_other">
                                <field name="VAR" id="v1" variabletype="other">每天都超過</field>
                              </block>
                            </value>
                            <field name="OP">EQ</field>
                            <value name="B">
                              <shadow type="text_noquotes">
                                <field name="TEXT">是</field>
                              </shadow>
                            </value>
                          </block>
                        </value>
                        <value name="B">
                          <block type="logic_compare">
                            <value name="A">
                              <shadow type="text_noquotes">
                                <field name="TEXT">0</field>
                              </shadow>
                              <block type="variables_get_other">
                                <field name="VAR" id="v2" variabletype="other">總數</field>
                              </block>
                            </value>
                            <field name="OP">GT</field>
                            <value name="B">
                              <shadow type="text_noquotes">
                                <field name="TEXT">300</field>
                              </shadow>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="statement_if">
                      <block type="javascript_data_output_scratch">
                        <value name="TEXT">
                          <shadow type="text_noquotes">
                            <field name="TEXT">YES</field>
                          </shadow>
                        </value>
                      </block>
                    </statement>
                    <statement name="statement_else">
                      <block type="javascript_data_output_scratch">
                        <value name="TEXT">
                          <shadow type="text_noquotes">
                            <field name="TEXT">NO</field>
                          </shadow>
                        </value>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

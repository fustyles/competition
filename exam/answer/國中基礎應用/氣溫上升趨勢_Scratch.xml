<xml xmlns="https://developers.google.com/blockly/xml" platform="scratch">
  <variables>
    <variable type="other" id="v1">前一天</variable>
    <variable type="other" id="v2">持續</variable>
    <variable type="other" id="v3">今天</variable>
  </variables>
  <block x="20" y="0" type="javascript_start_scratch">
    <next>
      <block type="javascript_data_input_scratch">
        <value name="TEXT">
          <shadow type="text_noquotes">
            <field name="TEXT"/>
          </shadow>
        </value>
        <next>
          <block type="variables_set_other">
            <field name="VAR" id="v1" variabletype="other">前一天</field>
            <value name="VALUE">
              <shadow type="text_noquotes">
                <field name="TEXT">0</field>
              </shadow>
              <block type="javascript_data_input_get_scratch"/>
            </value>
            <next>
              <block type="variables_set_other">
                <field name="VAR" id="v2" variabletype="other">持續</field>
                <value name="VALUE">
                  <shadow type="text_noquotes">
                    <field name="TEXT">是</field>
                  </shadow>
                </value>
                <next>
                  <block type="controls_repeat_ext_scratch">
                    <value name="TIMES">
                      <shadow type="math_number">
                        <field name="NUM">4</field>
                      </shadow>
                    </value>
                    <statement name="DO">
                      <block type="javascript_data_input_scratch">
                        <value name="TEXT">
                          <shadow type="text_noquotes">
                            <field name="TEXT"/>
                          </shadow>
                        </value>
                        <next>
                          <block type="variables_set_other">
                            <field name="VAR" id="v3" variabletype="other">今天</field>
                            <value name="VALUE">
                              <shadow type="text_noquotes">
                                <field name="TEXT">0</field>
                              </shadow>
                              <block type="javascript_data_input_get_scratch"/>
                            </value>
                            <next>
                              <block type="controls_if_1_scratch">
                                <value name="condition">
                                  <block type="logic_compare">
                                    <value name="A">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">0</field>
                                      </shadow>
                                      <block type="variables_get_other">
                                        <field name="VAR" id="v3" variabletype="other">今天</field>
                                      </block>
                                    </value>
                                    <field name="OP">LTE</field>
                                    <value name="B">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">0</field>
                                      </shadow>
                                      <block type="variables_get_other">
                                        <field name="VAR" id="v1" variabletype="other">前一天</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="statement_if">
                                  <block type="variables_set_other">
                                    <field name="VAR" id="v2" variabletype="other">持續</field>
                                    <value name="VALUE">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">否</field>
                                      </shadow>
                                    </value>
                                  </block>
                                </statement>
                                <next>
                                  <block type="variables_set_other">
                                    <field name="VAR" id="v1" variabletype="other">前一天</field>
                                    <value name="VALUE">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">0</field>
                                      </shadow>
                                      <block type="variables_get_other">
                                        <field name="VAR" id="v3" variabletype="other">今天</field>
                                      </block>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <block type="controls_if_2_scratch">
                        <value name="condition">
                          <block type="logic_compare">
                            <value name="A">
                              <shadow type="text_noquotes">
                                <field name="TEXT">0</field>
                              </shadow>
                              <block type="variables_get_other">
                                <field name="VAR" id="v2" variabletype="other">持續</field>
                              </block>
                            </value>
                            <field name="OP">EQ</field>
                            <value name="B">
                              <shadow type="text_noquotes">
                                <field name="TEXT">是</field>
                              </shadow>
                            </value>
                          </block>
                        </value>
                        <statement name="statement_if">
                          <block type="javascript_data_output_scratch">
                            <value name="TEXT">
                              <shadow type="text_noquotes">
                                <field name="TEXT">持續升溫</field>
                              </shadow>
                            </value>
                          </block>
                        </statement>
                        <statement name="statement_else">
                          <block type="javascript_data_output_scratch">
                            <value name="TEXT">
                              <shadow type="text_noquotes">
                                <field name="TEXT">無明顯趨勢</field>
                              </shadow>
                            </value>
                          </block>
                        </statement>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

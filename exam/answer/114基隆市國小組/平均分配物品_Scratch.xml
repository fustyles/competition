<xml xmlns="https://developers.google.com/blockly/xml" platform="scratch">
  <variables>
    <variable type="other" id="v01">N</variable>
    <variable type="other" id="v02">公因數</variable>
    <variable type="other" id="v03">數量</variable>
    <variable type="other" id="v04">甲</variable>
    <variable type="other" id="v05">乙</variable>
    <variable type="other" id="v06">餘數</variable>
  </variables>
  <block type="javascript_start_scratch" x="20" y="20">
    <next>
      <block type="javascript_data_input_scratch">
        <value name="TEXT">
          <shadow type="text_noquotes">
            <field name="TEXT"/>
          </shadow>
        </value>
        <next>
          <block type="variables_set_other">
            <field name="VAR" id="v01" variabletype="other">N</field>
            <value name="VALUE">
              <shadow type="text_noquotes">
                <field name="TEXT">0</field>
              </shadow>
              <block type="javascript_data_input_get_scratch"/>
            </value>
            <next>
              <block type="javascript_data_input_scratch">
                <value name="TEXT">
                  <shadow type="text_noquotes">
                    <field name="TEXT"/>
                  </shadow>
                </value>
                <next>
                  <block type="variables_set_other">
                    <field name="VAR" id="v02" variabletype="other">公因數</field>
                    <value name="VALUE">
                      <shadow type="text_noquotes">
                        <field name="TEXT">0</field>
                      </shadow>
                      <block type="javascript_data_input_get_scratch"/>
                    </value>
                    <next>
                      <block type="controls_repeat_ext_scratch">
                        <value name="TIMES">
                          <shadow type="math_number">
                            <field name="NUM">10</field>
                          </shadow>
                          <block type="math_arithmetic">
                            <field name="OP">MINUS</field>
                            <value name="A">
                              <shadow type="math_number">
                                <field name="NUM">0</field>
                              </shadow>
                              <block type="variables_get_other">
                                <field name="VAR" id="v01" variabletype="other">N</field>
                              </block>
                            </value>
                            <value name="B">
                              <shadow type="math_number">
                                <field name="NUM">1</field>
                              </shadow>
                            </value>
                          </block>
                        </value>
                        <statement name="DO">
                          <block type="javascript_data_input_scratch">
                            <value name="TEXT">
                              <shadow type="text_noquotes">
                                <field name="TEXT"/>
                              </shadow>
                            </value>
                            <next>
                              <block type="variables_set_other">
                                <field name="VAR" id="v03" variabletype="other">數量</field>
                                <value name="VALUE">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">0</field>
                                  </shadow>
                                  <block type="javascript_data_input_get_scratch"/>
                                </value>
                                <next>
                                  <block type="variables_set_other">
                                    <field name="VAR" id="v04" variabletype="other">甲</field>
                                    <value name="VALUE">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">0</field>
                                      </shadow>
                                      <block type="variables_get_other">
                                        <field name="VAR" id="v02" variabletype="other">公因數</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="variables_set_other">
                                        <field name="VAR" id="v05" variabletype="other">乙</field>
                                        <value name="VALUE">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT">0</field>
                                          </shadow>
                                          <block type="variables_get_other">
                                            <field name="VAR" id="v03" variabletype="other">數量</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="controls_whileUntil_scratch">
                                            <field name="MODE">UNTIL</field>
                                            <value name="BOOL">
                                              <block type="logic_compare">
                                                <field name="OP">EQ</field>
                                                <value name="A">
                                                  <shadow type="text_noquotes">
                                                    <field name="TEXT">0</field>
                                                  </shadow>
                                                  <block type="variables_get_other">
                                                    <field name="VAR" id="v05" variabletype="other">乙</field>
                                                  </block>
                                                </value>
                                                <value name="B">
                                                  <shadow type="text_noquotes">
                                                    <field name="TEXT">0</field>
                                                  </shadow>
                                                </value>
                                              </block>
                                            </value>
                                            <statement name="DO">
                                              <block type="variables_set_other">
                                                <field name="VAR" id="v06" variabletype="other">餘數</field>
                                                <value name="VALUE">
                                                  <shadow type="text_noquotes">
                                                    <field name="TEXT">0</field>
                                                  </shadow>
                                                  <block type="math_modulo">
                                                    <value name="DIVIDEND">
                                                      <shadow type="math_number">
                                                        <field name="NUM">64</field>
                                                      </shadow>
                                                      <block type="variables_get_other">
                                                        <field name="VAR" id="v04" variabletype="other">甲</field>
                                                      </block>
                                                    </value>
                                                    <value name="DIVISOR">
                                                      <shadow type="math_number">
                                                        <field name="NUM">10</field>
                                                      </shadow>
                                                      <block type="variables_get_other">
                                                        <field name="VAR" id="v05" variabletype="other">乙</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                                <next>
                                                  <block type="variables_set_other">
                                                    <field name="VAR" id="v04" variabletype="other">甲</field>
                                                    <value name="VALUE">
                                                      <shadow type="text_noquotes">
                                                        <field name="TEXT">0</field>
                                                      </shadow>
                                                      <block type="variables_get_other">
                                                        <field name="VAR" id="v05" variabletype="other">乙</field>
                                                      </block>
                                                    </value>
                                                    <next>
                                                      <block type="variables_set_other">
                                                        <field name="VAR" id="v05" variabletype="other">乙</field>
                                                        <value name="VALUE">
                                                          <shadow type="text_noquotes">
                                                            <field name="TEXT">0</field>
                                                          </shadow>
                                                          <block type="variables_get_other">
                                                            <field name="VAR" id="v06" variabletype="other">餘數</field>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </next>
                                              </block>
                                            </statement>
                                            <next>
                                              <block type="variables_set_other">
                                                <field name="VAR" id="v02" variabletype="other">公因數</field>
                                                <value name="VALUE">
                                                  <shadow type="text_noquotes">
                                                    <field name="TEXT">0</field>
                                                  </shadow>
                                                  <block type="variables_get_other">
                                                    <field name="VAR" id="v04" variabletype="other">甲</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </statement>
                        <next>
                          <block type="javascript_data_output_scratch">
                            <value name="TEXT">
                              <shadow type="text_noquotes">
                                <field name="TEXT"/>
                              </shadow>
                              <block type="variables_get_other">
                                <field name="VAR" id="v02" variabletype="other">公因數</field>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

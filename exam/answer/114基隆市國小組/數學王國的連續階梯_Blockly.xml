<xml xmlns="https://developers.google.com/blockly/xml" platform="blockly">
  <variables>
    <variable id="v01">N</variable>
    <variable id="v02">組數</variable>
    <variable id="v03">a</variable>
    <variable id="v04">總和</variable>
    <variable id="v05">b</variable>
    <variable id="v06">字串</variable>
    <variable id="v07">k</variable>
  </variables>
  <block x="20" y="20" type="javascript_data_input_scratch">
    <value name="TEXT">
      <shadow type="text_noquotes">
        <field name="TEXT"/>
      </shadow>
    </value>
    <next>
      <block type="variables_set_local">
        <field name="VAR" id="v01">N</field>
        <value name="VALUE">
          <block type="javascript_data_input_get_scratch"/>
        </value>
        <next>
          <block type="variables_set_local">
            <field name="VAR" id="v02">組數</field>
            <value name="VALUE">
              <block type="math_number">
                <field name="NUM">0</field>
              </block>
            </value>
            <next>
              <block type="controls_for">
                <field name="VAR" id="v03">a</field>
                <value name="FROM">
                  <block type="math_number">
                    <field name="NUM">1</field>
                  </block>
                </value>
                <value name="TO">
                  <block type="math_round">
                    <field name="OP">ROUNDDOWN</field>
                    <value name="NUM">
                      <block type="math_arithmetic">
                        <field name="OP">DIVIDE</field>
                        <value name="A">
                          <block type="variables_get">
                            <field name="VAR" id="v01">N</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number">
                            <field name="NUM">2</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
                <value name="BY">
                  <block type="math_number">
                    <field name="NUM">1</field>
                  </block>
                </value>
                <statement name="DO">
                  <block type="variables_set_local">
                    <field name="VAR" id="v04">總和</field>
                    <value name="VALUE">
                      <block type="variables_get">
                        <field name="VAR" id="v03">a</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set_local">
                        <field name="VAR" id="v05">b</field>
                        <value name="VALUE">
                          <block type="variables_get">
                            <field name="VAR" id="v03">a</field>
                          </block>
                        </value>
                        <next>
                          <block type="controls_whileUntil">
                            <field name="MODE">WHILE</field>
                            <value name="BOOL">
                              <block type="logic_compare">
                                <field name="OP">LT</field>
                                <value name="A">
                                  <block type="variables_get">
                                    <field name="VAR" id="v04">總和</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="variables_get">
                                    <field name="VAR" id="v01">N</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO">
                              <block type="variables_set_local">
                                <field name="VAR" id="v05">b</field>
                                <value name="VALUE">
                                  <block type="math_arithmetic">
                                    <field name="OP">ADD</field>
                                    <value name="A">
                                      <block type="variables_get">
                                        <field name="VAR" id="v05">b</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="math_number">
                                        <field name="NUM">1</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <next>
                                  <block type="variables_set_local">
                                    <field name="VAR" id="v04">總和</field>
                                    <value name="VALUE">
                                      <block type="math_arithmetic">
                                        <field name="OP">ADD</field>
                                        <value name="A">
                                          <block type="variables_get">
                                            <field name="VAR" id="v04">總和</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="variables_get">
                                            <field name="VAR" id="v05">b</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </statement>
                            <next>
                              <block type="controls_if">
                                <value name="IF0">
                                  <block type="logic_operation">
                                    <field name="OP">AND</field>
                                    <value name="A">
                                      <block type="logic_compare">
                                        <field name="OP">EQ</field>
                                        <value name="A">
                                          <block type="variables_get">
                                            <field name="VAR" id="v04">總和</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="variables_get">
                                            <field name="VAR" id="v01">N</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="logic_compare">
                                        <field name="OP">GT</field>
                                        <value name="A">
                                          <block type="variables_get">
                                            <field name="VAR" id="v05">b</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="variables_get">
                                            <field name="VAR" id="v03">a</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="DO0">
                                  <block type="variables_set_local">
                                    <field name="VAR" id="v06">字串</field>
                                    <value name="VALUE">
                                      <block type="variables_get">
                                        <field name="VAR" id="v03">a</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="controls_for">
                                        <field name="VAR" id="v07">k</field>
                                        <value name="FROM">
                                          <block type="math_arithmetic">
                                            <field name="OP">ADD</field>
                                            <value name="A">
                                              <block type="variables_get">
                                                <field name="VAR" id="v03">a</field>
                                              </block>
                                            </value>
                                            <value name="B">
                                              <block type="math_number">
                                                <field name="NUM">1</field>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                        <value name="TO">
                                          <block type="variables_get">
                                            <field name="VAR" id="v05">b</field>
                                          </block>
                                        </value>
                                        <value name="BY">
                                          <block type="math_number">
                                            <field name="NUM">1</field>
                                          </block>
                                        </value>
                                        <statement name="DO">
                                          <block type="variables_set_local">
                                            <field name="VAR" id="v06">字串</field>
                                            <value name="VALUE">
                                              <block type="text_join">
                                                <mutation items="3"/>
                                                <value name="ADD0">
                                                  <block type="variables_get">
                                                    <field name="VAR" id="v06">字串</field>
                                                  </block>
                                                </value>
                                                <value name="ADD1">
                                                  <block type="text">
                                                    <field name="TEXT"> + </field>
                                                  </block>
                                                </value>
                                                <value name="ADD2">
                                                  <block type="variables_get">
                                                    <field name="VAR" id="v07">k</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                          </block>
                                        </statement>
                                        <next>
                                          <block type="javascript_data_output">
                                            <value name="TEXT">
                                              <shadow type="text"><field name="TEXT"/></shadow>
                                              <block type="text_join">
                                                <mutation items="3"/>
                                                <value name="ADD0">
                                                  <block type="variables_get">
                                                    <field name="VAR" id="v06">字串</field>
                                                  </block>
                                                </value>
                                                <value name="ADD1">
                                                  <block type="text">
                                                    <field name="TEXT"> = </field>
                                                  </block>
                                                </value>
                                                <value name="ADD2">
                                                  <block type="variables_get">
                                                    <field name="VAR" id="v01">N</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <next>
                                              <block type="variables_set_local">
                                                <field name="VAR" id="v02">組數</field>
                                                <value name="VALUE">
                                                  <block type="math_arithmetic">
                                                    <field name="OP">ADD</field>
                                                    <value name="A">
                                                      <block type="variables_get">
                                                        <field name="VAR" id="v02">組數</field>
                                                      </block>
                                                    </value>
                                                    <value name="B">
                                                      <block type="math_number">
                                                        <field name="NUM">1</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </statement>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </statement>
                <next>
                  <block type="controls_if">
                    <value name="IF0">
                      <block type="logic_compare">
                        <field name="OP">EQ</field>
                        <value name="A">
                          <block type="variables_get">
                            <field name="VAR" id="v02">組數</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number">
                            <field name="NUM">0</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="javascript_data_output">
                        <value name="TEXT">
                          <shadow type="text"><field name="TEXT"/></shadow>
                          <block type="text">
                            <field name="TEXT">No</field>
                          </block>
                        </value>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

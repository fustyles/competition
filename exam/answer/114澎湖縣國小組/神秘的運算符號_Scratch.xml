<xml xmlns="https://developers.google.com/blockly/xml" platform="scratch">
  <variables>
    <variable type="other" id="v01">A</variable>
    <variable type="other" id="v02">B</variable>
    <variable type="other" id="v03">大</variable>
    <variable type="other" id="v04">小</variable>
    <variable type="other" id="v05">商</variable>
    <variable type="other" id="v06">餘數</variable>
    <variable type="other" id="v07">結果</variable>
  </variables>
  <block type="javascript_start_scratch" x="20" y="20">
    <next>
      <block type="javascript_data_input_scratch">
        <value name="TEXT">
          <shadow type="text_noquotes">
            <field name="TEXT"/>
          </shadow>
        </value>
        <next>
          <block type="variables_set_other">
            <field name="VAR" id="v01" variabletype="other">A</field>
            <value name="VALUE">
              <shadow type="text_noquotes">
                <field name="TEXT">0</field>
              </shadow>
              <block type="javascript_data_input_get_scratch"/>
            </value>
            <next>
              <block type="javascript_data_input_scratch">
                <value name="TEXT">
                  <shadow type="text_noquotes">
                    <field name="TEXT"/>
                  </shadow>
                </value>
                <next>
                  <block type="variables_set_other">
                    <field name="VAR" id="v02" variabletype="other">B</field>
                    <value name="VALUE">
                      <shadow type="text_noquotes">
                        <field name="TEXT">0</field>
                      </shadow>
                      <block type="javascript_data_input_get_scratch"/>
                    </value>
                    <next>
                      <block type="controls_if_2_scratch">
                        <value name="condition">
                          <block type="logic_compare">
                            <field name="OP">GT</field>
                            <value name="A">
                              <shadow type="text_noquotes">
                                <field name="TEXT">0</field>
                              </shadow>
                              <block type="variables_get_other">
                                <field name="VAR" id="v01" variabletype="other">A</field>
                              </block>
                            </value>
                            <value name="B">
                              <shadow type="text_noquotes">
                                <field name="TEXT">0</field>
                              </shadow>
                              <block type="variables_get_other">
                                <field name="VAR" id="v02" variabletype="other">B</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <statement name="statement_if">
                          <block type="variables_set_other">
                            <field name="VAR" id="v03" variabletype="other">大</field>
                            <value name="VALUE">
                              <shadow type="text_noquotes">
                                <field name="TEXT">0</field>
                              </shadow>
                              <block type="variables_get_other">
                                <field name="VAR" id="v01" variabletype="other">A</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set_other">
                                <field name="VAR" id="v04" variabletype="other">小</field>
                                <value name="VALUE">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">0</field>
                                  </shadow>
                                  <block type="variables_get_other">
                                    <field name="VAR" id="v02" variabletype="other">B</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </statement>
                        <statement name="statement_else">
                          <block type="variables_set_other">
                            <field name="VAR" id="v03" variabletype="other">大</field>
                            <value name="VALUE">
                              <shadow type="text_noquotes">
                                <field name="TEXT">0</field>
                              </shadow>
                              <block type="variables_get_other">
                                <field name="VAR" id="v02" variabletype="other">B</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set_other">
                                <field name="VAR" id="v04" variabletype="other">小</field>
                                <value name="VALUE">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">0</field>
                                  </shadow>
                                  <block type="variables_get_other">
                                    <field name="VAR" id="v01" variabletype="other">A</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </statement>
                        <next>
                          <block type="variables_set_other">
                            <field name="VAR" id="v05" variabletype="other">商</field>
                            <value name="VALUE">
                              <shadow type="text_noquotes">
                                <field name="TEXT">0</field>
                              </shadow>
                              <block type="math_round">
                                <field name="OP">ROUNDDOWN</field>
                                <value name="NUM">
                                  <shadow type="math_number">
                                    <field name="NUM">3.1</field>
                                  </shadow>
                                  <block type="math_arithmetic">
                                    <field name="OP">DIVIDE</field>
                                    <value name="A">
                                      <shadow type="math_number">
                                        <field name="NUM">0</field>
                                      </shadow>
                                      <block type="variables_get_other">
                                        <field name="VAR" id="v03" variabletype="other">大</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <shadow type="math_number">
                                        <field name="NUM">0</field>
                                      </shadow>
                                      <block type="variables_get_other">
                                        <field name="VAR" id="v04" variabletype="other">小</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set_other">
                                <field name="VAR" id="v06" variabletype="other">餘數</field>
                                <value name="VALUE">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">0</field>
                                  </shadow>
                                  <block type="math_modulo">
                                    <value name="DIVIDEND">
                                      <shadow type="math_number">
                                        <field name="NUM">64</field>
                                      </shadow>
                                      <block type="variables_get_other">
                                        <field name="VAR" id="v03" variabletype="other">大</field>
                                      </block>
                                    </value>
                                    <value name="DIVISOR">
                                      <shadow type="math_number">
                                        <field name="NUM">10</field>
                                      </shadow>
                                      <block type="variables_get_other">
                                        <field name="VAR" id="v04" variabletype="other">小</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <next>
                                  <block type="variables_set_other">
                                    <field name="VAR" id="v07" variabletype="other">結果</field>
                                    <value name="VALUE">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">0</field>
                                      </shadow>
                                      <block type="text_join_scratch">
                                        <value name="VALUE1">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT"/>
                                          </shadow>
                                          <block type="variables_get_other">
                                            <field name="VAR" id="v05" variabletype="other">商</field>
                                          </block>
                                        </value>
                                        <value name="VALUE2">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT"/>
                                          </shadow>
                                        </value>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="javascript_data_output_scratch">
                                        <value name="TEXT">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT"/>
                                          </shadow>
                                          <block type="text_join_scratch">
                                            <value name="VALUE1">
                                              <shadow type="text_noquotes">
                                                <field name="TEXT"/>
                                              </shadow>
                                              <block type="variables_get_other">
                                                <field name="VAR" id="v07" variabletype="other">結果</field>
                                              </block>
                                            </value>
                                            <value name="VALUE2">
                                              <shadow type="text_noquotes">
                                                <field name="TEXT"/>
                                              </shadow>
                                              <block type="variables_get_other">
                                                <field name="VAR" id="v06" variabletype="other">餘數</field>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

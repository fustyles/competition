<xml xmlns="https://developers.google.com/blockly/xml" platform="scratch">
  <variables>
    <variable type="other" id="v01">L</variable>
    <variable type="other" id="v02">字母表</variable>
    <variable type="other" id="v03">數值</variable>
    <variable type="other" id="v04">字母</variable>
    <variable type="other" id="v05">位數</variable>
    <variable type="other" id="v06">p</variable>
  </variables>
  <block type="javascript_start_scratch" x="20" y="20">
    <next>
      <block type="javascript_data_input_scratch">
        <value name="TEXT">
          <shadow type="text_noquotes">
            <field name="TEXT"/>
          </shadow>
        </value>
        <next>
          <block type="variables_set_other">
            <field name="VAR" id="v01" variabletype="other">L</field>
            <value name="VALUE">
              <shadow type="text_noquotes">
                <field name="TEXT">0</field>
              </shadow>
              <block type="javascript_data_input_get_scratch"/>
            </value>
            <next>
              <block type="variables_set_other">
                <field name="VAR" id="v02" variabletype="other">字母表</field>
                <value name="VALUE">
                  <shadow type="text_noquotes">
                    <field name="TEXT">ABCDE</field>
                  </shadow>
                </value>
                <next>
                  <block type="variables_set_other">
                    <field name="VAR" id="v03" variabletype="other">數值</field>
                    <value name="VALUE">
                      <shadow type="text_noquotes">
                        <field name="TEXT">0</field>
                      </shadow>
                    </value>
                    <next>
                      <block type="controls_repeat_ext_scratch">
                        <value name="TIMES">
                          <shadow type="math_number">
                            <field name="NUM">10</field>
                          </shadow>
                          <block type="variables_get_other">
                            <field name="VAR" id="v01" variabletype="other">L</field>
                          </block>
                        </value>
                        <statement name="DO">
                          <block type="javascript_data_input_scratch">
                            <value name="TEXT">
                              <shadow type="text_noquotes">
                                <field name="TEXT"/>
                              </shadow>
                            </value>
                            <next>
                              <block type="variables_set_other">
                                <field name="VAR" id="v04" variabletype="other">字母</field>
                                <value name="VALUE">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">0</field>
                                  </shadow>
                                  <block type="javascript_data_input_get_scratch"/>
                                </value>
                                <next>
                                  <block type="variables_set_other">
                                    <field name="VAR" id="v05" variabletype="other">位數</field>
                                    <value name="VALUE">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">0</field>
                                      </shadow>
                                    </value>
                                    <next>
                                      <block type="variables_set_other">
                                        <field name="VAR" id="v06" variabletype="other">p</field>
                                        <value name="VALUE">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT">1</field>
                                          </shadow>
                                        </value>
                                        <next>
                                          <block type="controls_whileUntil_scratch">
                                            <field name="MODE">UNTIL</field>
                                            <value name="BOOL">
                                              <block type="logic_compare">
                                                <field name="OP">GT</field>
                                                <value name="A">
                                                  <shadow type="text_noquotes">
                                                    <field name="TEXT">0</field>
                                                  </shadow>
                                                  <block type="variables_get_other">
                                                    <field name="VAR" id="v06" variabletype="other">p</field>
                                                  </block>
                                                </value>
                                                <value name="B">
                                                  <shadow type="text_noquotes">
                                                    <field name="TEXT">5</field>
                                                  </shadow>
                                                </value>
                                              </block>
                                            </value>
                                            <statement name="DO">
                                              <block type="controls_if_1_scratch">
                                                <value name="condition">
                                                  <block type="logic_compare">
                                                    <field name="OP">EQ</field>
                                                    <value name="A">
                                                      <shadow type="text_noquotes">
                                                        <field name="TEXT">0</field>
                                                      </shadow>
                                                      <block type="text_charAt_scratch">
                                                        <value name="VALUE">
                                                          <shadow type="text_noquotes">
                                                            <field name="TEXT">abc</field>
                                                          </shadow>
                                                          <block type="variables_get_other">
                                                            <field name="VAR" id="v02" variabletype="other">字母表</field>
                                                          </block>
                                                        </value>
                                                        <value name="WHERE">
                                                          <shadow type="math_number">
                                                            <field name="NUM">1</field>
                                                          </shadow>
                                                          <block type="variables_get_other">
                                                            <field name="VAR" id="v06" variabletype="other">p</field>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </value>
                                                    <value name="B">
                                                      <shadow type="text_noquotes">
                                                        <field name="TEXT">0</field>
                                                      </shadow>
                                                      <block type="variables_get_other">
                                                        <field name="VAR" id="v04" variabletype="other">字母</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                                <statement name="statement_if">
                                                  <block type="variables_set_other">
                                                    <field name="VAR" id="v05" variabletype="other">位數</field>
                                                    <value name="VALUE">
                                                      <shadow type="text_noquotes">
                                                        <field name="TEXT">0</field>
                                                      </shadow>
                                                      <block type="math_arithmetic">
                                                        <field name="OP">MINUS</field>
                                                        <value name="A">
                                                          <shadow type="math_number">
                                                            <field name="NUM">0</field>
                                                          </shadow>
                                                          <block type="variables_get_other">
                                                            <field name="VAR" id="v06" variabletype="other">p</field>
                                                          </block>
                                                        </value>
                                                        <value name="B">
                                                          <shadow type="math_number">
                                                            <field name="NUM">1</field>
                                                          </shadow>
                                                        </value>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </statement>
                                                <next>
                                                  <block type="math_change_other">
                                                    <field name="VAR" id="v06" variabletype="other">p</field>
                                                    <value name="DELTA">
                                                      <shadow type="math_number">
                                                        <field name="NUM">1</field>
                                                      </shadow>
                                                    </value>
                                                  </block>
                                                </next>
                                              </block>
                                            </statement>
                                            <next>
                                              <block type="variables_set_other">
                                                <field name="VAR" id="v03" variabletype="other">數值</field>
                                                <value name="VALUE">
                                                  <shadow type="text_noquotes">
                                                    <field name="TEXT">0</field>
                                                  </shadow>
                                                  <block type="math_arithmetic">
                                                    <field name="OP">ADD</field>
                                                    <value name="A">
                                                      <shadow type="math_number">
                                                        <field name="NUM">0</field>
                                                      </shadow>
                                                      <block type="math_arithmetic">
                                                        <field name="OP">MULTIPLY</field>
                                                        <value name="A">
                                                          <shadow type="math_number">
                                                            <field name="NUM">0</field>
                                                          </shadow>
                                                          <block type="variables_get_other">
                                                            <field name="VAR" id="v03" variabletype="other">數值</field>
                                                          </block>
                                                        </value>
                                                        <value name="B">
                                                          <shadow type="math_number">
                                                            <field name="NUM">5</field>
                                                          </shadow>
                                                        </value>
                                                      </block>
                                                    </value>
                                                    <value name="B">
                                                      <shadow type="math_number">
                                                        <field name="NUM">0</field>
                                                      </shadow>
                                                      <block type="variables_get_other">
                                                        <field name="VAR" id="v05" variabletype="other">位數</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </statement>
                        <next>
                          <block type="javascript_data_output_scratch">
                            <value name="TEXT">
                              <shadow type="text_noquotes">
                                <field name="TEXT"/>
                              </shadow>
                              <block type="variables_get_other">
                                <field name="VAR" id="v03" variabletype="other">數值</field>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

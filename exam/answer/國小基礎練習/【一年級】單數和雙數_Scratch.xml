<xml xmlns="https://developers.google.com/blockly/xml" platform="scratch">
  <variables>
    <variable type="other" id="v1">N</variable>
    <variable type="other" id="v2">單數</variable>
    <variable type="other" id="v3">雙數</variable>
  </variables>
  <block x="20" y="0" type="javascript_start_scratch">
    <next>
      <block type="javascript_data_input_scratch">
        <value name="TEXT">
          <shadow type="text_noquotes">
            <field name="TEXT"/>
          </shadow>
        </value>
        <next>
          <block type="variables_set_other">
            <field name="VAR" id="v1" variabletype="other">N</field>
            <value name="VALUE">
              <shadow type="text_noquotes">
                <field name="TEXT">0</field>
              </shadow>
              <block type="javascript_data_input_get_scratch"/>
            </value>
            <next>
              <block type="variables_set_other">
                <field name="VAR" id="v2" variabletype="other">單數</field>
                <value name="VALUE">
                  <shadow type="text_noquotes">
                    <field name="TEXT">0</field>
                  </shadow>
                </value>
                <next>
                  <block type="variables_set_other">
                    <field name="VAR" id="v3" variabletype="other">雙數</field>
                    <value name="VALUE">
                      <shadow type="text_noquotes">
                        <field name="TEXT">0</field>
                      </shadow>
                    </value>
                    <next>
                      <block type="controls_repeat_ext_scratch">
                        <value name="TIMES">
                          <shadow type="math_number">
                            <field name="NUM">10</field>
                          </shadow>
                          <block type="variables_get_other">
                            <field name="VAR" id="v1" variabletype="other">N</field>
                          </block>
                        </value>
                        <statement name="DO">
                          <block type="javascript_data_input_scratch">
                            <value name="TEXT">
                              <shadow type="text_noquotes">
                                <field name="TEXT"/>
                              </shadow>
                            </value>
                            <next>
                              <block type="controls_if_2_scratch">
                                <value name="condition">
                                  <block type="logic_compare">
                                    <value name="A">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">0</field>
                                      </shadow>
                                      <block type="math_modulo">
                                        <value name="DIVIDEND">
                                          <shadow type="math_number">
                                            <field name="NUM">64</field>
                                          </shadow>
                                          <block type="javascript_data_input_get_scratch"/>
                                        </value>
                                        <value name="DIVISOR">
                                          <shadow type="math_number">
                                            <field name="NUM">2</field>
                                          </shadow>
                                        </value>
                                      </block>
                                    </value>
                                    <field name="OP">EQ</field>
                                    <value name="B">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">0</field>
                                      </shadow>
                                    </value>
                                  </block>
                                </value>
                                <statement name="statement_if">
                                  <block type="math_change_other">
                                    <field name="VAR" id="v3" variabletype="other">雙數</field>
                                    <value name="DELTA">
                                      <shadow type="math_number">
                                        <field name="NUM">1</field>
                                      </shadow>
                                    </value>
                                  </block>
                                </statement>
                                <statement name="statement_else">
                                  <block type="math_change_other">
                                    <field name="VAR" id="v2" variabletype="other">單數</field>
                                    <value name="DELTA">
                                      <shadow type="math_number">
                                        <field name="NUM">1</field>
                                      </shadow>
                                    </value>
                                  </block>
                                </statement>
                              </block>
                            </next>
                          </block>
                        </statement>
                        <next>
                          <block type="javascript_data_output_scratch">
                            <value name="TEXT">
                              <shadow type="text_noquotes">
                                <field name="TEXT"/>
                              </shadow>
                              <block type="variables_get_other">
                                <field name="VAR" id="v2" variabletype="other">單數</field>
                              </block>
                            </value>
                            <next>
                              <block type="javascript_data_output_scratch">
                                <value name="TEXT">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT"/>
                                  </shadow>
                                  <block type="variables_get_other">
                                    <field name="VAR" id="v3" variabletype="other">雙數</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

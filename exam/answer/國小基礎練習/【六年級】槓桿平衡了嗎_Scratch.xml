<xml xmlns="https://developers.google.com/blockly/xml" platform="scratch">
  <variables>
    <variable type="other" id="v1">左重</variable>
    <variable type="other" id="v2">左距</variable>
    <variable type="other" id="v3">右重</variable>
    <variable type="other" id="v4">右距</variable>
    <variable type="other" id="v5">左力矩</variable>
    <variable type="other" id="v6">右力矩</variable>
  </variables>
  <block x="20" y="0" type="javascript_start_scratch">
    <next>
      <block type="javascript_data_input_scratch">
        <value name="TEXT">
          <shadow type="text_noquotes">
            <field name="TEXT"/>
          </shadow>
        </value>
        <next>
          <block type="variables_set_other">
            <field name="VAR" id="v1" variabletype="other">左重</field>
            <value name="VALUE">
              <shadow type="text_noquotes">
                <field name="TEXT">0</field>
              </shadow>
              <block type="javascript_data_input_get_scratch"/>
            </value>
            <next>
              <block type="javascript_data_input_scratch">
                <value name="TEXT">
                  <shadow type="text_noquotes">
                    <field name="TEXT"/>
                  </shadow>
                </value>
                <next>
                  <block type="variables_set_other">
                    <field name="VAR" id="v2" variabletype="other">左距</field>
                    <value name="VALUE">
                      <shadow type="text_noquotes">
                        <field name="TEXT">0</field>
                      </shadow>
                      <block type="javascript_data_input_get_scratch"/>
                    </value>
                    <next>
                      <block type="javascript_data_input_scratch">
                        <value name="TEXT">
                          <shadow type="text_noquotes">
                            <field name="TEXT"/>
                          </shadow>
                        </value>
                        <next>
                          <block type="variables_set_other">
                            <field name="VAR" id="v3" variabletype="other">右重</field>
                            <value name="VALUE">
                              <shadow type="text_noquotes">
                                <field name="TEXT">0</field>
                              </shadow>
                              <block type="javascript_data_input_get_scratch"/>
                            </value>
                            <next>
                              <block type="javascript_data_input_scratch">
                                <value name="TEXT">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT"/>
                                  </shadow>
                                </value>
                                <next>
                                  <block type="variables_set_other">
                                    <field name="VAR" id="v4" variabletype="other">右距</field>
                                    <value name="VALUE">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">0</field>
                                      </shadow>
                                      <block type="javascript_data_input_get_scratch"/>
                                    </value>
                                    <next>
                                      <block type="variables_set_other">
                                        <field name="VAR" id="v5" variabletype="other">左力矩</field>
                                        <value name="VALUE">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT">0</field>
                                          </shadow>
                                          <block type="math_arithmetic">
                                            <field name="OP">MULTIPLY</field>
                                            <value name="A">
                                              <shadow type="math_number">
                                                <field name="NUM">0</field>
                                              </shadow>
                                              <block type="variables_get_other">
                                                <field name="VAR" id="v1" variabletype="other">左重</field>
                                              </block>
                                            </value>
                                            <value name="B">
                                              <shadow type="math_number">
                                                <field name="NUM">0</field>
                                              </shadow>
                                              <block type="variables_get_other">
                                                <field name="VAR" id="v2" variabletype="other">左距</field>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="variables_set_other">
                                            <field name="VAR" id="v6" variabletype="other">右力矩</field>
                                            <value name="VALUE">
                                              <shadow type="text_noquotes">
                                                <field name="TEXT">0</field>
                                              </shadow>
                                              <block type="math_arithmetic">
                                                <field name="OP">MULTIPLY</field>
                                                <value name="A">
                                                  <shadow type="math_number">
                                                    <field name="NUM">0</field>
                                                  </shadow>
                                                  <block type="variables_get_other">
                                                    <field name="VAR" id="v3" variabletype="other">右重</field>
                                                  </block>
                                                </value>
                                                <value name="B">
                                                  <shadow type="math_number">
                                                    <field name="NUM">0</field>
                                                  </shadow>
                                                  <block type="variables_get_other">
                                                    <field name="VAR" id="v4" variabletype="other">右距</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <next>
                                              <block type="controls_if_2_scratch">
                                                <value name="condition">
                                                  <block type="logic_compare">
                                                    <value name="A">
                                                      <shadow type="text_noquotes">
                                                        <field name="TEXT">0</field>
                                                      </shadow>
                                                      <block type="variables_get_other">
                                                        <field name="VAR" id="v5" variabletype="other">左力矩</field>
                                                      </block>
                                                    </value>
                                                    <field name="OP">GT</field>
                                                    <value name="B">
                                                      <shadow type="text_noquotes">
                                                        <field name="TEXT">0</field>
                                                      </shadow>
                                                      <block type="variables_get_other">
                                                        <field name="VAR" id="v6" variabletype="other">右力矩</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                                <statement name="statement_if">
                                                  <block type="javascript_data_output_scratch">
                                                    <value name="TEXT">
                                                      <shadow type="text_noquotes">
                                                        <field name="TEXT">左傾</field>
                                                      </shadow>
                                                    </value>
                                                  </block>
                                                </statement>
                                                <statement name="statement_else">
                                                  <block type="controls_if_2_scratch">
                                                    <value name="condition">
                                                      <block type="logic_compare">
                                                        <value name="A">
                                                          <shadow type="text_noquotes">
                                                            <field name="TEXT">0</field>
                                                          </shadow>
                                                          <block type="variables_get_other">
                                                            <field name="VAR" id="v5" variabletype="other">左力矩</field>
                                                          </block>
                                                        </value>
                                                        <field name="OP">LT</field>
                                                        <value name="B">
                                                          <shadow type="text_noquotes">
                                                            <field name="TEXT">0</field>
                                                          </shadow>
                                                          <block type="variables_get_other">
                                                            <field name="VAR" id="v6" variabletype="other">右力矩</field>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </value>
                                                    <statement name="statement_if">
                                                      <block type="javascript_data_output_scratch">
                                                        <value name="TEXT">
                                                          <shadow type="text_noquotes">
                                                            <field name="TEXT">右傾</field>
                                                          </shadow>
                                                        </value>
                                                      </block>
                                                    </statement>
                                                    <statement name="statement_else">
                                                      <block type="javascript_data_output_scratch">
                                                        <value name="TEXT">
                                                          <shadow type="text_noquotes">
                                                            <field name="TEXT">平衡</field>
                                                          </shadow>
                                                        </value>
                                                      </block>
                                                    </statement>
                                                  </block>
                                                </statement>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

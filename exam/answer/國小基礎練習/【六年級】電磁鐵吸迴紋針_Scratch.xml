<xml xmlns="https://developers.google.com/blockly/xml" platform="scratch">
  <variables>
    <variable type="other" id="v1">N</variable>
    <variable type="other" id="v2">最多</variable>
    <variable type="other" id="v3">組號</variable>
    <variable type="other" id="v4">i</variable>
    <variable type="other" id="v5">圈數</variable>
    <variable type="other" id="v6">電池</variable>
    <variable type="other" id="v7">根數</variable>
  </variables>
  <block x="20" y="0" type="javascript_start_scratch">
    <next>
      <block type="javascript_data_input_scratch">
        <value name="TEXT">
          <shadow type="text_noquotes">
            <field name="TEXT"/>
          </shadow>
        </value>
        <next>
          <block type="variables_set_other">
            <field name="VAR" id="v1" variabletype="other">N</field>
            <value name="VALUE">
              <shadow type="text_noquotes">
                <field name="TEXT">0</field>
              </shadow>
              <block type="javascript_data_input_get_scratch"/>
            </value>
            <next>
              <block type="variables_set_other">
                <field name="VAR" id="v2" variabletype="other">最多</field>
                <value name="VALUE">
                  <shadow type="text_noquotes">
                    <field name="TEXT">-1</field>
                  </shadow>
                </value>
                <next>
                  <block type="variables_set_other">
                    <field name="VAR" id="v3" variabletype="other">組號</field>
                    <value name="VALUE">
                      <shadow type="text_noquotes">
                        <field name="TEXT">0</field>
                      </shadow>
                    </value>
                    <next>
                      <block type="variables_set_other">
                        <field name="VAR" id="v4" variabletype="other">i</field>
                        <value name="VALUE">
                          <shadow type="text_noquotes">
                            <field name="TEXT">1</field>
                          </shadow>
                        </value>
                        <next>
                          <block type="controls_repeat_ext_scratch">
                            <value name="TIMES">
                              <shadow type="math_number">
                                <field name="NUM">10</field>
                              </shadow>
                              <block type="variables_get_other">
                                <field name="VAR" id="v1" variabletype="other">N</field>
                              </block>
                            </value>
                            <statement name="DO">
                              <block type="javascript_data_input_scratch">
                                <value name="TEXT">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT"/>
                                  </shadow>
                                </value>
                                <next>
                                  <block type="variables_set_other">
                                    <field name="VAR" id="v5" variabletype="other">圈數</field>
                                    <value name="VALUE">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">0</field>
                                      </shadow>
                                      <block type="javascript_data_input_get_scratch"/>
                                    </value>
                                    <next>
                                      <block type="javascript_data_input_scratch">
                                        <value name="TEXT">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT"/>
                                          </shadow>
                                        </value>
                                        <next>
                                          <block type="variables_set_other">
                                            <field name="VAR" id="v6" variabletype="other">電池</field>
                                            <value name="VALUE">
                                              <shadow type="text_noquotes">
                                                <field name="TEXT">0</field>
                                              </shadow>
                                              <block type="javascript_data_input_get_scratch"/>
                                            </value>
                                            <next>
                                              <block type="variables_set_other">
                                                <field name="VAR" id="v7" variabletype="other">根數</field>
                                                <value name="VALUE">
                                                  <shadow type="text_noquotes">
                                                    <field name="TEXT">0</field>
                                                  </shadow>
                                                  <block type="math_arithmetic">
                                                    <field name="OP">MULTIPLY</field>
                                                    <value name="A">
                                                      <shadow type="math_number">
                                                        <field name="NUM">0</field>
                                                      </shadow>
                                                      <block type="math_round">
                                                        <field name="OP">ROUNDDOWN</field>
                                                        <value name="NUM">
                                                          <shadow type="math_number">
                                                            <field name="NUM">3.1</field>
                                                          </shadow>
                                                          <block type="math_arithmetic">
                                                            <field name="OP">DIVIDE</field>
                                                            <value name="A">
                                                              <shadow type="math_number">
                                                                <field name="NUM">0</field>
                                                              </shadow>
                                                              <block type="variables_get_other">
                                                                <field name="VAR" id="v5" variabletype="other">圈數</field>
                                                              </block>
                                                            </value>
                                                            <value name="B">
                                                              <shadow type="math_number">
                                                                <field name="NUM">10</field>
                                                              </shadow>
                                                            </value>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </value>
                                                    <value name="B">
                                                      <shadow type="math_number">
                                                        <field name="NUM">0</field>
                                                      </shadow>
                                                      <block type="variables_get_other">
                                                        <field name="VAR" id="v6" variabletype="other">電池</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                                <next>
                                                  <block type="controls_if_1_scratch">
                                                    <value name="condition">
                                                      <block type="logic_compare">
                                                        <value name="A">
                                                          <shadow type="text_noquotes">
                                                            <field name="TEXT">0</field>
                                                          </shadow>
                                                          <block type="variables_get_other">
                                                            <field name="VAR" id="v7" variabletype="other">根數</field>
                                                          </block>
                                                        </value>
                                                        <field name="OP">GT</field>
                                                        <value name="B">
                                                          <shadow type="text_noquotes">
                                                            <field name="TEXT">0</field>
                                                          </shadow>
                                                          <block type="variables_get_other">
                                                            <field name="VAR" id="v2" variabletype="other">最多</field>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </value>
                                                    <statement name="statement_if">
                                                      <block type="variables_set_other">
                                                        <field name="VAR" id="v2" variabletype="other">最多</field>
                                                        <value name="VALUE">
                                                          <shadow type="text_noquotes">
                                                            <field name="TEXT">0</field>
                                                          </shadow>
                                                          <block type="variables_get_other">
                                                            <field name="VAR" id="v7" variabletype="other">根數</field>
                                                          </block>
                                                        </value>
                                                        <next>
                                                          <block type="variables_set_other">
                                                            <field name="VAR" id="v3" variabletype="other">組號</field>
                                                            <value name="VALUE">
                                                              <shadow type="text_noquotes">
                                                                <field name="TEXT">0</field>
                                                              </shadow>
                                                              <block type="variables_get_other">
                                                                <field name="VAR" id="v4" variabletype="other">i</field>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </next>
                                                      </block>
                                                    </statement>
                                                    <next>
                                                      <block type="math_change_other">
                                                        <field name="VAR" id="v4" variabletype="other">i</field>
                                                        <value name="DELTA">
                                                          <shadow type="math_number">
                                                            <field name="NUM">1</field>
                                                          </shadow>
                                                        </value>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </statement>
                            <next>
                              <block type="javascript_data_output_scratch">
                                <value name="TEXT">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT"/>
                                  </shadow>
                                  <block type="variables_get_other">
                                    <field name="VAR" id="v3" variabletype="other">組號</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="javascript_data_output_scratch">
                                    <value name="TEXT">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT"/>
                                      </shadow>
                                      <block type="variables_get_other">
                                        <field name="VAR" id="v2" variabletype="other">最多</field>
                                      </block>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

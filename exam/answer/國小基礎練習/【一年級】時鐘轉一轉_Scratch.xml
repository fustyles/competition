<xml xmlns="https://developers.google.com/blockly/xml" platform="scratch">
  <variables>
    <variable type="other" id="v1">現在</variable>
    <variable type="other" id="v2">小時</variable>
    <variable type="other" id="v3">結果</variable>
  </variables>
  <block x="20" y="0" type="javascript_start_scratch">
    <next>
      <block type="javascript_data_input_scratch">
        <value name="TEXT">
          <shadow type="text_noquotes">
            <field name="TEXT"/>
          </shadow>
        </value>
        <next>
          <block type="variables_set_other">
            <field name="VAR" id="v1" variabletype="other">現在</field>
            <value name="VALUE">
              <shadow type="text_noquotes">
                <field name="TEXT">0</field>
              </shadow>
              <block type="javascript_data_input_get_scratch"/>
            </value>
            <next>
              <block type="javascript_data_input_scratch">
                <value name="TEXT">
                  <shadow type="text_noquotes">
                    <field name="TEXT"/>
                  </shadow>
                </value>
                <next>
                  <block type="variables_set_other">
                    <field name="VAR" id="v2" variabletype="other">小時</field>
                    <value name="VALUE">
                      <shadow type="text_noquotes">
                        <field name="TEXT">0</field>
                      </shadow>
                      <block type="javascript_data_input_get_scratch"/>
                    </value>
                    <next>
                      <block type="variables_set_other">
                        <field name="VAR" id="v3" variabletype="other">結果</field>
                        <value name="VALUE">
                          <shadow type="text_noquotes">
                            <field name="TEXT">0</field>
                          </shadow>
                          <block type="math_modulo">
                            <value name="DIVIDEND">
                              <shadow type="math_number">
                                <field name="NUM">64</field>
                              </shadow>
                              <block type="math_arithmetic">
                                <field name="OP">ADD</field>
                                <value name="A">
                                  <shadow type="math_number">
                                    <field name="NUM">0</field>
                                  </shadow>
                                  <block type="variables_get_other">
                                    <field name="VAR" id="v1" variabletype="other">現在</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <shadow type="math_number">
                                    <field name="NUM">0</field>
                                  </shadow>
                                  <block type="variables_get_other">
                                    <field name="VAR" id="v2" variabletype="other">小時</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <value name="DIVISOR">
                              <shadow type="math_number">
                                <field name="NUM">12</field>
                              </shadow>
                            </value>
                          </block>
                        </value>
                        <next>
                          <block type="controls_if_1_scratch">
                            <value name="condition">
                              <block type="logic_compare">
                                <value name="A">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">0</field>
                                  </shadow>
                                  <block type="variables_get_other">
                                    <field name="VAR" id="v3" variabletype="other">結果</field>
                                  </block>
                                </value>
                                <field name="OP">EQ</field>
                                <value name="B">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">0</field>
                                  </shadow>
                                </value>
                              </block>
                            </value>
                            <statement name="statement_if">
                              <block type="variables_set_other">
                                <field name="VAR" id="v3" variabletype="other">結果</field>
                                <value name="VALUE">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">12</field>
                                  </shadow>
                                </value>
                              </block>
                            </statement>
                            <next>
                              <block type="javascript_data_output_scratch">
                                <value name="TEXT">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT"/>
                                  </shadow>
                                  <block type="variables_get_other">
                                    <field name="VAR" id="v3" variabletype="other">結果</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

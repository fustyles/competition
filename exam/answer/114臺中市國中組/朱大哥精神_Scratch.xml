<xml xmlns="https://developers.google.com/blockly/xml" platform="scratch">
  <variables>
    <variable type="other" id="v01">人數</variable>
    <variable type="other" id="v02">分數</variable>
    <variable type="other" id="v03">幸運分數</variable>
    <variable type="other" id="v04">倒楣分數</variable>
  </variables>
  <block type="javascript_start_scratch" x="20" y="20">
    <next>
      <block type="javascript_data_input_scratch">
        <value name="TEXT">
          <shadow type="text_noquotes">
            <field name="TEXT"/>
          </shadow>
        </value>
        <next>
          <block type="variables_set_other">
            <field name="VAR" id="v01" variabletype="other">人數</field>
            <value name="VALUE">
              <shadow type="text_noquotes">
                <field name="TEXT">0</field>
              </shadow>
              <block type="javascript_data_input_get_scratch"/>
            </value>
            <next>
              <block type="variables_set_other">
                <field name="VAR" id="v03" variabletype="other">幸運分數</field>
                <value name="VALUE">
                  <shadow type="text_noquotes">
                    <field name="TEXT">101</field>
                  </shadow>
                </value>
                <next>
                  <block type="variables_set_other">
                    <field name="VAR" id="v04" variabletype="other">倒楣分數</field>
                    <value name="VALUE">
                      <shadow type="text_noquotes">
                        <field name="TEXT">-1</field>
                      </shadow>
                    </value>
                    <next>
                      <block type="controls_repeat_ext_scratch">
                        <value name="TIMES">
                          <shadow type="math_number">
                            <field name="NUM">10</field>
                          </shadow>
                          <block type="variables_get_other">
                            <field name="VAR" id="v01" variabletype="other">人數</field>
                          </block>
                        </value>
                        <statement name="DO">
                          <block type="javascript_data_input_scratch">
                            <value name="TEXT">
                              <shadow type="text_noquotes">
                                <field name="TEXT"/>
                              </shadow>
                            </value>
                            <next>
                              <block type="variables_set_other">
                                <field name="VAR" id="v02" variabletype="other">分數</field>
                                <value name="VALUE">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">0</field>
                                  </shadow>
                                  <block type="javascript_data_input_get_scratch"/>
                                </value>
                                <next>
                                  <block type="controls_if_2_scratch">
                                    <value name="condition">
                                      <block type="logic_compare">
                                        <field name="OP">GTE</field>
                                        <value name="A">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT">0</field>
                                          </shadow>
                                          <block type="variables_get_other">
                                            <field name="VAR" id="v02" variabletype="other">分數</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT">65</field>
                                          </shadow>
                                        </value>
                                      </block>
                                    </value>
                                    <statement name="statement_if">
                                      <block type="controls_if_1_scratch">
                                        <value name="condition">
                                          <block type="logic_compare">
                                            <field name="OP">LT</field>
                                            <value name="A">
                                              <shadow type="text_noquotes">
                                                <field name="TEXT">0</field>
                                              </shadow>
                                              <block type="variables_get_other">
                                                <field name="VAR" id="v02" variabletype="other">分數</field>
                                              </block>
                                            </value>
                                            <value name="B">
                                              <shadow type="text_noquotes">
                                                <field name="TEXT">0</field>
                                              </shadow>
                                              <block type="variables_get_other">
                                                <field name="VAR" id="v03" variabletype="other">幸運分數</field>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                        <statement name="statement_if">
                                          <block type="variables_set_other">
                                            <field name="VAR" id="v03" variabletype="other">幸運分數</field>
                                            <value name="VALUE">
                                              <shadow type="text_noquotes">
                                                <field name="TEXT">0</field>
                                              </shadow>
                                              <block type="variables_get_other">
                                                <field name="VAR" id="v02" variabletype="other">分數</field>
                                              </block>
                                            </value>
                                          </block>
                                        </statement>
                                      </block>
                                    </statement>
                                    <statement name="statement_else">
                                      <block type="controls_if_1_scratch">
                                        <value name="condition">
                                          <block type="logic_compare">
                                            <field name="OP">GT</field>
                                            <value name="A">
                                              <shadow type="text_noquotes">
                                                <field name="TEXT">0</field>
                                              </shadow>
                                              <block type="variables_get_other">
                                                <field name="VAR" id="v02" variabletype="other">分數</field>
                                              </block>
                                            </value>
                                            <value name="B">
                                              <shadow type="text_noquotes">
                                                <field name="TEXT">0</field>
                                              </shadow>
                                              <block type="variables_get_other">
                                                <field name="VAR" id="v04" variabletype="other">倒楣分數</field>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                        <statement name="statement_if">
                                          <block type="variables_set_other">
                                            <field name="VAR" id="v04" variabletype="other">倒楣分數</field>
                                            <value name="VALUE">
                                              <shadow type="text_noquotes">
                                                <field name="TEXT">0</field>
                                              </shadow>
                                              <block type="variables_get_other">
                                                <field name="VAR" id="v02" variabletype="other">分數</field>
                                              </block>
                                            </value>
                                          </block>
                                        </statement>
                                      </block>
                                    </statement>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </statement>
                        <next>
                          <block type="controls_if_1_scratch">
                            <value name="condition">
                              <block type="logic_compare">
                                <field name="OP">LTE</field>
                                <value name="A">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">0</field>
                                  </shadow>
                                  <block type="variables_get_other">
                                    <field name="VAR" id="v03" variabletype="other">幸運分數</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">100</field>
                                  </shadow>
                                </value>
                              </block>
                            </value>
                            <statement name="statement_if">
                              <block type="javascript_data_output_scratch">
                                <value name="TEXT">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">幸運</field>
                                  </shadow>
                                </value>
                                <next>
                                  <block type="javascript_data_output_scratch">
                                    <value name="TEXT">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT"/>
                                      </shadow>
                                      <block type="variables_get_other">
                                        <field name="VAR" id="v03" variabletype="other">幸運分數</field>
                                      </block>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </statement>
                            <next>
                              <block type="controls_if_1_scratch">
                                <value name="condition">
                                  <block type="logic_compare">
                                    <field name="OP">GTE</field>
                                    <value name="A">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">0</field>
                                      </shadow>
                                      <block type="variables_get_other">
                                        <field name="VAR" id="v04" variabletype="other">倒楣分數</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">0</field>
                                      </shadow>
                                    </value>
                                  </block>
                                </value>
                                <statement name="statement_if">
                                  <block type="javascript_data_output_scratch">
                                    <value name="TEXT">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">倒楣</field>
                                      </shadow>
                                    </value>
                                    <next>
                                      <block type="javascript_data_output_scratch">
                                        <value name="TEXT">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT"/>
                                          </shadow>
                                          <block type="variables_get_other">
                                            <field name="VAR" id="v04" variabletype="other">倒楣分數</field>
                                          </block>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </statement>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

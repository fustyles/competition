<xml xmlns="https://developers.google.com/blockly/xml" platform="blockly">
  <variables>
    <variable id="v01">卡號</variable>
    <variable id="v02">字母</variable>
    <variable id="v03">總和</variable>
    <variable id="v04">i</variable>
    <variable id="v05">數字</variable>
  </variables>
  <block x="20" y="20" type="javascript_data_input_scratch">
    <value name="TEXT">
      <shadow type="text_noquotes">
        <field name="TEXT"/>
      </shadow>
    </value>
    <next>
      <block type="variables_set_local">
        <field name="VAR" id="v01">卡號</field>
        <value name="VALUE">
          <block type="javascript_data_input_get_scratch"/>
        </value>
        <next>
          <block type="variables_set_local">
            <field name="VAR" id="v02">字母</field>
            <value name="VALUE">
              <block type="text_charAt">
                <mutation at="true"/>
                <field name="WHERE">FROM_START</field>
                <value name="VALUE">
                  <block type="variables_get">
                    <field name="VAR" id="v01">卡號</field>
                  </block>
                </value>
                <value name="AT">
                  <block type="math_number">
                    <field name="NUM">1</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="controls_if">
                <mutation elseif="2" else="1"/>
                <value name="IF0">
                  <block type="logic_compare">
                    <field name="OP">EQ</field>
                    <value name="A">
                      <block type="variables_get">
                        <field name="VAR" id="v02">字母</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="text">
                        <field name="TEXT">A</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="variables_set_local">
                    <field name="VAR" id="v03">總和</field>
                    <value name="VALUE">
                      <block type="math_number">
                        <field name="NUM">11</field>
                      </block>
                    </value>
                  </block>
                </statement>
                <value name="IF1">
                  <block type="logic_compare">
                    <field name="OP">EQ</field>
                    <value name="A">
                      <block type="variables_get">
                        <field name="VAR" id="v02">字母</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="text">
                        <field name="TEXT">B</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO1">
                  <block type="variables_set_local">
                    <field name="VAR" id="v03">總和</field>
                    <value name="VALUE">
                      <block type="math_number">
                        <field name="NUM">13</field>
                      </block>
                    </value>
                  </block>
                </statement>
                <value name="IF2">
                  <block type="logic_compare">
                    <field name="OP">EQ</field>
                    <value name="A">
                      <block type="variables_get">
                        <field name="VAR" id="v02">字母</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="text">
                        <field name="TEXT">C</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO2">
                  <block type="variables_set_local">
                    <field name="VAR" id="v03">總和</field>
                    <value name="VALUE">
                      <block type="math_number">
                        <field name="NUM">15</field>
                      </block>
                    </value>
                  </block>
                </statement>
                <statement name="ELSE">
                  <block type="variables_set_local">
                    <field name="VAR" id="v03">總和</field>
                    <value name="VALUE">
                      <block type="math_number">
                        <field name="NUM">17</field>
                      </block>
                    </value>
                  </block>
                </statement>
                <next>
                  <block type="controls_for">
                    <field name="VAR" id="v04">i</field>
                    <value name="FROM">
                      <block type="math_number">
                        <field name="NUM">2</field>
                      </block>
                    </value>
                    <value name="TO">
                      <block type="math_number">
                        <field name="NUM">6</field>
                      </block>
                    </value>
                    <value name="BY">
                      <block type="math_number">
                        <field name="NUM">1</field>
                      </block>
                    </value>
                    <statement name="DO">
                      <block type="variables_set_local">
                        <field name="VAR" id="v05">數字</field>
                        <value name="VALUE">
                          <block type="text_charAt">
                            <mutation at="true"/>
                            <field name="WHERE">FROM_START</field>
                            <value name="VALUE">
                              <block type="variables_get">
                                <field name="VAR" id="v01">卡號</field>
                              </block>
                            </value>
                            <value name="AT">
                              <block type="variables_get">
                                <field name="VAR" id="v04">i</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set_local">
                            <field name="VAR" id="v03">總和</field>
                            <value name="VALUE">
                              <block type="math_arithmetic">
                                <field name="OP">ADD</field>
                                <value name="A">
                                  <block type="variables_get">
                                    <field name="VAR" id="v03">總和</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="variables_get">
                                    <field name="VAR" id="v05">數字</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <block type="controls_if">
                        <mutation elseif="0" else="1"/>
                        <value name="IF0">
                          <block type="logic_compare">
                            <field name="OP">EQ</field>
                            <value name="A">
                              <block type="math_modulo">
                                <value name="DIVIDEND">
                                  <block type="variables_get">
                                    <field name="VAR" id="v03">總和</field>
                                  </block>
                                </value>
                                <value name="DIVISOR">
                                  <block type="math_number">
                                    <field name="NUM">5</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_number">
                                <field name="NUM">4</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="javascript_data_output">
                            <value name="TEXT">
                              <shadow type="text"><field name="TEXT"/></shadow>
                              <block type="text">
                                <field name="TEXT">yes</field>
                              </block>
                            </value>
                          </block>
                        </statement>
                        <statement name="ELSE">
                          <block type="javascript_data_output">
                            <value name="TEXT">
                              <shadow type="text"><field name="TEXT"/></shadow>
                              <block type="text">
                                <field name="TEXT">no</field>
                              </block>
                            </value>
                          </block>
                        </statement>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

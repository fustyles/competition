<xml xmlns="https://developers.google.com/blockly/xml" platform="blockly">
  <variables>
    <variable id="v01">S</variable>
    <variable id="v02">字串</variable>
    <variable id="v03">數值</variable>
    <variable id="v04">i</variable>
    <variable id="v05">位</variable>
  </variables>
  <block x="20" y="20" type="javascript_data_input_scratch">
    <value name="TEXT">
      <shadow type="text_noquotes">
        <field name="TEXT"/>
      </shadow>
    </value>
    <next>
      <block type="variables_set_local">
        <field name="VAR" id="v01">S</field>
        <value name="VALUE">
          <block type="javascript_data_input_get_scratch"/>
        </value>
        <next>
          <block type="variables_set_local">
            <field name="VAR" id="v02">字串</field>
            <value name="VALUE">
              <block type="text_join">
                <mutation items="2"/>
                <value name="ADD0">
                  <block type="variables_get">
                    <field name="VAR" id="v01">S</field>
                  </block>
                </value>
                <value name="ADD1">
                  <block type="text">
                    <field name="TEXT"/>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="variables_set_local">
                <field name="VAR" id="v03">數值</field>
                <value name="VALUE">
                  <block type="math_number">
                    <field name="NUM">0</field>
                  </block>
                </value>
                <next>
                  <block type="controls_for">
                    <field name="VAR" id="v04">i</field>
                    <value name="FROM">
                      <block type="math_number">
                        <field name="NUM">1</field>
                      </block>
                    </value>
                    <value name="TO">
                      <block type="text_length">
                        <value name="VALUE">
                          <block type="variables_get">
                            <field name="VAR" id="v02">字串</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <value name="BY">
                      <block type="math_number">
                        <field name="NUM">1</field>
                      </block>
                    </value>
                    <statement name="DO">
                      <block type="variables_set_local">
                        <field name="VAR" id="v05">位</field>
                        <value name="VALUE">
                          <block type="text_charAt">
                            <mutation at="true"/>
                            <field name="WHERE">FROM_START</field>
                            <value name="VALUE">
                              <block type="variables_get">
                                <field name="VAR" id="v02">字串</field>
                              </block>
                            </value>
                            <value name="AT">
                              <block type="variables_get">
                                <field name="VAR" id="v04">i</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set_local">
                            <field name="VAR" id="v03">數值</field>
                            <value name="VALUE">
                              <block type="math_arithmetic">
                                <field name="OP">ADD</field>
                                <value name="A">
                                  <block type="math_arithmetic">
                                    <field name="OP">MULTIPLY</field>
                                    <value name="A">
                                      <block type="variables_get">
                                        <field name="VAR" id="v03">數值</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="math_number">
                                        <field name="NUM">2</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="variables_get">
                                    <field name="VAR" id="v05">位</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <block type="javascript_data_output">
                        <value name="TEXT">
                          <shadow type="text"><field name="TEXT"/></shadow>
                          <block type="variables_get">
                            <field name="VAR" id="v03">數值</field>
                          </block>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

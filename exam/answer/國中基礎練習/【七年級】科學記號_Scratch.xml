<xml xmlns="https://developers.google.com/blockly/xml" platform="scratch">
  <variables>
    <variable type="other" id="v1">數</variable>
    <variable type="other" id="v2">長度</variable>
    <variable type="other" id="v3">k</variable>
    <variable type="other" id="v4">a</variable>
    <variable type="other" id="v5">i</variable>
  </variables>
  <block x="20" y="0" type="javascript_start_scratch">
    <next>
      <block type="javascript_data_input_scratch">
        <value name="TEXT">
          <shadow type="text_noquotes">
            <field name="TEXT"/>
          </shadow>
        </value>
        <next>
          <block type="variables_set_other">
            <field name="VAR" id="v1" variabletype="other">數</field>
            <value name="VALUE">
              <shadow type="text_noquotes">
                <field name="TEXT">0</field>
              </shadow>
              <block type="javascript_data_input_get_scratch"/>
            </value>
            <next>
              <block type="variables_set_other">
                <field name="VAR" id="v2" variabletype="other">長度</field>
                <value name="VALUE">
                  <shadow type="text_noquotes">
                    <field name="TEXT">0</field>
                  </shadow>
                  <block type="text_length_scratch">
                    <value name="VALUE">
                      <shadow type="text_noquotes">
                        <field name="TEXT">abc</field>
                      </shadow>
                      <block type="variables_get_other">
                        <field name="VAR" id="v1" variabletype="other">數</field>
                      </block>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="variables_set_other">
                    <field name="VAR" id="v3" variabletype="other">k</field>
                    <value name="VALUE">
                      <shadow type="text_noquotes">
                        <field name="TEXT">0</field>
                      </shadow>
                      <block type="variables_get_other">
                        <field name="VAR" id="v2" variabletype="other">長度</field>
                      </block>
                    </value>
                    <next>
                      <block type="controls_whileUntil_scratch">
                        <field name="MODE">UNTIL</field>
                        <value name="BOOL">
                          <block type="logic_operation">
                            <field name="OP">OR</field>
                            <value name="A">
                              <block type="logic_compare">
                                <value name="A">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">0</field>
                                  </shadow>
                                  <block type="variables_get_other">
                                    <field name="VAR" id="v3" variabletype="other">k</field>
                                  </block>
                                </value>
                                <field name="OP">EQ</field>
                                <value name="B">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">1</field>
                                  </shadow>
                                </value>
                              </block>
                            </value>
                            <value name="B">
                              <block type="logic_compare">
                                <value name="A">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">0</field>
                                  </shadow>
                                  <block type="text_charAt_scratch">
                                    <value name="VALUE">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">abc</field>
                                      </shadow>
                                      <block type="variables_get_other">
                                        <field name="VAR" id="v1" variabletype="other">數</field>
                                      </block>
                                    </value>
                                    <value name="WHERE">
                                      <shadow type="math_number">
                                        <field name="NUM">1</field>
                                      </shadow>
                                      <block type="variables_get_other">
                                        <field name="VAR" id="v3" variabletype="other">k</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <field name="OP">NEQ</field>
                                <value name="B">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">0</field>
                                  </shadow>
                                </value>
                              </block>
                            </value>
                          </block>
                        </value>
                        <statement name="DO">
                          <block type="math_change_other">
                            <field name="VAR" id="v3" variabletype="other">k</field>
                            <value name="DELTA">
                              <shadow type="math_number">
                                <field name="NUM">-1</field>
                              </shadow>
                            </value>
                          </block>
                        </statement>
                        <next>
                          <block type="variables_set_other">
                            <field name="VAR" id="v4" variabletype="other">a</field>
                            <value name="VALUE">
                              <shadow type="text_noquotes">
                                <field name="TEXT">0</field>
                              </shadow>
                              <block type="text_charAt_scratch">
                                <value name="VALUE">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">abc</field>
                                  </shadow>
                                  <block type="variables_get_other">
                                    <field name="VAR" id="v1" variabletype="other">數</field>
                                  </block>
                                </value>
                                <value name="WHERE">
                                  <shadow type="math_number">
                                    <field name="NUM">1</field>
                                  </shadow>
                                </value>
                              </block>
                            </value>
                            <next>
                              <block type="controls_if_1_scratch">
                                <value name="condition">
                                  <block type="logic_compare">
                                    <value name="A">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">0</field>
                                      </shadow>
                                      <block type="variables_get_other">
                                        <field name="VAR" id="v3" variabletype="other">k</field>
                                      </block>
                                    </value>
                                    <field name="OP">GT</field>
                                    <value name="B">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">1</field>
                                      </shadow>
                                    </value>
                                  </block>
                                </value>
                                <statement name="statement_if">
                                  <block type="variables_set_other">
                                    <field name="VAR" id="v4" variabletype="other">a</field>
                                    <value name="VALUE">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">0</field>
                                      </shadow>
                                      <block type="text_join_scratch">
                                        <value name="VALUE1">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT">abc</field>
                                          </shadow>
                                          <block type="variables_get_other">
                                            <field name="VAR" id="v4" variabletype="other">a</field>
                                          </block>
                                        </value>
                                        <value name="VALUE2">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT">.</field>
                                          </shadow>
                                        </value>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="variables_set_other">
                                        <field name="VAR" id="v5" variabletype="other">i</field>
                                        <value name="VALUE">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT">2</field>
                                          </shadow>
                                        </value>
                                        <next>
                                          <block type="controls_whileUntil_scratch">
                                            <field name="MODE">UNTIL</field>
                                            <value name="BOOL">
                                              <block type="logic_compare">
                                                <value name="A">
                                                  <shadow type="text_noquotes">
                                                    <field name="TEXT">0</field>
                                                  </shadow>
                                                  <block type="variables_get_other">
                                                    <field name="VAR" id="v5" variabletype="other">i</field>
                                                  </block>
                                                </value>
                                                <field name="OP">GT</field>
                                                <value name="B">
                                                  <shadow type="text_noquotes">
                                                    <field name="TEXT">0</field>
                                                  </shadow>
                                                  <block type="variables_get_other">
                                                    <field name="VAR" id="v3" variabletype="other">k</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <statement name="DO">
                                              <block type="variables_set_other">
                                                <field name="VAR" id="v4" variabletype="other">a</field>
                                                <value name="VALUE">
                                                  <shadow type="text_noquotes">
                                                    <field name="TEXT">0</field>
                                                  </shadow>
                                                  <block type="text_join_scratch">
                                                    <value name="VALUE1">
                                                      <shadow type="text_noquotes">
                                                        <field name="TEXT">abc</field>
                                                      </shadow>
                                                      <block type="variables_get_other">
                                                        <field name="VAR" id="v4" variabletype="other">a</field>
                                                      </block>
                                                    </value>
                                                    <value name="VALUE2">
                                                      <shadow type="text_noquotes">
                                                        <field name="TEXT">def</field>
                                                      </shadow>
                                                      <block type="text_charAt_scratch">
                                                        <value name="VALUE">
                                                          <shadow type="text_noquotes">
                                                            <field name="TEXT">abc</field>
                                                          </shadow>
                                                          <block type="variables_get_other">
                                                            <field name="VAR" id="v1" variabletype="other">數</field>
                                                          </block>
                                                        </value>
                                                        <value name="WHERE">
                                                          <shadow type="math_number">
                                                            <field name="NUM">1</field>
                                                          </shadow>
                                                          <block type="variables_get_other">
                                                            <field name="VAR" id="v5" variabletype="other">i</field>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                                <next>
                                                  <block type="math_change_other">
                                                    <field name="VAR" id="v5" variabletype="other">i</field>
                                                    <value name="DELTA">
                                                      <shadow type="math_number">
                                                        <field name="NUM">1</field>
                                                      </shadow>
                                                    </value>
                                                  </block>
                                                </next>
                                              </block>
                                            </statement>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </statement>
                                <next>
                                  <block type="javascript_data_output_scratch">
                                    <value name="TEXT">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT"/>
                                      </shadow>
                                      <block type="variables_get_other">
                                        <field name="VAR" id="v4" variabletype="other">a</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="javascript_data_output_scratch">
                                        <value name="TEXT">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT"/>
                                          </shadow>
                                          <block type="math_arithmetic">
                                            <field name="OP">MINUS</field>
                                            <value name="A">
                                              <shadow type="math_number">
                                                <field name="NUM">0</field>
                                              </shadow>
                                              <block type="variables_get_other">
                                                <field name="VAR" id="v2" variabletype="other">長度</field>
                                              </block>
                                            </value>
                                            <value name="B">
                                              <shadow type="math_number">
                                                <field name="NUM">1</field>
                                              </shadow>
                                            </value>
                                          </block>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

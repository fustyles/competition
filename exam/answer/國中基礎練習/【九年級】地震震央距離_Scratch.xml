<xml xmlns="https://developers.google.com/blockly/xml" platform="scratch">
  <variables>
    <variable type="other" id="v1">N</variable>
    <variable type="other" id="v2">最近</variable>
    <variable type="other" id="v3">i</variable>
    <variable type="other" id="v4">距離</variable>
    <variable type="other" id="v5">編號</variable>
    <variable type="Array" id="lres">結果</variable>
    <variable type="other" id="vidx">第幾筆</variable>
  </variables>
  <block x="20" y="0" type="javascript_start_scratch">
    <next>
      <block type="javascript_data_input_scratch">
        <value name="TEXT">
          <shadow type="text_noquotes">
            <field name="TEXT" />
          </shadow>
        </value>
        <next>
          <block type="variables_set_other">
            <field name="VAR" id="v1" variabletype="other">N</field>
            <value name="VALUE">
              <shadow type="text_noquotes">
                <field name="TEXT">0</field>
              </shadow>
              <block type="javascript_data_input_get_scratch" />
            </value>
            <next>
              <block type="variables_set_other">
                <field name="VAR" id="v2" variabletype="other">最近</field>
                <value name="VALUE">
                  <shadow type="text_noquotes">
                    <field name="TEXT">-1</field>
                  </shadow>
                </value>
                <next>
                  <block type="variables_set_other">
                    <field name="VAR" id="v3" variabletype="other">i</field>
                    <value name="VALUE">
                      <shadow type="text_noquotes">
                        <field name="TEXT">1</field>
                      </shadow>
                    </value>
                    <next>
                      <block type="list_deletealloflist_scratch">
                        <field name="VAR" id="lres" variabletype="Array">結果</field>
                        <next>
                          <block type="controls_repeat_ext_scratch">
                            <value name="TIMES">
                              <shadow type="math_number">
                                <field name="NUM">10</field>
                              </shadow>
                              <block type="variables_get_other">
                                <field name="VAR" id="v1" variabletype="other">N</field>
                              </block>
                            </value>
                            <statement name="DO">
                              <block type="javascript_data_input_scratch">
                                <value name="TEXT">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT" />
                                  </shadow>
                                </value>
                                <next>
                                  <block type="variables_set_other">
                                    <field name="VAR" id="v4" variabletype="other">距離</field>
                                    <value name="VALUE">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">0</field>
                                      </shadow>
                                      <block type="math_arithmetic">
                                        <field name="OP">DIVIDE</field>
                                        <value name="A">
                                          <shadow type="math_number">
                                            <field name="NUM">0</field>
                                          </shadow>
                                          <block type="math_round">
                                            <field name="OP">ROUND</field>
                                            <value name="NUM">
                                              <shadow type="math_number">
                                                <field name="NUM">3.1</field>
                                              </shadow>
                                              <block type="math_arithmetic">
                                                <field name="OP">MULTIPLY</field>
                                                <value name="A">
                                                  <shadow type="math_number">
                                                    <field name="NUM">0</field>
                                                  </shadow>
                                                  <block type="javascript_data_input_get_scratch" />
                                                </value>
                                                <value name="B">
                                                  <shadow type="math_number">
                                                    <field name="NUM">120</field>
                                                  </shadow>
                                                </value>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <shadow type="math_number">
                                            <field name="NUM">10</field>
                                          </shadow>
                                        </value>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="list_addtolist_scratch">
                                        <value name="ITEM">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT" />
                                          </shadow>
                                          <block type="variables_get_other">
                                            <field name="VAR" id="v4" variabletype="other">距離</field>
                                          </block>
                                        </value>
                                        <field name="VAR" id="lres" variabletype="Array">結果</field>
                                        <next>
                                          <block type="controls_if_1_scratch">
                                            <value name="condition">
                                              <block type="logic_operation">
                                                <field name="OP">OR</field>
                                                <value name="A">
                                                  <block type="logic_compare">
                                                    <value name="A">
                                                      <shadow type="text_noquotes">
                                                        <field name="TEXT">0</field>
                                                      </shadow>
                                                      <block type="variables_get_other">
                                                        <field name="VAR" id="v2" variabletype="other">最近</field>
                                                      </block>
                                                    </value>
                                                    <field name="OP">EQ</field>
                                                    <value name="B">
                                                      <shadow type="text_noquotes">
                                                        <field name="TEXT">-1</field>
                                                      </shadow>
                                                    </value>
                                                  </block>
                                                </value>
                                                <value name="B">
                                                  <block type="logic_compare">
                                                    <value name="A">
                                                      <shadow type="text_noquotes">
                                                        <field name="TEXT">0</field>
                                                      </shadow>
                                                      <block type="variables_get_other">
                                                        <field name="VAR" id="v4" variabletype="other">距離</field>
                                                      </block>
                                                    </value>
                                                    <field name="OP">LT</field>
                                                    <value name="B">
                                                      <shadow type="text_noquotes">
                                                        <field name="TEXT">0</field>
                                                      </shadow>
                                                      <block type="variables_get_other">
                                                        <field name="VAR" id="v2" variabletype="other">最近</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <statement name="statement_if">
                                              <block type="variables_set_other">
                                                <field name="VAR" id="v2" variabletype="other">最近</field>
                                                <value name="VALUE">
                                                  <shadow type="text_noquotes">
                                                    <field name="TEXT">0</field>
                                                  </shadow>
                                                  <block type="variables_get_other">
                                                    <field name="VAR" id="v4" variabletype="other">距離</field>
                                                  </block>
                                                </value>
                                                <next>
                                                  <block type="variables_set_other">
                                                    <field name="VAR" id="v5" variabletype="other">編號</field>
                                                    <value name="VALUE">
                                                      <shadow type="text_noquotes">
                                                        <field name="TEXT">0</field>
                                                      </shadow>
                                                      <block type="variables_get_other">
                                                        <field name="VAR" id="v3" variabletype="other">i</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </next>
                                              </block>
                                            </statement>
                                            <next>
                                              <block type="math_change_other">
                                                <field name="VAR" id="v3" variabletype="other">i</field>
                                                <value name="DELTA">
                                                  <shadow type="math_number">
                                                    <field name="NUM">1</field>
                                                  </shadow>
                                                </value>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </statement>
                            <next>
                              <block type="variables_set_other">
                                <field name="VAR" id="vidx" variabletype="other">第幾筆</field>
                                <value name="VALUE">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">1</field>
                                  </shadow>
                                </value>
                                <next>
                                  <block type="controls_repeat_ext_scratch">
                                    <value name="TIMES">
                                      <shadow type="math_number">
                                        <field name="NUM">10</field>
                                      </shadow>
                                      <block type="list_lengthoflist_scratch">
                                        <field name="VAR" id="lres" variabletype="Array">結果</field>
                                      </block>
                                    </value>
                                    <statement name="DO">
                                      <block type="javascript_data_output_scratch">
                                        <value name="TEXT">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT" />
                                          </shadow>
                                          <block type="list_itemoflist_scratch">
                                            <field name="VAR" id="lres" variabletype="Array">結果</field>
                                            <value name="INDEX">
                                              <shadow type="math_number">
                                                <field name="NUM">1</field>
                                              </shadow>
                                              <block type="variables_get_other">
                                                <field name="VAR" id="vidx" variabletype="other">第幾筆</field>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="math_change_other">
                                            <field name="VAR" id="vidx" variabletype="other">第幾筆</field>
                                            <value name="DELTA">
                                              <shadow type="math_number">
                                                <field name="NUM">1</field>
                                              </shadow>
                                            </value>
                                          </block>
                                        </next>
                                      </block>
                                    </statement>
                                    <next>
                                      <block type="javascript_data_output_scratch">
                                        <value name="TEXT">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT" />
                                          </shadow>
                                          <block type="variables_get_other">
                                            <field name="VAR" id="v5" variabletype="other">編號</field>
                                          </block>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
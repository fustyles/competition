          <block type="javascript_data_input_get_scratch" id="b3"></block>
        </value>
        <next>
          <block type="variables_set_local" id="b6">
            <field name="VAR" id="v_等級總和">等級總和</field>
            <value name="VALUE">
              <block type="math_number" id="b5">
                <field name="NUM">0</field>
              </block>
            </value>
            <next>
              <block type="controls_repeat_ext" id="b16">
                <value name="TIMES">
                  <shadow type="math_number" id="s7">
                    <field name="NUM">10</field>
                  </shadow>
                  <block type="variables_get" id="b8">
                    <field name="VAR" id="v_寶可夢數量">寶可夢數量</field>
                  </block>
                </value>
                <statement name="DO">
                  <block type="javascript_data_input_scratch" id="b10">
                    <value name="TEXT">
                      <shadow type="text_noquotes" id="s9">
                        <field name="TEXT"></field>
                      </shadow>
                    </value>
                    <next>
                      <block type="variables_set_local" id="b12">
                        <field name="VAR" id="v_等級">等級</field>
                        <value name="VALUE">
                          <block type="javascript_data_input_get_scratch" id="b11"></block>
                        </value>
                        <next>
                          <block type="math_change" id="b15">
                            <field name="VAR" id="v_等級總和">等級總和</field>
                            <value name="DELTA">
                              <shadow type="math_number" id="s13">
                                <field name="NUM">1</field>
                              </shadow>
                              <block type="variables_get" id="b14">
                                <field name="VAR" id="v_等級">等級</field>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </statement>
                <next>
                  <block type="javascript_data_output" id="b25">
                    <value name="TEXT">
                      <shadow type="text" id="s17">
                        <field name="TEXT"></field>
                      </shadow>
                      <block type="math_round" id="b24">
                        <field name="OP">ROUNDDOWN</field>
                        <value name="NUM">
                          <shadow type="math_number" id="s18">
                            <field name="NUM">3.1</field>
                          </shadow>
                          <block type="math_arithmetic" id="b23">
                            <field name="OP">DIVIDE</field>
                            <value name="A">
                              <shadow type="math_number" id="s19">
                                <field name="NUM">0</field>
                              </shadow>
                              <block type="variables_get" id="b20">
                                <field name="VAR" id="v_等級總和">等級總和</field>
                              </block>
                            </value>
                            <value name="B">
                              <shadow type="math_number" id="s21">
                                <field name="NUM">0</field>
                              </shadow>
                              <block type="variables_get" id="b22">
                                <field name="VAR" id="v_寶可夢數量">寶可夢數量</field>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>

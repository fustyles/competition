<xml xmlns="https://developers.google.com/blockly/xml" platform="blockly">
  <variables>
    <variable id="v_是否會員">是否會員</variable>
    <variable id="v_消費金額">消費金額</variable>
    <variable id="v_應付金額">應付金額</variable>
  </variables>
  <block type="javascript_data_input_scratch" id="b2" x="30" y="30">
    <value name="TEXT">
      <shadow type="text_noquotes" id="s1">
        <field name="TEXT"></field>
      </shadow>
    </value>
    <next>
      <block type="variables_set_local" id="b4">
        <field name="VAR" id="v_是否會員">是否會員</field>
        <value name="VALUE">
          <block type="javascript_data_input_get_scratch" id="b3"></block>
        </value>
        <next>
          <block type="javascript_data_input_scratch" id="b6">
            <value name="TEXT">
              <shadow type="text_noquotes" id="s5">
                <field name="TEXT"></field>
              </shadow>
            </value>
            <next>
              <block type="variables_set_local" id="b8">
                <field name="VAR" id="v_消費金額">消費金額</field>
                <value name="VALUE">
                  <block type="javascript_data_input_get_scratch" id="b7"></block>
                </value>
                <next>
                  <block type="controls_if" id="b27">
                    <mutation else="1"></mutation>
                    <value name="IF0">
                      <block type="logic_compare" id="b11">
                        <field name="OP">EQ</field>
                        <value name="A">
                          <block type="variables_get" id="b9">
                            <field name="VAR" id="v_是否會員">是否會員</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="text" id="b10">
                            <field name="TEXT">是</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="variables_set_local" id="b18">
                        <field name="VAR" id="v_應付金額">應付金額</field>
                        <value name="VALUE">
                          <block type="math_round" id="b17">
                            <field name="OP">ROUND</field>
                            <value name="NUM">
                              <shadow type="math_number" id="s12">
                                <field name="NUM">3.1</field>
                              </shadow>
                              <block type="math_arithmetic" id="b16">
                                <field name="OP">MULTIPLY</field>
                                <value name="A">
                                  <shadow type="math_number" id="s13">
                                    <field name="NUM">0</field>
                                  </shadow>
                                  <block type="variables_get" id="b14">
                                    <field name="VAR" id="v_消費金額">消費金額</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <shadow type="math_number" id="s15">
                                    <field name="NUM">0.9</field>
                                  </shadow>
                                </value>
                              </block>
                            </value>
                          </block>
                        </value>
                        <next>
                          <block type="controls_if" id="b24">
                            <value name="IF0">
                              <block type="logic_compare" id="b21">
                                <field name="OP">GT</field>
                                <value name="A">
                                  <block type="variables_get" id="b19">
                                    <field name="VAR" id="v_應付金額">應付金額</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="math_number" id="b20">
                                    <field name="NUM">1000</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO0">
                              <block type="math_change" id="b23">
                                <field name="VAR" id="v_應付金額">應付金額</field>
                                <value name="DELTA">
                                  <shadow type="math_number" id="s22">
                                    <field name="NUM">-100</field>
                                  </shadow>
                                </value>
                              </block>
                            </statement>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <statement name="ELSE">
                      <block type="variables_set_local" id="b26">
                        <field name="VAR" id="v_應付金額">應付金額</field>
                        <value name="VALUE">
                          <block type="variables_get" id="b25">
                            <field name="VAR" id="v_消費金額">消費金額</field>
                          </block>
                        </value>
                      </block>
                    </statement>
                    <next>
                      <block type="javascript_data_output" id="b30">
                        <value name="TEXT">
                          <shadow type="text" id="s28">
                            <field name="TEXT"></field>
                          </shadow>
                          <block type="variables_get" id="b29">
                            <field name="VAR" id="v_應付金額">應付金額</field>
                          </block>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

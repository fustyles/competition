<xml xmlns="https://developers.google.com/blockly/xml" platform="scratch">
  <variables>
    <variable type="other" id="v_物品數量">物品數量</variable>
    <variable type="other" id="v_吸起數量">吸起數量</variable>
    <variable type="other" id="v_材質">材質</variable>
  </variables>
  <block type="javascript_start_scratch" id="b26" x="30" y="30">
    <next>
      <block type="javascript_data_input_scratch" id="b2">
        <value name="TEXT">
          <shadow type="text_noquotes" id="s1">
            <field name="TEXT"></field>
          </shadow>
        </value>
        <next>
          <block type="variables_set_other" id="b5">
            <field name="VAR" id="v_物品數量" variabletype="other">物品數量</field>
            <value name="VALUE">
              <shadow type="text_noquotes" id="s3">
                <field name="TEXT">0</field>
              </shadow>
              <block type="javascript_data_input_get_scratch" id="b4"></block>
            </value>
            <next>
              <block type="variables_set_other" id="b7">
                <field name="VAR" id="v_吸起數量" variabletype="other">吸起數量</field>
                <value name="VALUE">
                  <shadow type="text_noquotes" id="s6">
                    <field name="TEXT">0</field>
                  </shadow>
                </value>
                <next>
                  <block type="controls_repeat_ext_scratch" id="b22">
                    <value name="TIMES">
                      <shadow type="math_number" id="s8">
                        <field name="NUM">10</field>
                      </shadow>
                      <block type="variables_get_other" id="b9">
                        <field name="VAR" id="v_物品數量" variabletype="other">物品數量</field>
                      </block>
                    </value>
                    <statement name="DO">
                      <block type="javascript_data_input_scratch" id="b11">
                        <value name="TEXT">
                          <shadow type="text_noquotes" id="s10">
                            <field name="TEXT"></field>
                          </shadow>
                        </value>
                        <next>
                          <block type="variables_set_other" id="b14">
                            <field name="VAR" id="v_材質" variabletype="other">材質</field>
                            <value name="VALUE">
                              <shadow type="text_noquotes" id="s12">
                                <field name="TEXT">0</field>
                              </shadow>
                              <block type="javascript_data_input_get_scratch" id="b13"></block>
                            </value>
                            <next>
                              <block type="controls_if_1_scratch" id="b21">
                                <value name="condition">
                                  <block type="logic_compare" id="b18">
                                    <field name="OP">EQ</field>
                                    <value name="A">
                                      <shadow type="text_noquotes" id="s15">
                                        <field name="TEXT">0</field>
                                      </shadow>
                                      <block type="variables_get_other" id="b16">
                                        <field name="VAR" id="v_材質" variabletype="other">材質</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <shadow type="text_noquotes" id="s17">
                                        <field name="TEXT">鐵</field>
                                      </shadow>
                                    </value>
                                  </block>
                                </value>
                                <statement name="statement_if">
                                  <block type="math_change_other" id="b20">
                                    <field name="VAR" id="v_吸起數量" variabletype="other">吸起數量</field>
                                    <value name="DELTA">
                                      <shadow type="math_number" id="s19">
                                        <field name="NUM">1</field>
                                      </shadow>
                                    </value>
                                  </block>
                                </statement>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <block type="javascript_data_output_scratch" id="b25">
                        <value name="TEXT">
                          <shadow type="text_noquotes" id="s23">
                            <field name="TEXT"></field>
                          </shadow>
                          <block type="variables_get_other" id="b24">
                            <field name="VAR" id="v_吸起數量" variabletype="other">吸起數量</field>
                          </block>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

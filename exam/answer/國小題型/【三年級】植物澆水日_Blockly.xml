<xml xmlns="https://developers.google.com/blockly/xml" platform="blockly">
  <variables>
    <variable id="v_間隔天數">間隔天數</variable>
    <variable id="v_總天數">總天數</variable>
    <variable id="v_澆水日">澆水日</variable>
    <variable id="v_澆水次數">澆水次數</variable>
  </variables>
  <block type="javascript_data_input_scratch" id="b2" x="30" y="30">
    <value name="TEXT">
      <shadow type="text_noquotes" id="s1">
        <field name="TEXT"></field>
      </shadow>
    </value>
    <next>
      <block type="variables_set_local" id="b4">
        <field name="VAR" id="v_間隔天數">間隔天數</field>
        <value name="VALUE">
          <block type="javascript_data_input_get_scratch" id="b3"></block>
        </value>
        <next>
          <block type="javascript_data_input_scratch" id="b6">
            <value name="TEXT">
              <shadow type="text_noquotes" id="s5">
                <field name="TEXT"></field>
              </shadow>
            </value>
            <next>
              <block type="variables_set_local" id="b8">
                <field name="VAR" id="v_總天數">總天數</field>
                <value name="VALUE">
                  <block type="javascript_data_input_get_scratch" id="b7"></block>
                </value>
                <next>
                  <block type="variables_set_local" id="b10">
                    <field name="VAR" id="v_澆水日">澆水日</field>
                    <value name="VALUE">
                      <block type="math_number" id="b9">
                        <field name="NUM">1</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set_local" id="b12">
                        <field name="VAR" id="v_澆水次數">澆水次數</field>
                        <value name="VALUE">
                          <block type="math_number" id="b11">
                            <field name="NUM">0</field>
                          </block>
                        </value>
                        <next>
                          <block type="controls_whileUntil" id="b24">
                            <field name="MODE">WHILE</field>
                            <value name="BOOL">
                              <block type="logic_compare" id="b15">
                                <field name="OP">LTE</field>
                                <value name="A">
                                  <block type="variables_get" id="b13">
                                    <field name="VAR" id="v_澆水日">澆水日</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="variables_get" id="b14">
                                    <field name="VAR" id="v_總天數">總天數</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO">
                              <block type="javascript_data_output" id="b18">
                                <value name="TEXT">
                                  <shadow type="text" id="s16">
                                    <field name="TEXT"></field>
                                  </shadow>
                                  <block type="variables_get" id="b17">
                                    <field name="VAR" id="v_澆水日">澆水日</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="math_change" id="b20">
                                    <field name="VAR" id="v_澆水次數">澆水次數</field>
                                    <value name="DELTA">
                                      <shadow type="math_number" id="s19">
                                        <field name="NUM">1</field>
                                      </shadow>
                                    </value>
                                    <next>
                                      <block type="math_change" id="b23">
                                        <field name="VAR" id="v_澆水日">澆水日</field>
                                        <value name="DELTA">
                                          <shadow type="math_number" id="s21">
                                            <field name="NUM">1</field>
                                          </shadow>
                                          <block type="variables_get" id="b22">
                                            <field name="VAR" id="v_間隔天數">間隔天數</field>
                                          </block>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </statement>
                            <next>
                              <block type="javascript_data_output" id="b27">
                                <value name="TEXT">
                                  <shadow type="text" id="s25">
                                    <field name="TEXT"></field>
                                  </shadow>
                                  <block type="variables_get" id="b26">
                                    <field name="VAR" id="v_澆水次數">澆水次數</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml" platform="blockly">
  <variables>
    <variable id="v_總人數">總人數</variable>
    <variable id="v_應到座號">應到座號</variable>
    <variable id="v_報數座號">報數座號</variable>
  </variables>
  <block type="javascript_data_input_scratch" id="b2" x="30" y="30">
    <value name="TEXT">
      <shadow type="text_noquotes" id="s1">
        <field name="TEXT"></field>
      </shadow>
    </value>
    <next>
      <block type="variables_set_local" id="b4">
        <field name="VAR" id="v_總人數">總人數</field>
        <value name="VALUE">
          <block type="javascript_data_input_get_scratch" id="b3"></block>
        </value>
        <next>
          <block type="variables_set_local" id="b6">
            <field name="VAR" id="v_應到座號">應到座號</field>
            <value name="VALUE">
              <block type="math_number" id="b5">
                <field name="NUM">1</field>
              </block>
            </value>
            <next>
              <block type="controls_repeat_ext" id="b22">
                <value name="TIMES">
                  <shadow type="math_number" id="s7">
                    <field name="NUM">10</field>
                  </shadow>
                  <block type="math_arithmetic" id="b11">
                    <field name="OP">MINUS</field>
                    <value name="A">
                      <shadow type="math_number" id="s8">
                        <field name="NUM">0</field>
                      </shadow>
                      <block type="variables_get" id="b9">
                        <field name="VAR" id="v_總人數">總人數</field>
                      </block>
                    </value>
                    <value name="B">
                      <shadow type="math_number" id="s10">
                        <field name="NUM">1</field>
                      </shadow>
                    </value>
                  </block>
                </value>
                <statement name="DO">
                  <block type="javascript_data_input_scratch" id="b13">
                    <value name="TEXT">
                      <shadow type="text_noquotes" id="s12">
                        <field name="TEXT"></field>
                      </shadow>
                    </value>
                    <next>
                      <block type="variables_set_local" id="b15">
                        <field name="VAR" id="v_報數座號">報數座號</field>
                        <value name="VALUE">
                          <block type="javascript_data_input_get_scratch" id="b14"></block>
                        </value>
                        <next>
                          <block type="controls_if" id="b21">
                            <value name="IF0">
                              <block type="logic_compare" id="b18">
                                <field name="OP">EQ</field>
                                <value name="A">
                                  <block type="variables_get" id="b16">
                                    <field name="VAR" id="v_報數座號">報數座號</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="variables_get" id="b17">
                                    <field name="VAR" id="v_應到座號">應到座號</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO0">
                              <block type="math_change" id="b20">
                                <field name="VAR" id="v_應到座號">應到座號</field>
                                <value name="DELTA">
                                  <shadow type="math_number" id="s19">
                                    <field name="NUM">1</field>
                                  </shadow>
                                </value>
                              </block>
                            </statement>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </statement>
                <next>
                  <block type="javascript_data_output" id="b25">
                    <value name="TEXT">
                      <shadow type="text" id="s23">
                        <field name="TEXT"></field>
                      </shadow>
                      <block type="variables_get" id="b24">
                        <field name="VAR" id="v_應到座號">應到座號</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

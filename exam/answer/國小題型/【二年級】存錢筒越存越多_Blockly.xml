<xml xmlns="https://developers.google.com/blockly/xml" platform="blockly">
  <variables>
    <variable id="v_第一天存的錢">第一天存的錢</variable>
    <variable id="v_每天多存">每天多存</variable>
    <variable id="v_天數">天數</variable>
    <variable id="v_總金額">總金額</variable>
    <variable id="v_今天存的錢">今天存的錢</variable>
  </variables>
  <block type="javascript_data_input_scratch" id="b2" x="30" y="30">
    <value name="TEXT">
      <shadow type="text_noquotes" id="s1">
        <field name="TEXT"></field>
      </shadow>
    </value>
    <next>
      <block type="variables_set_local" id="b4">
        <field name="VAR" id="v_第一天存的錢">第一天存的錢</field>
        <value name="VALUE">
          <block type="javascript_data_input_get_scratch" id="b3"></block>
        </value>
        <next>
          <block type="javascript_data_input_scratch" id="b6">
            <value name="TEXT">
              <shadow type="text_noquotes" id="s5">
                <field name="TEXT"></field>
              </shadow>
            </value>
            <next>
              <block type="variables_set_local" id="b8">
                <field name="VAR" id="v_每天多存">每天多存</field>
                <value name="VALUE">
                  <block type="javascript_data_input_get_scratch" id="b7"></block>
                </value>
                <next>
                  <block type="javascript_data_input_scratch" id="b10">
                    <value name="TEXT">
                      <shadow type="text_noquotes" id="s9">
                        <field name="TEXT"></field>
                      </shadow>
                    </value>
                    <next>
                      <block type="variables_set_local" id="b12">
                        <field name="VAR" id="v_天數">天數</field>
                        <value name="VALUE">
                          <block type="javascript_data_input_get_scratch" id="b11"></block>
                        </value>
                        <next>
                          <block type="variables_set_local" id="b14">
                            <field name="VAR" id="v_總金額">總金額</field>
                            <value name="VALUE">
                              <block type="math_number" id="b13">
                                <field name="NUM">0</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set_local" id="b16">
                                <field name="VAR" id="v_今天存的錢">今天存的錢</field>
                                <value name="VALUE">
                                  <block type="variables_get" id="b15">
                                    <field name="VAR" id="v_第一天存的錢">第一天存的錢</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="controls_repeat_ext" id="b25">
                                    <value name="TIMES">
                                      <shadow type="math_number" id="s17">
                                        <field name="NUM">10</field>
                                      </shadow>
                                      <block type="variables_get" id="b18">
                                        <field name="VAR" id="v_天數">天數</field>
                                      </block>
                                    </value>
                                    <statement name="DO">
                                      <block type="math_change" id="b21">
                                        <field name="VAR" id="v_總金額">總金額</field>
                                        <value name="DELTA">
                                          <shadow type="math_number" id="s19">
                                            <field name="NUM">1</field>
                                          </shadow>
                                          <block type="variables_get" id="b20">
                                            <field name="VAR" id="v_今天存的錢">今天存的錢</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="math_change" id="b24">
                                            <field name="VAR" id="v_今天存的錢">今天存的錢</field>
                                            <value name="DELTA">
                                              <shadow type="math_number" id="s22">
                                                <field name="NUM">1</field>
                                              </shadow>
                                              <block type="variables_get" id="b23">
                                                <field name="VAR" id="v_每天多存">每天多存</field>
                                              </block>
                                            </value>
                                          </block>
                                        </next>
                                      </block>
                                    </statement>
                                    <next>
                                      <block type="javascript_data_output" id="b28">
                                        <value name="TEXT">
                                          <shadow type="text" id="s26">
                                            <field name="TEXT"></field>
                                          </shadow>
                                          <block type="variables_get" id="b27">
                                            <field name="VAR" id="v_總金額">總金額</field>
                                          </block>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml" platform="blockly">
  <variables>
    <variable id="v01">成本</variable>
    <variable id="v02">時段</variable>
    <variable id="v03">售價</variable>
    <variable id="v04">利潤</variable>
  </variables>
  <block x="20" y="20" type="javascript_data_input_scratch">
    <value name="TEXT">
      <shadow type="text_noquotes">
        <field name="TEXT"/>
      </shadow>
    </value>
    <next>
      <block type="variables_set_local">
        <field name="VAR" id="v01">成本</field>
        <value name="VALUE">
          <block type="javascript_data_input_get_scratch"/>
        </value>
        <next>
          <block type="javascript_data_input_scratch">
            <value name="TEXT">
              <shadow type="text_noquotes">
                <field name="TEXT"/>
              </shadow>
            </value>
            <next>
              <block type="variables_set_local">
                <field name="VAR" id="v02">時段</field>
                <value name="VALUE">
                  <block type="javascript_data_input_get_scratch"/>
                </value>
                <next>
                  <block type="variables_set_local">
                    <field name="VAR" id="v03">售價</field>
                    <value name="VALUE">
                      <block type="math_round">
                        <field name="OP">ROUND</field>
                        <value name="NUM">
                          <block type="math_arithmetic">
                            <field name="OP">MULTIPLY</field>
                            <value name="A">
                              <block type="variables_get">
                                <field name="VAR" id="v01">成本</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_number">
                                <field name="NUM">1.5</field>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                    <next>
                      <block type="controls_if">
                        <mutation elseif="1" else="0"/>
                        <value name="IF0">
                          <block type="logic_compare">
                            <field name="OP">GTE</field>
                            <value name="A">
                              <block type="variables_get">
                                <field name="VAR" id="v02">時段</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_number">
                                <field name="NUM">12</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="variables_set_local">
                            <field name="VAR" id="v03">售價</field>
                            <value name="VALUE">
                              <block type="math_round">
                                <field name="OP">ROUND</field>
                                <value name="NUM">
                                  <block type="math_arithmetic">
                                    <field name="OP">MULTIPLY</field>
                                    <value name="A">
                                      <block type="variables_get">
                                        <field name="VAR" id="v03">售價</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="math_number">
                                        <field name="NUM">0.6</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                              </block>
                            </value>
                          </block>
                        </statement>
                        <value name="IF1">
                          <block type="logic_compare">
                            <field name="OP">GTE</field>
                            <value name="A">
                              <block type="variables_get">
                                <field name="VAR" id="v02">時段</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_number">
                                <field name="NUM">11</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <statement name="DO1">
                          <block type="variables_set_local">
                            <field name="VAR" id="v03">售價</field>
                            <value name="VALUE">
                              <block type="math_round">
                                <field name="OP">ROUND</field>
                                <value name="NUM">
                                  <block type="math_arithmetic">
                                    <field name="OP">MULTIPLY</field>
                                    <value name="A">
                                      <block type="variables_get">
                                        <field name="VAR" id="v03">售價</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="math_number">
                                        <field name="NUM">0.8</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                              </block>
                            </value>
                          </block>
                        </statement>
                        <next>
                          <block type="variables_set_local">
                            <field name="VAR" id="v04">利潤</field>
                            <value name="VALUE">
                              <block type="math_arithmetic">
                                <field name="OP">MINUS</field>
                                <value name="A">
                                  <block type="variables_get">
                                    <field name="VAR" id="v03">售價</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="variables_get">
                                    <field name="VAR" id="v01">成本</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <next>
                              <block type="controls_if">
                                <mutation elseif="0" else="1"/>
                                <value name="IF0">
                                  <block type="logic_compare">
                                    <field name="OP">GT</field>
                                    <value name="A">
                                      <block type="variables_get">
                                        <field name="VAR" id="v04">利潤</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="math_number">
                                        <field name="NUM">0</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="DO0">
                                  <block type="javascript_data_output">
                                    <value name="TEXT">
                                      <shadow type="text"><field name="TEXT"/></shadow>
                                      <block type="text">
                                        <field name="TEXT">有利潤</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="javascript_data_output">
                                        <value name="TEXT">
                                          <shadow type="text"><field name="TEXT"/></shadow>
                                          <block type="text">
                                            <field name="TEXT">賺</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="javascript_data_output">
                                            <value name="TEXT">
                                              <shadow type="text"><field name="TEXT"/></shadow>
                                              <block type="variables_get">
                                                <field name="VAR" id="v04">利潤</field>
                                              </block>
                                            </value>
                                            <next>
                                              <block type="javascript_data_output">
                                                <value name="TEXT">
                                                  <shadow type="text"><field name="TEXT"/></shadow>
                                                  <block type="text">
                                                    <field name="TEXT">元</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </statement>
                                <statement name="ELSE">
                                  <block type="javascript_data_output">
                                    <value name="TEXT">
                                      <shadow type="text"><field name="TEXT"/></shadow>
                                      <block type="text">
                                        <field name="TEXT">無利潤</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="javascript_data_output">
                                        <value name="TEXT">
                                          <shadow type="text"><field name="TEXT"/></shadow>
                                          <block type="text">
                                            <field name="TEXT">賠</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="javascript_data_output">
                                            <value name="TEXT">
                                              <shadow type="text"><field name="TEXT"/></shadow>
                                              <block type="math_arithmetic">
                                                <field name="OP">MULTIPLY</field>
                                                <value name="A">
                                                  <block type="variables_get">
                                                    <field name="VAR" id="v04">利潤</field>
                                                  </block>
                                                </value>
                                                <value name="B">
                                                  <block type="math_number">
                                                    <field name="NUM">-1</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <next>
                                              <block type="javascript_data_output">
                                                <value name="TEXT">
                                                  <shadow type="text"><field name="TEXT"/></shadow>
                                                  <block type="text">
                                                    <field name="TEXT">元</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </statement>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml" platform="blockly">
  <variables>
    <variable id="v01">金額</variable>
    <variable id="l01">幣值</variable>
    <variable id="v02">k</variable>
  </variables>
  <block x="20" y="20" type="javascript_data_input_scratch">
    <value name="TEXT">
      <shadow type="text_noquotes">
        <field name="TEXT"/>
      </shadow>
    </value>
    <next>
      <block type="variables_set_local">
        <field name="VAR" id="v01">金額</field>
        <value name="VALUE">
          <block type="javascript_data_input_get_scratch"/>
        </value>
        <next>
          <block type="variables_set_local">
            <field name="VAR" id="l01">幣值</field>
            <value name="VALUE">
              <block type="lists_create_with">
                <mutation items="0"/>
              </block>
            </value>
            <next>
              <block type="lists_setIndex">
                <mutation at="false"/>
                <field name="MODE">INSERT</field>
                <field name="WHERE">LAST</field>
                <value name="LIST">
                  <block type="variables_get">
                    <field name="VAR" id="l01">幣值</field>
                  </block>
                </value>
                <value name="TO">
                  <block type="math_number">
                    <field name="NUM">50</field>
                  </block>
                </value>
                <next>
                  <block type="lists_setIndex">
                    <mutation at="false"/>
                    <field name="MODE">INSERT</field>
                    <field name="WHERE">LAST</field>
                    <value name="LIST">
                      <block type="variables_get">
                        <field name="VAR" id="l01">幣值</field>
                      </block>
                    </value>
                    <value name="TO">
                      <block type="math_number">
                        <field name="NUM">10</field>
                      </block>
                    </value>
                    <next>
                      <block type="lists_setIndex">
                        <mutation at="false"/>
                        <field name="MODE">INSERT</field>
                        <field name="WHERE">LAST</field>
                        <value name="LIST">
                          <block type="variables_get">
                            <field name="VAR" id="l01">幣值</field>
                          </block>
                        </value>
                        <value name="TO">
                          <block type="math_number">
                            <field name="NUM">5</field>
                          </block>
                        </value>
                        <next>
                          <block type="lists_setIndex">
                            <mutation at="false"/>
                            <field name="MODE">INSERT</field>
                            <field name="WHERE">LAST</field>
                            <value name="LIST">
                              <block type="variables_get">
                                <field name="VAR" id="l01">幣值</field>
                              </block>
                            </value>
                            <value name="TO">
                              <block type="math_number">
                                <field name="NUM">1</field>
                              </block>
                            </value>
                            <next>
                              <block type="controls_for">
                                <field name="VAR" id="v02">k</field>
                                <value name="FROM">
                                  <block type="math_number">
                                    <field name="NUM">1</field>
                                  </block>
                                </value>
                                <value name="TO">
                                  <block type="math_number">
                                    <field name="NUM">4</field>
                                  </block>
                                </value>
                                <value name="BY">
                                  <block type="math_number">
                                    <field name="NUM">1</field>
                                  </block>
                                </value>
                                <statement name="DO">
                                  <block type="javascript_data_output">
                                    <value name="TEXT">
                                      <shadow type="text"><field name="TEXT"/></shadow>
                                      <block type="math_round">
                                        <field name="OP">ROUNDDOWN</field>
                                        <value name="NUM">
                                          <block type="math_arithmetic">
                                            <field name="OP">DIVIDE</field>
                                            <value name="A">
                                              <block type="variables_get">
                                                <field name="VAR" id="v01">金額</field>
                                              </block>
                                            </value>
                                            <value name="B">
                                              <block type="lists_getIndex">
                                                <mutation statement="false" at="true"/>
                                                <field name="MODE">GET</field>
                                                <field name="WHERE">FROM_START</field>
                                                <value name="VALUE">
                                                  <block type="variables_get">
                                                    <field name="VAR" id="l01">幣值</field>
                                                  </block>
                                                </value>
                                                <value name="AT">
                                                  <block type="variables_get">
                                                    <field name="VAR" id="v02">k</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="variables_set_local">
                                        <field name="VAR" id="v01">金額</field>
                                        <value name="VALUE">
                                          <block type="math_modulo">
                                            <value name="DIVIDEND">
                                              <block type="variables_get">
                                                <field name="VAR" id="v01">金額</field>
                                              </block>
                                            </value>
                                            <value name="DIVISOR">
                                              <block type="lists_getIndex">
                                                <mutation statement="false" at="true"/>
                                                <field name="MODE">GET</field>
                                                <field name="WHERE">FROM_START</field>
                                                <value name="VALUE">
                                                  <block type="variables_get">
                                                    <field name="VAR" id="l01">幣值</field>
                                                  </block>
                                                </value>
                                                <value name="AT">
                                                  <block type="variables_get">
                                                    <field name="VAR" id="v02">k</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </statement>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

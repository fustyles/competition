<xml xmlns="https://developers.google.com/blockly/xml" platform="blockly">
  <variables>
    <variable id="v01">N</variable>
    <variable id="v02">總金額</variable>
    <variable id="v03">身高</variable>
    <variable id="v04">年齡</variable>
    <variable id="v05">縣民卡</variable>
  </variables>
  <block x="20" y="20" type="javascript_data_input_scratch">
    <value name="TEXT">
      <shadow type="text_noquotes">
        <field name="TEXT"/>
      </shadow>
    </value>
    <next>
      <block type="variables_set_local">
        <field name="VAR" id="v01">N</field>
        <value name="VALUE">
          <block type="javascript_data_input_get_scratch"/>
        </value>
        <next>
          <block type="variables_set_local">
            <field name="VAR" id="v02">總金額</field>
            <value name="VALUE">
              <block type="math_number">
                <field name="NUM">0</field>
              </block>
            </value>
            <next>
              <block type="controls_repeat_ext">
                <value name="TIMES">
                  <block type="variables_get">
                    <field name="VAR" id="v01">N</field>
                  </block>
                </value>
                <statement name="DO">
                  <block type="javascript_data_input_scratch">
                    <value name="TEXT">
                      <shadow type="text_noquotes">
                        <field name="TEXT"/>
                      </shadow>
                    </value>
                    <next>
                      <block type="variables_set_local">
                        <field name="VAR" id="v03">身高</field>
                        <value name="VALUE">
                          <block type="javascript_data_input_get_scratch"/>
                        </value>
                        <next>
                          <block type="javascript_data_input_scratch">
                            <value name="TEXT">
                              <shadow type="text_noquotes">
                                <field name="TEXT"/>
                              </shadow>
                            </value>
                            <next>
                              <block type="variables_set_local">
                                <field name="VAR" id="v04">年齡</field>
                                <value name="VALUE">
                                  <block type="javascript_data_input_get_scratch"/>
                                </value>
                                <next>
                                  <block type="javascript_data_input_scratch">
                                    <value name="TEXT">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT"/>
                                      </shadow>
                                    </value>
                                    <next>
                                      <block type="variables_set_local">
                                        <field name="VAR" id="v05">縣民卡</field>
                                        <value name="VALUE">
                                          <block type="javascript_data_input_get_scratch"/>
                                        </value>
                                        <next>
                                          <block type="controls_if">
                                            <mutation elseif="2" else="1"/>
                                            <value name="IF0">
                                              <block type="logic_compare">
                                                <field name="OP">EQ</field>
                                                <value name="A">
                                                  <block type="variables_get">
                                                    <field name="VAR" id="v05">縣民卡</field>
                                                  </block>
                                                </value>
                                                <value name="B">
                                                  <block type="math_number">
                                                    <field name="NUM">1</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <statement name="DO0">
                                              <block type="variables_set_local">
                                                <field name="VAR" id="v02">總金額</field>
                                                <value name="VALUE">
                                                  <block type="math_arithmetic">
                                                    <field name="OP">ADD</field>
                                                    <value name="A">
                                                      <block type="variables_get">
                                                        <field name="VAR" id="v02">總金額</field>
                                                      </block>
                                                    </value>
                                                    <value name="B">
                                                      <block type="math_number">
                                                        <field name="NUM">0</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                              </block>
                                            </statement>
                                            <value name="IF1">
                                              <block type="logic_compare">
                                                <field name="OP">GTE</field>
                                                <value name="A">
                                                  <block type="variables_get">
                                                    <field name="VAR" id="v04">年齡</field>
                                                  </block>
                                                </value>
                                                <value name="B">
                                                  <block type="math_number">
                                                    <field name="NUM">65</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <statement name="DO1">
                                              <block type="variables_set_local">
                                                <field name="VAR" id="v02">總金額</field>
                                                <value name="VALUE">
                                                  <block type="math_arithmetic">
                                                    <field name="OP">ADD</field>
                                                    <value name="A">
                                                      <block type="variables_get">
                                                        <field name="VAR" id="v02">總金額</field>
                                                      </block>
                                                    </value>
                                                    <value name="B">
                                                      <block type="math_number">
                                                        <field name="NUM">150</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                              </block>
                                            </statement>
                                            <value name="IF2">
                                              <block type="logic_operation">
                                                <field name="OP">OR</field>
                                                <value name="A">
                                                  <block type="logic_compare">
                                                    <field name="OP">LT</field>
                                                    <value name="A">
                                                      <block type="variables_get">
                                                        <field name="VAR" id="v03">身高</field>
                                                      </block>
                                                    </value>
                                                    <value name="B">
                                                      <block type="math_number">
                                                        <field name="NUM">120</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                                <value name="B">
                                                  <block type="logic_compare">
                                                    <field name="OP">LT</field>
                                                    <value name="A">
                                                      <block type="variables_get">
                                                        <field name="VAR" id="v04">年齡</field>
                                                      </block>
                                                    </value>
                                                    <value name="B">
                                                      <block type="math_number">
                                                        <field name="NUM">6</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <statement name="DO2">
                                              <block type="variables_set_local">
                                                <field name="VAR" id="v02">總金額</field>
                                                <value name="VALUE">
                                                  <block type="math_arithmetic">
                                                    <field name="OP">ADD</field>
                                                    <value name="A">
                                                      <block type="variables_get">
                                                        <field name="VAR" id="v02">總金額</field>
                                                      </block>
                                                    </value>
                                                    <value name="B">
                                                      <block type="math_number">
                                                        <field name="NUM">180</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                              </block>
                                            </statement>
                                            <statement name="ELSE">
                                              <block type="variables_set_local">
                                                <field name="VAR" id="v02">總金額</field>
                                                <value name="VALUE">
                                                  <block type="math_arithmetic">
                                                    <field name="OP">ADD</field>
                                                    <value name="A">
                                                      <block type="variables_get">
                                                        <field name="VAR" id="v02">總金額</field>
                                                      </block>
                                                    </value>
                                                    <value name="B">
                                                      <block type="math_number">
                                                        <field name="NUM">300</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                              </block>
                                            </statement>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </statement>
                <next>
                  <block type="javascript_data_output">
                    <value name="TEXT">
                      <shadow type="text"><field name="TEXT"/></shadow>
                      <block type="variables_get">
                        <field name="VAR" id="v02">總金額</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml" platform="scratch">
  <variables>
    <variable type="other" id="v01">金額</variable>
    <variable type="Array" id="l01">幣值</variable>
    <variable type="other" id="v02">k</variable>
  </variables>
  <block type="javascript_start_scratch" x="20" y="20">
    <next>
      <block type="javascript_data_input_scratch">
        <value name="TEXT">
          <shadow type="text_noquotes">
            <field name="TEXT"/>
          </shadow>
        </value>
        <next>
          <block type="variables_set_other">
            <field name="VAR" id="v01" variabletype="other">金額</field>
            <value name="VALUE">
              <shadow type="text_noquotes">
                <field name="TEXT">0</field>
              </shadow>
              <block type="javascript_data_input_get_scratch"/>
            </value>
            <next>
              <block type="list_deletealloflist_scratch">
                <field name="VAR" id="l01" variabletype="Array">幣值</field>
                <next>
                  <block type="list_addtolist_scratch">
                    <value name="ITEM">
                      <shadow type="text_noquotes">
                        <field name="TEXT">50</field>
                      </shadow>
                    </value>
                    <field name="VAR" id="l01" variabletype="Array">幣值</field>
                    <next>
                      <block type="list_addtolist_scratch">
                        <value name="ITEM">
                          <shadow type="text_noquotes">
                            <field name="TEXT">10</field>
                          </shadow>
                        </value>
                        <field name="VAR" id="l01" variabletype="Array">幣值</field>
                        <next>
                          <block type="list_addtolist_scratch">
                            <value name="ITEM">
                              <shadow type="text_noquotes">
                                <field name="TEXT">5</field>
                              </shadow>
                            </value>
                            <field name="VAR" id="l01" variabletype="Array">幣值</field>
                            <next>
                              <block type="list_addtolist_scratch">
                                <value name="ITEM">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">1</field>
                                  </shadow>
                                </value>
                                <field name="VAR" id="l01" variabletype="Array">幣值</field>
                                <next>
                                  <block type="variables_set_other">
                                    <field name="VAR" id="v02" variabletype="other">k</field>
                                    <value name="VALUE">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">1</field>
                                      </shadow>
                                    </value>
                                    <next>
                                      <block type="controls_whileUntil_scratch">
                                        <field name="MODE">UNTIL</field>
                                        <value name="BOOL">
                                          <block type="logic_compare">
                                            <field name="OP">GT</field>
                                            <value name="A">
                                              <shadow type="text_noquotes">
                                                <field name="TEXT">0</field>
                                              </shadow>
                                              <block type="variables_get_other">
                                                <field name="VAR" id="v02" variabletype="other">k</field>
                                              </block>
                                            </value>
                                            <value name="B">
                                              <shadow type="text_noquotes">
                                                <field name="TEXT">4</field>
                                              </shadow>
                                            </value>
                                          </block>
                                        </value>
                                        <statement name="DO">
                                          <block type="javascript_data_output_scratch">
                                            <value name="TEXT">
                                              <shadow type="text_noquotes">
                                                <field name="TEXT"/>
                                              </shadow>
                                              <block type="math_round">
                                                <field name="OP">ROUNDDOWN</field>
                                                <value name="NUM">
                                                  <shadow type="math_number">
                                                    <field name="NUM">3.1</field>
                                                  </shadow>
                                                  <block type="math_arithmetic">
                                                    <field name="OP">DIVIDE</field>
                                                    <value name="A">
                                                      <shadow type="math_number">
                                                        <field name="NUM">0</field>
                                                      </shadow>
                                                      <block type="variables_get_other">
                                                        <field name="VAR" id="v01" variabletype="other">金額</field>
                                                      </block>
                                                    </value>
                                                    <value name="B">
                                                      <shadow type="math_number">
                                                        <field name="NUM">0</field>
                                                      </shadow>
                                                      <block type="list_itemoflist_scratch">
                                                        <field name="VAR" id="l01" variabletype="Array">幣值</field>
                                                        <value name="INDEX">
                                                          <shadow type="math_number">
                                                            <field name="NUM">1</field>
                                                          </shadow>
                                                          <block type="variables_get_other">
                                                            <field name="VAR" id="v02" variabletype="other">k</field>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <next>
                                              <block type="variables_set_other">
                                                <field name="VAR" id="v01" variabletype="other">金額</field>
                                                <value name="VALUE">
                                                  <shadow type="text_noquotes">
                                                    <field name="TEXT">0</field>
                                                  </shadow>
                                                  <block type="math_modulo">
                                                    <value name="DIVIDEND">
                                                      <shadow type="math_number">
                                                        <field name="NUM">64</field>
                                                      </shadow>
                                                      <block type="variables_get_other">
                                                        <field name="VAR" id="v01" variabletype="other">金額</field>
                                                      </block>
                                                    </value>
                                                    <value name="DIVISOR">
                                                      <shadow type="math_number">
                                                        <field name="NUM">10</field>
                                                      </shadow>
                                                      <block type="list_itemoflist_scratch">
                                                        <field name="VAR" id="l01" variabletype="Array">幣值</field>
                                                        <value name="INDEX">
                                                          <shadow type="math_number">
                                                            <field name="NUM">1</field>
                                                          </shadow>
                                                          <block type="variables_get_other">
                                                            <field name="VAR" id="v02" variabletype="other">k</field>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                                <next>
                                                  <block type="math_change_other">
                                                    <field name="VAR" id="v02" variabletype="other">k</field>
                                                    <value name="DELTA">
                                                      <shadow type="math_number">
                                                        <field name="NUM">1</field>
                                                      </shadow>
                                                    </value>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </statement>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

                                        <field name="OP">MULTIPLY</field>
                                        <value name="A">
                                          <block type="math_number">
                                            <field name="NUM">9.6</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="variables_get">
                                            <field name="VAR" id="v02">體重</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="math_arithmetic">
                                    <field name="OP">MULTIPLY</field>
                                    <value name="A">
                                      <block type="math_number">
                                        <field name="NUM">1.8</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="variables_get">
                                        <field name="VAR" id="v01">身高</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_arithmetic">
                                <field name="OP">MULTIPLY</field>
                                <value name="A">
                                  <block type="math_number">
                                    <field name="NUM">4.7</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="math_number">
                                    <field name="NUM">14</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                    <next>
                      <block type="javascript_data_output">
                        <value name="TEXT">
                          <shadow type="text"><field name="TEXT"/></shadow>
                          <block type="variables_get">
                            <field name="VAR" id="v03">BMR</field>
                          </block>
                        </value>
                        <next>
                          <block type="controls_if">
                            <mutation elseif="3" else="1"/>
                            <value name="IF0">
                              <block type="logic_compare">
                                <field name="OP">LT</field>
                                <value name="A">
                                  <block type="variables_get">
                                    <field name="VAR" id="v03">BMR</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="math_number">
                                    <field name="NUM">1200</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO0">
                              <block type="javascript_data_output">
                                <value name="TEXT">
                                  <shadow type="text"><field name="TEXT"/></shadow>
                                  <block type="text">
                                    <field name="TEXT">極低能量</field>
                                  </block>
                                </value>
                              </block>
                            </statement>
                            <value name="IF1">
                              <block type="logic_compare">
                                <field name="OP">LT</field>
                                <value name="A">
                                  <block type="variables_get">
                                    <field name="VAR" id="v03">BMR</field>

                                <field name="OP">LT</field>
                                <value name="A">
                                  <block type="variables_get">
                                    <field name="VAR" id="v03">BMR</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="math_number">
                                    <field name="NUM">1800</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO2">
                              <block type="javascript_data_output">

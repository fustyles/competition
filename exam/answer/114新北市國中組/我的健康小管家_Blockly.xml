                                <value name="A">
                                  <block type="variables_get">
                                    <field name="VAR" id="v03">BMR</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="math_number">
                                    <field name="NUM">2100</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO3">
                              <block type="javascript_data_output">
                                <value name="TEXT">
                                  <shadow type="text"><field name="TEXT"/></shadow>
                                  <block type="text">
                                    <field name="TEXT">較高能量</field>
                                  </block>
                                </value>
                              </block>
                            </statement>
                            <statement name="ELSE">
                              <block type="javascript_data_output">
                                <value name="TEXT">
                                  <shadow type="text"><field name="TEXT"/></shadow>
                                  <block type="text">
                                    <field name="TEXT">極高能量</field>
                                  </block>
                                </value>

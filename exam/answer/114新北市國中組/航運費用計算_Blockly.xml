<xml xmlns="https://developers.google.com/blockly/xml" platform="blockly">
  <variables>
    <variable id="v01">起點</variable>
    <variable id="v02">終點</variable>
    <variable id="v03">船隻重量</variable>
    <variable id="v04">費用</variable>
  </variables>
  <block x="20" y="20" type="javascript_data_input_scratch">
    <value name="TEXT">
      <shadow type="text_noquotes">
        <field name="TEXT"/>
      </shadow>
    </value>
    <next>
      <block type="variables_set_local">
        <field name="VAR" id="v01">起點</field>
        <value name="VALUE">
          <block type="javascript_data_input_get_scratch"/>
        </value>
        <next>
          <block type="javascript_data_input_scratch">
            <value name="TEXT">
              <shadow type="text_noquotes">
                <field name="TEXT"/>
              </shadow>
            </value>
            <next>
              <block type="variables_set_local">
                <field name="VAR" id="v02">終點</field>
                <value name="VALUE">
                  <block type="javascript_data_input_get_scratch"/>
                </value>
                <next>
                  <block type="javascript_data_input_scratch">
                    <value name="TEXT">
                      <shadow type="text_noquotes">
                        <field name="TEXT"/>
                      </shadow>
                    </value>
                    <next>
                      <block type="variables_set_local">
                        <field name="VAR" id="v03">船隻重量</field>
                        <value name="VALUE">
                          <block type="javascript_data_input_get_scratch"/>
                        </value>
                        <next>
                          <block type="controls_if">
                            <mutation elseif="0" else="1"/>
                            <value name="IF0">
                              <block type="logic_operation">
                                <field name="OP">OR</field>
                                <value name="A">
                                  <block type="logic_operation">
                                    <field name="OP">AND</field>
                                    <value name="A">
                                      <block type="logic_compare">
                                        <field name="OP">LT</field>
                                        <value name="A">
                                          <block type="variables_get">
                                            <field name="VAR" id="v01">起點</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="math_number">
                                            <field name="NUM">10</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="logic_compare">
                                        <field name="OP">GT</field>
                                        <value name="A">
                                          <block type="variables_get">
                                            <field name="VAR" id="v02">終點</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="math_number">
                                            <field name="NUM">10</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="logic_operation">
                                    <field name="OP">AND</field>
                                    <value name="A">
                                      <block type="logic_compare">
                                        <field name="OP">GT</field>
                                        <value name="A">
                                          <block type="variables_get">
                                            <field name="VAR" id="v01">起點</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="math_number">
                                            <field name="NUM">10</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="logic_compare">
                                        <field name="OP">LT</field>
                                        <value name="A">
                                          <block type="variables_get">
                                            <field name="VAR" id="v02">終點</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="math_number">
                                            <field name="NUM">10</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO0">
                              <block type="variables_set_local">
                                <field name="VAR" id="v04">費用</field>
                                <value name="VALUE">
                                  <block type="math_number">
                                    <field name="NUM">20</field>
                                  </block>
                                </value>
                              </block>
                            </statement>
                            <statement name="ELSE">
                              <block type="variables_set_local">
                                <field name="VAR" id="v04">費用</field>
                                <value name="VALUE">
                                  <block type="math_number">
                                    <field name="NUM">10</field>
                                  </block>
                                </value>
                              </block>
                            </statement>
                            <next>
                              <block type="controls_if">
                                <value name="IF0">
                                  <block type="logic_compare">
                                    <field name="OP">LT</field>
                                    <value name="A">
                                      <block type="variables_get">
                                        <field name="VAR" id="v03">船隻重量</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="math_number">
                                        <field name="NUM">12</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="DO0">
                                  <block type="variables_set_local">
                                    <field name="VAR" id="v04">費用</field>
                                    <value name="VALUE">
                                      <block type="math_arithmetic">
                                        <field name="OP">DIVIDE</field>
                                        <value name="A">
                                          <block type="variables_get">
                                            <field name="VAR" id="v04">費用</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="math_number">
                                            <field name="NUM">2</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                  </block>
                                </statement>
                                <next>
                                  <block type="javascript_data_output">
                                    <value name="TEXT">
                                      <shadow type="text"><field name="TEXT"/></shadow>
                                      <block type="variables_get">
                                        <field name="VAR" id="v04">費用</field>
                                      </block>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

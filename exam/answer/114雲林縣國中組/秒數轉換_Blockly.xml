<xml xmlns="https://developers.google.com/blockly/xml" platform="blockly">
  <variables>
    <variable id="v01">總秒數</variable>
    <variable id="v02">分</variable>
    <variable id="v03">秒</variable>
  </variables>
  <block x="20" y="20" type="javascript_data_input_scratch">
    <value name="TEXT">
      <shadow type="text_noquotes">
        <field name="TEXT"/>
      </shadow>
    </value>
    <next>
      <block type="variables_set_local">
        <field name="VAR" id="v01">總秒數</field>
        <value name="VALUE">
          <block type="javascript_data_input_get_scratch"/>
        </value>
        <next>
          <block type="variables_set_local">
            <field name="VAR" id="v02">分</field>
            <value name="VALUE">
              <block type="math_round">
                <field name="OP">ROUNDDOWN</field>
                <value name="NUM">
                  <block type="math_arithmetic">
                    <field name="OP">DIVIDE</field>
                    <value name="A">
                      <block type="variables_get">
                        <field name="VAR" id="v01">總秒數</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number">
                        <field name="NUM">60</field>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="variables_set_local">
                <field name="VAR" id="v03">秒</field>
                <value name="VALUE">
                  <block type="math_modulo">
                    <value name="DIVIDEND">
                      <block type="variables_get">
                        <field name="VAR" id="v01">總秒數</field>
                      </block>
                    </value>
                    <value name="DIVISOR">
                      <block type="math_number">
                        <field name="NUM">60</field>
                      </block>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="javascript_data_output">
                    <value name="TEXT">
                      <shadow type="text"><field name="TEXT"/></shadow>
                      <block type="variables_get">
                        <field name="VAR" id="v02">分</field>
                      </block>
                    </value>
                    <next>
                      <block type="javascript_data_output">
                        <value name="TEXT">
                          <shadow type="text"><field name="TEXT"/></shadow>
                          <block type="text">
                            <field name="TEXT">分</field>
                          </block>
                        </value>
                        <next>
                          <block type="javascript_data_output">
                            <value name="TEXT">
                              <shadow type="text"><field name="TEXT"/></shadow>
                              <block type="variables_get">
                                <field name="VAR" id="v03">秒</field>
                              </block>
                            </value>
                            <next>
                              <block type="javascript_data_output">
                                <value name="TEXT">
                                  <shadow type="text"><field name="TEXT"/></shadow>
                                  <block type="text">
                                    <field name="TEXT">秒</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml" platform="blockly">
  <variables>
    <variable id="v01">A</variable>
    <variable id="v02">B</variable>
    <variable id="v03">甲</variable>
    <variable id="v04">乙</variable>
    <variable id="v05">餘數</variable>
  </variables>
  <block x="20" y="20" type="javascript_data_input_scratch">
    <value name="TEXT">
      <shadow type="text_noquotes">
        <field name="TEXT"/>
      </shadow>
    </value>
    <next>
      <block type="variables_set_local">
        <field name="VAR" id="v01">A</field>
        <value name="VALUE">
          <block type="javascript_data_input_get_scratch"/>
        </value>
        <next>
          <block type="javascript_data_input_scratch">
            <value name="TEXT">
              <shadow type="text_noquotes">
                <field name="TEXT"/>
              </shadow>
            </value>
            <next>
              <block type="variables_set_local">
                <field name="VAR" id="v02">B</field>
                <value name="VALUE">
                  <block type="javascript_data_input_get_scratch"/>
                </value>
                <next>
                  <block type="variables_set_local">
                    <field name="VAR" id="v03">甲</field>
                    <value name="VALUE">
                      <block type="variables_get">
                        <field name="VAR" id="v01">A</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set_local">
                        <field name="VAR" id="v04">乙</field>
                        <value name="VALUE">
                          <block type="variables_get">
                            <field name="VAR" id="v02">B</field>
                          </block>
                        </value>
                        <next>
                          <block type="controls_whileUntil">
                            <field name="MODE">UNTIL</field>
                            <value name="BOOL">
                              <block type="logic_compare">
                                <field name="OP">EQ</field>
                                <value name="A">
                                  <block type="variables_get">
                                    <field name="VAR" id="v04">乙</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="math_number">
                                    <field name="NUM">0</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO">
                              <block type="variables_set_local">
                                <field name="VAR" id="v05">餘數</field>
                                <value name="VALUE">
                                  <block type="math_modulo">
                                    <value name="DIVIDEND">
                                      <block type="variables_get">
                                        <field name="VAR" id="v03">甲</field>
                                      </block>
                                    </value>
                                    <value name="DIVISOR">
                                      <block type="variables_get">
                                        <field name="VAR" id="v04">乙</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <next>
                                  <block type="variables_set_local">
                                    <field name="VAR" id="v03">甲</field>
                                    <value name="VALUE">
                                      <block type="variables_get">
                                        <field name="VAR" id="v04">乙</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="variables_set_local">
                                        <field name="VAR" id="v04">乙</field>
                                        <value name="VALUE">
                                          <block type="variables_get">
                                            <field name="VAR" id="v05">餘數</field>
                                          </block>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </statement>
                            <next>
                              <block type="javascript_data_output">
                                <value name="TEXT">
                                  <shadow type="text"><field name="TEXT"/></shadow>
                                  <block type="variables_get">
                                    <field name="VAR" id="v03">甲</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

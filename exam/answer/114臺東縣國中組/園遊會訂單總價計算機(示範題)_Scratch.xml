<xml xmlns="https://developers.google.com/blockly/xml" platform="scratch">
  <variables>
    <variable type="Array" id="l01">價格</variable>
    <variable type="other" id="v01">總價</variable>
    <variable type="other" id="v02">編號</variable>
  </variables>
  <block type="javascript_start_scratch" x="20" y="20">
    <next>
      <block type="list_deletealloflist_scratch">
        <field name="VAR" id="l01" variabletype="Array">價格</field>
        <next>
          <block type="list_addtolist_scratch">
            <value name="ITEM">
              <shadow type="text_noquotes">
                <field name="TEXT">45</field>
              </shadow>
            </value>
            <field name="VAR" id="l01" variabletype="Array">價格</field>
            <next>
              <block type="list_addtolist_scratch">
                <value name="ITEM">
                  <shadow type="text_noquotes">
                    <field name="TEXT">25</field>
                  </shadow>
                </value>
                <field name="VAR" id="l01" variabletype="Array">價格</field>
                <next>
                  <block type="list_addtolist_scratch">
                    <value name="ITEM">
                      <shadow type="text_noquotes">
                        <field name="TEXT">30</field>
                      </shadow>
                    </value>
                    <field name="VAR" id="l01" variabletype="Array">價格</field>
                    <next>
                      <block type="list_addtolist_scratch">
                        <value name="ITEM">
                          <shadow type="text_noquotes">
                            <field name="TEXT">40</field>
                          </shadow>
                        </value>
                        <field name="VAR" id="l01" variabletype="Array">價格</field>
                        <next>
                          <block type="list_addtolist_scratch">
                            <value name="ITEM">
                              <shadow type="text_noquotes">
                                <field name="TEXT">60</field>
                              </shadow>
                            </value>
                            <field name="VAR" id="l01" variabletype="Array">價格</field>
                            <next>
                              <block type="variables_set_other">
                                <field name="VAR" id="v01" variabletype="other">總價</field>
                                <value name="VALUE">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">0</field>
                                  </shadow>
                                </value>
                                <next>
                                  <block type="javascript_data_input_scratch">
                                    <value name="TEXT">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT"/>
                                      </shadow>
                                    </value>
                                    <next>
                                      <block type="variables_set_other">
                                        <field name="VAR" id="v02" variabletype="other">編號</field>
                                        <value name="VALUE">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT">0</field>
                                          </shadow>
                                          <block type="javascript_data_input_get_scratch"/>
                                        </value>
                                        <next>
                                          <block type="controls_whileUntil_scratch">
                                            <field name="MODE">WHILE</field>
                                            <value name="BOOL">
                                              <block type="logic_compare">
                                                <field name="OP">NEQ</field>
                                                <value name="A">
                                                  <shadow type="text_noquotes">
                                                    <field name="TEXT">0</field>
                                                  </shadow>
                                                  <block type="variables_get_other">
                                                    <field name="VAR" id="v02" variabletype="other">編號</field>
                                                  </block>
                                                </value>
                                                <value name="B">
                                                  <shadow type="text_noquotes">
                                                    <field name="TEXT">-1</field>
                                                  </shadow>
                                                </value>
                                              </block>
                                            </value>
                                            <statement name="DO">
                                              <block type="math_change_other">
                                                <field name="VAR" id="v01" variabletype="other">總價</field>
                                                <value name="DELTA">
                                                  <shadow type="math_number">
                                                    <field name="NUM">1</field>
                                                  </shadow>
                                                  <block type="list_itemoflist_scratch">
                                                    <field name="VAR" id="l01" variabletype="Array">價格</field>
                                                    <value name="INDEX">
                                                      <shadow type="math_number">
                                                        <field name="NUM">1</field>
                                                      </shadow>
                                                      <block type="variables_get_other">
                                                        <field name="VAR" id="v02" variabletype="other">編號</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                                <next>
                                                  <block type="javascript_data_input_scratch">
                                                    <value name="TEXT">
                                                      <shadow type="text_noquotes">
                                                        <field name="TEXT"/>
                                                      </shadow>
                                                    </value>
                                                    <next>
                                                      <block type="variables_set_other">
                                                        <field name="VAR" id="v02" variabletype="other">編號</field>
                                                        <value name="VALUE">
                                                          <shadow type="text_noquotes">
                                                            <field name="TEXT">0</field>
                                                          </shadow>
                                                          <block type="javascript_data_input_get_scratch"/>
                                                        </value>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </next>
                                              </block>
                                            </statement>
                                            <next>
                                              <block type="javascript_data_output_scratch">
                                                <value name="TEXT">
                                                  <shadow type="text_noquotes">
                                                    <field name="TEXT"/>
                                                  </shadow>
                                                  <block type="variables_get_other">
                                                    <field name="VAR" id="v01" variabletype="other">總價</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

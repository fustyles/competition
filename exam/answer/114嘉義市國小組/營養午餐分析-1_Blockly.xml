<xml xmlns="https://developers.google.com/blockly/xml" platform="blockly">
  <variables>
    <variable id="v01">結果</variable>
    <variable id="v02">主菜</variable>
  </variables>
  <block x="20" y="20" type="controls_repeat_ext">
    <value name="TIMES">
      <block type="math_number">
        <field name="NUM">2</field>
      </block>
    </value>
    <statement name="DO">
      <block type="variables_set_local">
        <field name="VAR" id="v01">結果</field>
        <value name="VALUE">
          <block type="text">
            <field name="TEXT">N</field>
          </block>
        </value>
        <next>
          <block type="controls_repeat_ext">
            <value name="TIMES">
              <block type="math_number">
                <field name="NUM">5</field>
              </block>
            </value>
            <statement name="DO">
              <block type="javascript_data_input_scratch">
                <value name="TEXT">
                  <shadow type="text_noquotes">
                    <field name="TEXT"/>
                  </shadow>
                </value>
                <next>
                  <block type="variables_set_local">
                    <field name="VAR" id="v02">主菜</field>
                    <value name="VALUE">
                      <block type="javascript_data_input_get_scratch"/>
                    </value>
                    <next>
                      <block type="controls_if">
                        <value name="IF0">
                          <block type="logic_compare">
                            <field name="OP">EQ</field>
                            <value name="A">
                              <block type="variables_get">
                                <field name="VAR" id="v02">主菜</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="text">
                                <field name="TEXT">C</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="variables_set_local">
                            <field name="VAR" id="v01">結果</field>
                            <value name="VALUE">
                              <block type="text">
                                <field name="TEXT">Y</field>
                              </block>
                            </value>
                          </block>
                        </statement>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </statement>
            <next>
              <block type="javascript_data_output">
                <value name="TEXT">
                  <shadow type="text"><field name="TEXT"/></shadow>
                  <block type="variables_get">
                    <field name="VAR" id="v01">結果</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>

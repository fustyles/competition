<xml xmlns="https://developers.google.com/blockly/xml" platform="scratch">
  <variables>
    <variable type="other" id="v01">結果</variable>
    <variable type="other" id="v02">主菜</variable>
  </variables>
  <block type="javascript_start_scratch" x="20" y="20">
    <next>
      <block type="controls_repeat_ext_scratch">
        <value name="TIMES">
          <shadow type="math_number">
            <field name="NUM">2</field>
          </shadow>
        </value>
        <statement name="DO">
          <block type="variables_set_other">
            <field name="VAR" id="v01" variabletype="other">結果</field>
            <value name="VALUE">
              <shadow type="text_noquotes">
                <field name="TEXT">N</field>
              </shadow>
            </value>
            <next>
              <block type="controls_repeat_ext_scratch">
                <value name="TIMES">
                  <shadow type="math_number">
                    <field name="NUM">5</field>
                  </shadow>
                </value>
                <statement name="DO">
                  <block type="javascript_data_input_scratch">
                    <value name="TEXT">
                      <shadow type="text_noquotes">
                        <field name="TEXT"/>
                      </shadow>
                    </value>
                    <next>
                      <block type="variables_set_other">
                        <field name="VAR" id="v02" variabletype="other">主菜</field>
                        <value name="VALUE">
                          <shadow type="text_noquotes">
                            <field name="TEXT">0</field>
                          </shadow>
                          <block type="javascript_data_input_get_scratch"/>
                        </value>
                        <next>
                          <block type="controls_if_1_scratch">
                            <value name="condition">
                              <block type="logic_compare">
                                <field name="OP">EQ</field>
                                <value name="A">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">0</field>
                                  </shadow>
                                  <block type="variables_get_other">
                                    <field name="VAR" id="v02" variabletype="other">主菜</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">C</field>
                                  </shadow>
                                </value>
                              </block>
                            </value>
                            <statement name="statement_if">
                              <block type="variables_set_other">
                                <field name="VAR" id="v01" variabletype="other">結果</field>
                                <value name="VALUE">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">Y</field>
                                  </shadow>
                                </value>
                              </block>
                            </statement>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </statement>
                <next>
                  <block type="javascript_data_output_scratch">
                    <value name="TEXT">
                      <shadow type="text_noquotes">
                        <field name="TEXT"/>
                      </shadow>
                      <block type="variables_get_other">
                        <field name="VAR" id="v01" variabletype="other">結果</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>

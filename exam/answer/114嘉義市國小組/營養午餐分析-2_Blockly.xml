<xml xmlns="https://developers.google.com/blockly/xml" platform="blockly">
  <variables>
    <variable id="v01">A數</variable>
    <variable id="v02">B數</variable>
    <variable id="v03">C數</variable>
    <variable id="v04">主菜</variable>
  </variables>
  <block x="20" y="20" type="controls_repeat_ext">
    <value name="TIMES">
      <block type="math_number">
        <field name="NUM">2</field>
      </block>
    </value>
    <statement name="DO">
      <block type="variables_set_local">
        <field name="VAR" id="v01">A數</field>
        <value name="VALUE">
          <block type="math_number">
            <field name="NUM">0</field>
          </block>
        </value>
        <next>
          <block type="variables_set_local">
            <field name="VAR" id="v02">B數</field>
            <value name="VALUE">
              <block type="math_number">
                <field name="NUM">0</field>
              </block>
            </value>
            <next>
              <block type="variables_set_local">
                <field name="VAR" id="v03">C數</field>
                <value name="VALUE">
                  <block type="math_number">
                    <field name="NUM">0</field>
                  </block>
                </value>
                <next>
                  <block type="controls_repeat_ext">
                    <value name="TIMES">
                      <block type="math_number">
                        <field name="NUM">5</field>
                      </block>
                    </value>
                    <statement name="DO">
                      <block type="javascript_data_input_scratch">
                        <value name="TEXT">
                          <shadow type="text_noquotes">
                            <field name="TEXT"/>
                          </shadow>
                        </value>
                        <next>
                          <block type="variables_set_local">
                            <field name="VAR" id="v04">主菜</field>
                            <value name="VALUE">
                              <block type="javascript_data_input_get_scratch"/>
                            </value>
                            <next>
                              <block type="controls_if">
                                <mutation elseif="2" else="0"/>
                                <value name="IF0">
                                  <block type="logic_compare">
                                    <field name="OP">EQ</field>
                                    <value name="A">
                                      <block type="variables_get">
                                        <field name="VAR" id="v04">主菜</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="text">
                                        <field name="TEXT">A</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="DO0">
                                  <block type="variables_set_local">
                                    <field name="VAR" id="v01">A數</field>
                                    <value name="VALUE">
                                      <block type="math_arithmetic">
                                        <field name="OP">ADD</field>
                                        <value name="A">
                                          <block type="variables_get">
                                            <field name="VAR" id="v01">A數</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="math_number">
                                            <field name="NUM">1</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                  </block>
                                </statement>
                                <value name="IF1">
                                  <block type="logic_compare">
                                    <field name="OP">EQ</field>
                                    <value name="A">
                                      <block type="variables_get">
                                        <field name="VAR" id="v04">主菜</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="text">
                                        <field name="TEXT">B</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="DO1">
                                  <block type="variables_set_local">
                                    <field name="VAR" id="v02">B數</field>
                                    <value name="VALUE">
                                      <block type="math_arithmetic">
                                        <field name="OP">ADD</field>
                                        <value name="A">
                                          <block type="variables_get">
                                            <field name="VAR" id="v02">B數</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="math_number">
                                            <field name="NUM">1</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                  </block>
                                </statement>
                                <value name="IF2">
                                  <block type="logic_compare">
                                    <field name="OP">EQ</field>
                                    <value name="A">
                                      <block type="variables_get">
                                        <field name="VAR" id="v04">主菜</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="text">
                                        <field name="TEXT">C</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="DO2">
                                  <block type="variables_set_local">
                                    <field name="VAR" id="v03">C數</field>
                                    <value name="VALUE">
                                      <block type="math_arithmetic">
                                        <field name="OP">ADD</field>
                                        <value name="A">
                                          <block type="variables_get">
                                            <field name="VAR" id="v03">C數</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="math_number">
                                            <field name="NUM">1</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                  </block>
                                </statement>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <block type="controls_if">
                        <mutation elseif="0" else="1"/>
                        <value name="IF0">
                          <block type="logic_compare">
                            <field name="OP">GT</field>
                            <value name="A">
                              <block type="variables_get">
                                <field name="VAR" id="v02">B數</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_arithmetic">
                                <field name="OP">ADD</field>
                                <value name="A">
                                  <block type="variables_get">
                                    <field name="VAR" id="v01">A數</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="variables_get">
                                    <field name="VAR" id="v03">C數</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="javascript_data_output">
                            <value name="TEXT">
                              <shadow type="text"><field name="TEXT"/></shadow>
                              <block type="text">
                                <field name="TEXT">Y</field>
                              </block>
                            </value>
                          </block>
                        </statement>
                        <statement name="ELSE">
                          <block type="javascript_data_output">
                            <value name="TEXT">
                              <shadow type="text"><field name="TEXT"/></shadow>
                              <block type="text">
                                <field name="TEXT">N</field>
                              </block>
                            </value>
                          </block>
                        </statement>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>

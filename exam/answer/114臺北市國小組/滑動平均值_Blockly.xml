<xml xmlns="https://developers.google.com/blockly/xml" platform="blockly">
  <variables>
    <variable id="v01">數列</variable>
    <variable id="v02">K</variable>
    <variable id="l01">數字</variable>
    <variable id="v03">字串</variable>
    <variable id="v04">暫存</variable>
    <variable id="v05">i</variable>
    <variable id="v06">字</variable>
    <variable id="v07">s</variable>
    <variable id="v08">總和</variable>
    <variable id="v09">j</variable>
  </variables>
  <block x="20" y="20" type="javascript_data_input_scratch">
    <value name="TEXT">
      <shadow type="text_noquotes">
        <field name="TEXT"/>
      </shadow>
    </value>
    <next>
      <block type="variables_set_local">
        <field name="VAR" id="v01">數列</field>
        <value name="VALUE">
          <block type="javascript_data_input_get_scratch"/>
        </value>
        <next>
          <block type="javascript_data_input_scratch">
            <value name="TEXT">
              <shadow type="text_noquotes">
                <field name="TEXT"/>
              </shadow>
            </value>
            <next>
              <block type="variables_set_local">
                <field name="VAR" id="v02">K</field>
                <value name="VALUE">
                  <block type="javascript_data_input_get_scratch"/>
                </value>
                <next>
                  <block type="variables_set_local">
                    <field name="VAR" id="l01">數字</field>
                    <value name="VALUE">
                      <block type="lists_create_with">
                        <mutation items="0"/>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set_local">
                        <field name="VAR" id="v03">字串</field>
                        <value name="VALUE">
                          <block type="text_join">
                            <mutation items="2"/>
                            <value name="ADD0">
                              <block type="variables_get">
                                <field name="VAR" id="v01">數列</field>
                              </block>
                            </value>
                            <value name="ADD1">
                              <block type="text">
                                <field name="TEXT"> </field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set_local">
                            <field name="VAR" id="v04">暫存</field>
                            <value name="VALUE">
                              <block type="text">
                                <field name="TEXT"/>
                              </block>
                            </value>
                            <next>
                              <block type="controls_for">
                                <field name="VAR" id="v05">i</field>
                                <value name="FROM">
                                  <block type="math_number">
                                    <field name="NUM">1</field>
                                  </block>
                                </value>
                                <value name="TO">
                                  <block type="text_length">
                                    <value name="VALUE">
                                      <block type="variables_get">
                                        <field name="VAR" id="v03">字串</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <value name="BY">
                                  <block type="math_number">
                                    <field name="NUM">1</field>
                                  </block>
                                </value>
                                <statement name="DO">
                                  <block type="variables_set_local">
                                    <field name="VAR" id="v06">字</field>
                                    <value name="VALUE">
                                      <block type="text_charAt">
                                        <mutation at="true"/>
                                        <field name="WHERE">FROM_START</field>
                                        <value name="VALUE">
                                          <block type="variables_get">
                                            <field name="VAR" id="v03">字串</field>
                                          </block>
                                        </value>
                                        <value name="AT">
                                          <block type="variables_get">
                                            <field name="VAR" id="v05">i</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="controls_if">
                                        <mutation elseif="0" else="1"/>
                                        <value name="IF0">
                                          <block type="logic_compare">
                                            <field name="OP">EQ</field>
                                            <value name="A">
                                              <block type="variables_get">
                                                <field name="VAR" id="v06">字</field>
                                              </block>
                                            </value>
                                            <value name="B">
                                              <block type="text">
                                                <field name="TEXT"> </field>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                        <statement name="DO0">
                                          <block type="lists_setIndex">
                                            <mutation at="false"/>
                                            <field name="MODE">INSERT</field>
                                            <field name="WHERE">LAST</field>
                                            <value name="LIST">
                                              <block type="variables_get">
                                                <field name="VAR" id="l01">數字</field>
                                              </block>
                                            </value>
                                            <value name="TO">
                                              <block type="math_arithmetic">
                                                <field name="OP">MULTIPLY</field>
                                                <value name="A">
                                                  <block type="variables_get">
                                                    <field name="VAR" id="v04">暫存</field>
                                                  </block>
                                                </value>
                                                <value name="B">
                                                  <block type="math_number">
                                                    <field name="NUM">1</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <next>
                                              <block type="variables_set_local">
                                                <field name="VAR" id="v04">暫存</field>
                                                <value name="VALUE">
                                                  <block type="text">
                                                    <field name="TEXT"/>
                                                  </block>
                                                </value>
                                              </block>
                                            </next>
                                          </block>
                                        </statement>
                                        <statement name="ELSE">
                                          <block type="variables_set_local">
                                            <field name="VAR" id="v04">暫存</field>
                                            <value name="VALUE">
                                              <block type="text_join">
                                                <mutation items="2"/>
                                                <value name="ADD0">
                                                  <block type="variables_get">
                                                    <field name="VAR" id="v04">暫存</field>
                                                  </block>
                                                </value>
                                                <value name="ADD1">
                                                  <block type="variables_get">
                                                    <field name="VAR" id="v06">字</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                          </block>
                                        </statement>
                                      </block>
                                    </next>
                                  </block>
                                </statement>
                                <next>
                                  <block type="controls_for">
                                    <field name="VAR" id="v07">s</field>
                                    <value name="FROM">
                                      <block type="math_number">
                                        <field name="NUM">1</field>
                                      </block>
                                    </value>
                                    <value name="TO">
                                      <block type="math_arithmetic">
                                        <field name="OP">ADD</field>
                                        <value name="A">
                                          <block type="math_arithmetic">
                                            <field name="OP">MINUS</field>
                                            <value name="A">
                                              <block type="lists_length">
                                                <value name="VALUE">
                                                  <block type="variables_get">
                                                    <field name="VAR" id="l01">數字</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <value name="B">
                                              <block type="variables_get">
                                                <field name="VAR" id="v02">K</field>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="math_number">
                                            <field name="NUM">1</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <value name="BY">
                                      <block type="math_number">
                                        <field name="NUM">1</field>
                                      </block>
                                    </value>
                                    <statement name="DO">
                                      <block type="variables_set_local">
                                        <field name="VAR" id="v08">總和</field>
                                        <value name="VALUE">
                                          <block type="math_number">
                                            <field name="NUM">0</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="controls_for">
                                            <field name="VAR" id="v09">j</field>
                                            <value name="FROM">
                                              <block type="variables_get">
                                                <field name="VAR" id="v07">s</field>
                                              </block>
                                            </value>
                                            <value name="TO">
                                              <block type="math_arithmetic">
                                                <field name="OP">MINUS</field>
                                                <value name="A">
                                                  <block type="math_arithmetic">
                                                    <field name="OP">ADD</field>
                                                    <value name="A">
                                                      <block type="variables_get">
                                                        <field name="VAR" id="v07">s</field>
                                                      </block>
                                                    </value>
                                                    <value name="B">
                                                      <block type="variables_get">
                                                        <field name="VAR" id="v02">K</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                                <value name="B">
                                                  <block type="math_number">
                                                    <field name="NUM">1</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <value name="BY">
                                              <block type="math_number">
                                                <field name="NUM">1</field>
                                              </block>
                                            </value>
                                            <statement name="DO">
                                              <block type="variables_set_local">
                                                <field name="VAR" id="v08">總和</field>
                                                <value name="VALUE">
                                                  <block type="math_arithmetic">
                                                    <field name="OP">ADD</field>
                                                    <value name="A">
                                                      <block type="variables_get">
                                                        <field name="VAR" id="v08">總和</field>
                                                      </block>
                                                    </value>
                                                    <value name="B">
                                                      <block type="lists_getIndex">
                                                        <mutation statement="false" at="true"/>
                                                        <field name="MODE">GET</field>
                                                        <field name="WHERE">FROM_START</field>
                                                        <value name="VALUE">
                                                          <block type="variables_get">
                                                            <field name="VAR" id="l01">數字</field>
                                                          </block>
                                                        </value>
                                                        <value name="AT">
                                                          <block type="variables_get">
                                                            <field name="VAR" id="v09">j</field>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                              </block>
                                            </statement>
                                            <next>
                                              <block type="javascript_data_output">
                                                <value name="TEXT">
                                                  <shadow type="text"><field name="TEXT"/></shadow>
                                                  <block type="math_arithmetic">
                                                    <field name="OP">DIVIDE</field>
                                                    <value name="A">
                                                      <block type="variables_get">
                                                        <field name="VAR" id="v08">總和</field>
                                                      </block>
                                                    </value>
                                                    <value name="B">
                                                      <block type="variables_get">
                                                        <field name="VAR" id="v02">K</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </value>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </statement>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

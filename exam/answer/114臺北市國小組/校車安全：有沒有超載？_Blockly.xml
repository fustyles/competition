<xml xmlns="https://developers.google.com/blockly/xml" platform="blockly">
  <variables>
    <variable id="v01">車號</variable>
    <variable id="v02">總人數</variable>
    <variable id="v03">人數</variable>
  </variables>
  <block x="20" y="20" type="controls_repeat_ext">
    <value name="TIMES">
      <block type="math_number">
        <field name="NUM">3</field>
      </block>
    </value>
    <statement name="DO">
      <block type="javascript_data_input_scratch">
        <value name="TEXT">
          <shadow type="text_noquotes">
            <field name="TEXT"/>
          </shadow>
        </value>
        <next>
          <block type="variables_set_local">
            <field name="VAR" id="v01">車號</field>
            <value name="VALUE">
              <block type="javascript_data_input_get_scratch"/>
            </value>
            <next>
              <block type="variables_set_local">
                <field name="VAR" id="v02">總人數</field>
                <value name="VALUE">
                  <block type="math_number">
                    <field name="NUM">0</field>
                  </block>
                </value>
                <next>
                  <block type="controls_repeat_ext">
                    <value name="TIMES">
                      <block type="math_number">
                        <field name="NUM">5</field>
                      </block>
                    </value>
                    <statement name="DO">
                      <block type="javascript_data_input_scratch">
                        <value name="TEXT">
                          <shadow type="text_noquotes">
                            <field name="TEXT"/>
                          </shadow>
                        </value>
                        <next>
                          <block type="variables_set_local">
                            <field name="VAR" id="v03">人數</field>
                            <value name="VALUE">
                              <block type="javascript_data_input_get_scratch"/>
                            </value>
                            <next>
                              <block type="variables_set_local">
                                <field name="VAR" id="v02">總人數</field>
                                <value name="VALUE">
                                  <block type="math_arithmetic">
                                    <field name="OP">ADD</field>
                                    <value name="A">
                                      <block type="variables_get">
                                        <field name="VAR" id="v02">總人數</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="variables_get">
                                        <field name="VAR" id="v03">人數</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <block type="controls_if">
                        <mutation elseif="0" else="1"/>
                        <value name="IF0">
                          <block type="logic_compare">
                            <field name="OP">GT</field>
                            <value name="A">
                              <block type="variables_get">
                                <field name="VAR" id="v02">總人數</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_number">
                                <field name="NUM">20</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="javascript_data_output">
                            <value name="TEXT">
                              <shadow type="text"><field name="TEXT"/></shadow>
                              <block type="text_join">
                                <mutation items="2"/>
                                <value name="ADD0">
                                  <block type="variables_get">
                                    <field name="VAR" id="v01">車號</field>
                                  </block>
                                </value>
                                <value name="ADD1">
                                  <block type="text">
                                    <field name="TEXT"> 車超載</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                          </block>
                        </statement>
                        <statement name="ELSE">
                          <block type="javascript_data_output">
                            <value name="TEXT">
                              <shadow type="text"><field name="TEXT"/></shadow>
                              <block type="text_join">
                                <mutation items="4"/>
                                <value name="ADD0">
                                  <block type="variables_get">
                                    <field name="VAR" id="v01">車號</field>
                                  </block>
                                </value>
                                <value name="ADD1">
                                  <block type="text">
                                    <field name="TEXT"> 車 </field>
                                  </block>
                                </value>
                                <value name="ADD2">
                                  <block type="variables_get">
                                    <field name="VAR" id="v02">總人數</field>
                                  </block>
                                </value>
                                <value name="ADD3">
                                  <block type="text">
                                    <field name="TEXT"> 人</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                          </block>
                        </statement>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>

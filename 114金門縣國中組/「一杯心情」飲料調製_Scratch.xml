<xml xmlns="https://developers.google.com/blockly/xml" platform="scratch">
  <variables>
    <variable type="Array" id="l01">代碼</variable>
    <variable type="Array" id="l02">密度</variable>
    <variable type="other" id="v01">原料</variable>
    <variable type="other" id="v02">數值</variable>
    <variable type="other" id="v03">最大位置</variable>
    <variable type="other" id="v04">i</variable>
  </variables>
  <block type="javascript_start_scratch" x="20" y="20">
    <next>
      <block type="list_deletealloflist_scratch">
        <field name="VAR" id="l01" variabletype="Array">代碼</field>
        <next>
          <block type="list_deletealloflist_scratch">
            <field name="VAR" id="l02" variabletype="Array">密度</field>
            <next>
              <block type="controls_repeat_ext_scratch">
                <value name="TIMES">
                  <shadow type="math_number">
                    <field name="NUM">5</field>
                  </shadow>
                </value>
                <statement name="DO">
                  <block type="javascript_data_input_scratch">
                    <value name="TEXT">
                      <shadow type="text_noquotes">
                        <field name="TEXT"/>
                      </shadow>
                    </value>
                    <next>
                      <block type="variables_set_other">
                        <field name="VAR" id="v01" variabletype="other">原料</field>
                        <value name="VALUE">
                          <shadow type="text_noquotes">
                            <field name="TEXT">0</field>
                          </shadow>
                          <block type="javascript_data_input_get_scratch"/>
                        </value>
                        <next>
                          <block type="list_addtolist_scratch">
                            <value name="ITEM">
                              <shadow type="text_noquotes">
                                <field name="TEXT"/>
                              </shadow>
                              <block type="variables_get_other">
                                <field name="VAR" id="v01" variabletype="other">原料</field>
                              </block>
                            </value>
                            <field name="VAR" id="l01" variabletype="Array">代碼</field>
                            <next>
                              <block type="javascript_data_input_scratch">
                                <value name="TEXT">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT"/>
                                  </shadow>
                                </value>
                                <next>
                                  <block type="variables_set_other">
                                    <field name="VAR" id="v02" variabletype="other">數值</field>
                                    <value name="VALUE">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">0</field>
                                      </shadow>
                                      <block type="javascript_data_input_get_scratch"/>
                                    </value>
                                    <next>
                                      <block type="list_addtolist_scratch">
                                        <value name="ITEM">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT"/>
                                          </shadow>
                                          <block type="variables_get_other">
                                            <field name="VAR" id="v02" variabletype="other">數值</field>
                                          </block>
                                        </value>
                                        <field name="VAR" id="l02" variabletype="Array">密度</field>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </statement>
                <next>
                  <block type="controls_repeat_ext_scratch">
                    <value name="TIMES">
                      <shadow type="math_number">
                        <field name="NUM">5</field>
                      </shadow>
                    </value>
                    <statement name="DO">
                      <block type="variables_set_other">
                        <field name="VAR" id="v03" variabletype="other">最大位置</field>
                        <value name="VALUE">
                          <shadow type="text_noquotes">
                            <field name="TEXT">1</field>
                          </shadow>
                        </value>
                        <next>
                          <block type="variables_set_other">
                            <field name="VAR" id="v04" variabletype="other">i</field>
                            <value name="VALUE">
                              <shadow type="text_noquotes">
                                <field name="TEXT">2</field>
                              </shadow>
                            </value>
                            <next>
                              <block type="controls_whileUntil_scratch">
                                <field name="MODE">UNTIL</field>
                                <value name="BOOL">
                                  <block type="logic_compare">
                                    <field name="OP">GT</field>
                                    <value name="A">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">0</field>
                                      </shadow>
                                      <block type="variables_get_other">
                                        <field name="VAR" id="v04" variabletype="other">i</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">5</field>
                                      </shadow>
                                    </value>
                                  </block>
                                </value>
                                <statement name="DO">
                                  <block type="controls_if_1_scratch">
                                    <value name="condition">
                                      <block type="logic_compare">
                                        <field name="OP">GT</field>
                                        <value name="A">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT">0</field>
                                          </shadow>
                                          <block type="list_itemoflist_scratch">
                                            <field name="VAR" id="l02" variabletype="Array">密度</field>
                                            <value name="INDEX">
                                              <shadow type="math_number">
                                                <field name="NUM">1</field>
                                              </shadow>
                                              <block type="variables_get_other">
                                                <field name="VAR" id="v04" variabletype="other">i</field>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT">0</field>
                                          </shadow>
                                          <block type="list_itemoflist_scratch">
                                            <field name="VAR" id="l02" variabletype="Array">密度</field>
                                            <value name="INDEX">
                                              <shadow type="math_number">
                                                <field name="NUM">1</field>
                                              </shadow>
                                              <block type="variables_get_other">
                                                <field name="VAR" id="v03" variabletype="other">最大位置</field>
                                              </block>
                                            </value>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <statement name="statement_if">
                                      <block type="variables_set_other">
                                        <field name="VAR" id="v03" variabletype="other">最大位置</field>
                                        <value name="VALUE">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT">0</field>
                                          </shadow>
                                          <block type="variables_get_other">
                                            <field name="VAR" id="v04" variabletype="other">i</field>
                                          </block>
                                        </value>
                                      </block>
                                    </statement>
                                    <next>
                                      <block type="math_change_other">
                                        <field name="VAR" id="v04" variabletype="other">i</field>
                                        <value name="DELTA">
                                          <shadow type="math_number">
                                            <field name="NUM">1</field>
                                          </shadow>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </statement>
                                <next>
                                  <block type="javascript_data_output_scratch">
                                    <value name="TEXT">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT"/>
                                      </shadow>
                                      <block type="list_itemoflist_scratch">
                                        <field name="VAR" id="l01" variabletype="Array">代碼</field>
                                        <value name="INDEX">
                                          <shadow type="math_number">
                                            <field name="NUM">1</field>
                                          </shadow>
                                          <block type="variables_get_other">
                                            <field name="VAR" id="v03" variabletype="other">最大位置</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="list_replaceitemoflist_scratch">
                                        <field name="VAR" id="l02" variabletype="Array">密度</field>
                                        <value name="INDEX">
                                          <shadow type="math_number">
                                            <field name="NUM">1</field>
                                          </shadow>
                                          <block type="variables_get_other">
                                            <field name="VAR" id="v03" variabletype="other">最大位置</field>
                                          </block>
                                        </value>
                                        <value name="ITEM">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT">-1</field>
                                          </shadow>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

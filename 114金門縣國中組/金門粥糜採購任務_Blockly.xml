<xml xmlns="https://developers.google.com/blockly/xml" platform="blockly">
  <variables>
    <variable id="l01">次數</variable>
    <variable id="v01">N</variable>
    <variable id="v02">店家</variable>
    <variable id="v03">M</variable>
  </variables>
  <block x="20" y="20" type="variables_set_local">
    <field name="VAR" id="l01">次數</field>
    <value name="VALUE">
      <block type="lists_create_with">
        <mutation items="0"/>
      </block>
    </value>
    <next>
      <block type="controls_repeat_ext">
        <value name="TIMES">
          <block type="math_number">
            <field name="NUM">9</field>
          </block>
        </value>
        <statement name="DO">
          <block type="lists_setIndex">
            <mutation at="false"/>
            <field name="MODE">INSERT</field>
            <field name="WHERE">LAST</field>
            <value name="LIST">
              <block type="variables_get">
                <field name="VAR" id="l01">次數</field>
              </block>
            </value>
            <value name="TO">
              <block type="math_number">
                <field name="NUM">0</field>
              </block>
            </value>
          </block>
        </statement>
        <next>
          <block type="javascript_data_input_scratch">
            <value name="TEXT">
              <shadow type="text_noquotes">
                <field name="TEXT"/>
              </shadow>
            </value>
            <next>
              <block type="variables_set_local">
                <field name="VAR" id="v01">N</field>
                <value name="VALUE">
                  <block type="javascript_data_input_get_scratch"/>
                </value>
                <next>
                  <block type="controls_repeat_ext">
                    <value name="TIMES">
                      <block type="variables_get">
                        <field name="VAR" id="v01">N</field>
                      </block>
                    </value>
                    <statement name="DO">
                      <block type="javascript_data_input_scratch">
                        <value name="TEXT">
                          <shadow type="text_noquotes">
                            <field name="TEXT"/>
                          </shadow>
                        </value>
                        <next>
                          <block type="variables_set_local">
                            <field name="VAR" id="v02">店家</field>
                            <value name="VALUE">
                              <block type="javascript_data_input_get_scratch"/>
                            </value>
                            <next>
                              <block type="lists_setIndex">
                                <mutation at="true"/>
                                <field name="MODE">SET</field>
                                <field name="WHERE">FROM_START</field>
                                <value name="LIST">
                                  <block type="variables_get">
                                    <field name="VAR" id="l01">次數</field>
                                  </block>
                                </value>
                                <value name="AT">
                                  <block type="variables_get">
                                    <field name="VAR" id="v02">店家</field>
                                  </block>
                                </value>
                                <value name="TO">
                                  <block type="math_arithmetic">
                                    <field name="OP">ADD</field>
                                    <value name="A">
                                      <block type="lists_getIndex">
                                        <mutation statement="false" at="true"/>
                                        <field name="MODE">GET</field>
                                        <field name="WHERE">FROM_START</field>
                                        <value name="VALUE">
                                          <block type="variables_get">
                                            <field name="VAR" id="l01">次數</field>
                                          </block>
                                        </value>
                                        <value name="AT">
                                          <block type="variables_get">
                                            <field name="VAR" id="v02">店家</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="math_number">
                                        <field name="NUM">1</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <block type="javascript_data_input_scratch">
                        <value name="TEXT">
                          <shadow type="text_noquotes">
                            <field name="TEXT"/>
                          </shadow>
                        </value>
                        <next>
                          <block type="variables_set_local">
                            <field name="VAR" id="v03">M</field>
                            <value name="VALUE">
                              <block type="javascript_data_input_get_scratch"/>
                            </value>
                            <next>
                              <block type="controls_repeat_ext">
                                <value name="TIMES">
                                  <block type="variables_get">
                                    <field name="VAR" id="v03">M</field>
                                  </block>
                                </value>
                                <statement name="DO">
                                  <block type="javascript_data_input_scratch">
                                    <value name="TEXT">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT"/>
                                      </shadow>
                                    </value>
                                    <next>
                                      <block type="variables_set_local">
                                        <field name="VAR" id="v02">店家</field>
                                        <value name="VALUE">
                                          <block type="javascript_data_input_get_scratch"/>
                                        </value>
                                        <next>
                                          <block type="controls_repeat_ext">
                                            <value name="TIMES">
                                              <block type="lists_getIndex">
                                                <mutation statement="false" at="true"/>
                                                <field name="MODE">GET</field>
                                                <field name="WHERE">FROM_START</field>
                                                <value name="VALUE">
                                                  <block type="variables_get">
                                                    <field name="VAR" id="l01">次數</field>
                                                  </block>
                                                </value>
                                                <value name="AT">
                                                  <block type="variables_get">
                                                    <field name="VAR" id="v02">店家</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </value>
                                            <statement name="DO">
                                              <block type="javascript_data_output">
                                                <value name="TEXT">
                                                  <shadow type="text"><field name="TEXT"/></shadow>
                                                  <block type="variables_get">
                                                    <field name="VAR" id="v02">店家</field>
                                                  </block>
                                                </value>
                                              </block>
                                            </statement>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </statement>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

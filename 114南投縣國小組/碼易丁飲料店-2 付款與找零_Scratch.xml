<xml xmlns="https://developers.google.com/blockly/xml" platform="scratch">
  <variables>
    <variable type="other" id="v01">N</variable>
    <variable type="Array" id="l01">價格</variable>
    <variable type="other" id="v02">總金額</variable>
    <variable type="other" id="v03">編號</variable>
    <variable type="other" id="v04">數量</variable>
    <variable type="other" id="v05">付款</variable>
  </variables>
  <block type="javascript_start_scratch" x="20" y="20">
    <next>
      <block type="javascript_data_input_scratch">
        <value name="TEXT">
          <shadow type="text_noquotes">
            <field name="TEXT"/>
          </shadow>
        </value>
        <next>
          <block type="variables_set_other">
            <field name="VAR" id="v01" variabletype="other">N</field>
            <value name="VALUE">
              <shadow type="text_noquotes">
                <field name="TEXT">0</field>
              </shadow>
              <block type="javascript_data_input_get_scratch"/>
            </value>
            <next>
              <block type="list_deletealloflist_scratch">
                <field name="VAR" id="l01" variabletype="Array">價格</field>
                <next>
                  <block type="list_addtolist_scratch">
                    <value name="ITEM">
                      <shadow type="text_noquotes">
                        <field name="TEXT">45</field>
                      </shadow>
                    </value>
                    <field name="VAR" id="l01" variabletype="Array">價格</field>
                    <next>
                      <block type="list_addtolist_scratch">
                        <value name="ITEM">
                          <shadow type="text_noquotes">
                            <field name="TEXT">25</field>
                          </shadow>
                        </value>
                        <field name="VAR" id="l01" variabletype="Array">價格</field>
                        <next>
                          <block type="list_addtolist_scratch">
                            <value name="ITEM">
                              <shadow type="text_noquotes">
                                <field name="TEXT">30</field>
                              </shadow>
                            </value>
                            <field name="VAR" id="l01" variabletype="Array">價格</field>
                            <next>
                              <block type="list_addtolist_scratch">
                                <value name="ITEM">
                                  <shadow type="text_noquotes">
                                    <field name="TEXT">40</field>
                                  </shadow>
                                </value>
                                <field name="VAR" id="l01" variabletype="Array">價格</field>
                                <next>
                                  <block type="list_addtolist_scratch">
                                    <value name="ITEM">
                                      <shadow type="text_noquotes">
                                        <field name="TEXT">60</field>
                                      </shadow>
                                    </value>
                                    <field name="VAR" id="l01" variabletype="Array">價格</field>
                                    <next>
                                      <block type="variables_set_other">
                                        <field name="VAR" id="v02" variabletype="other">總金額</field>
                                        <value name="VALUE">
                                          <shadow type="text_noquotes">
                                            <field name="TEXT">0</field>
                                          </shadow>
                                        </value>
                                        <next>
                                          <block type="controls_repeat_ext_scratch">
                                            <value name="TIMES">
                                              <shadow type="math_number">
                                                <field name="NUM">10</field>
                                              </shadow>
                                              <block type="variables_get_other">
                                                <field name="VAR" id="v01" variabletype="other">N</field>
                                              </block>
                                            </value>
                                            <statement name="DO">
                                              <block type="javascript_data_input_scratch">
                                                <value name="TEXT">
                                                  <shadow type="text_noquotes">
                                                    <field name="TEXT"/>
                                                  </shadow>
                                                </value>
                                                <next>
                                                  <block type="variables_set_other">
                                                    <field name="VAR" id="v03" variabletype="other">編號</field>
                                                    <value name="VALUE">
                                                      <shadow type="text_noquotes">
                                                        <field name="TEXT">0</field>
                                                      </shadow>
                                                      <block type="javascript_data_input_get_scratch"/>
                                                    </value>
                                                    <next>
                                                      <block type="javascript_data_input_scratch">
                                                        <value name="TEXT">
                                                          <shadow type="text_noquotes">
                                                            <field name="TEXT"/>
                                                          </shadow>
                                                        </value>
                                                        <next>
                                                          <block type="variables_set_other">
                                                            <field name="VAR" id="v04" variabletype="other">數量</field>
                                                            <value name="VALUE">
                                                              <shadow type="text_noquotes">
                                                                <field name="TEXT">0</field>
                                                              </shadow>
                                                              <block type="javascript_data_input_get_scratch"/>
                                                            </value>
                                                            <next>
                                                              <block type="math_change_other">
                                                                <field name="VAR" id="v02" variabletype="other">總金額</field>
                                                                <value name="DELTA">
                                                                  <shadow type="math_number">
                                                                    <field name="NUM">1</field>
                                                                  </shadow>
                                                                  <block type="math_arithmetic">
                                                                    <field name="OP">MULTIPLY</field>
                                                                    <value name="A">
                                                                      <shadow type="math_number">
                                                                        <field name="NUM">0</field>
                                                                      </shadow>
                                                                      <block type="list_itemoflist_scratch">
                                                                        <field name="VAR" id="l01" variabletype="Array">價格</field>
                                                                        <value name="INDEX">
                                                                          <shadow type="math_number">
                                                                            <field name="NUM">1</field>
                                                                          </shadow>
                                                                          <block type="variables_get_other">
                                                                            <field name="VAR" id="v03" variabletype="other">編號</field>
                                                                          </block>
                                                                        </value>
                                                                      </block>
                                                                    </value>
                                                                    <value name="B">
                                                                      <shadow type="math_number">
                                                                        <field name="NUM">0</field>
                                                                      </shadow>
                                                                      <block type="variables_get_other">
                                                                        <field name="VAR" id="v04" variabletype="other">數量</field>
                                                                      </block>
                                                                    </value>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </next>
                                                          </block>
                                                        </next>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </next>
                                              </block>
                                            </statement>
                                            <next>
                                              <block type="javascript_data_input_scratch">
                                                <value name="TEXT">
                                                  <shadow type="text_noquotes">
                                                    <field name="TEXT"/>
                                                  </shadow>
                                                </value>
                                                <next>
                                                  <block type="variables_set_other">
                                                    <field name="VAR" id="v05" variabletype="other">付款</field>
                                                    <value name="VALUE">
                                                      <shadow type="text_noquotes">
                                                        <field name="TEXT">0</field>
                                                      </shadow>
                                                      <block type="javascript_data_input_get_scratch"/>
                                                    </value>
                                                    <next>
                                                      <block type="javascript_data_output_scratch">
                                                        <value name="TEXT">
                                                          <shadow type="text_noquotes">
                                                            <field name="TEXT">總金額</field>
                                                          </shadow>
                                                        </value>
                                                        <next>
                                                          <block type="javascript_data_output_scratch">
                                                            <value name="TEXT">
                                                              <shadow type="text_noquotes">
                                                                <field name="TEXT"/>
                                                              </shadow>
                                                              <block type="variables_get_other">
                                                                <field name="VAR" id="v02" variabletype="other">總金額</field>
                                                              </block>
                                                            </value>
                                                            <next>
                                                              <block type="controls_if_2_scratch">
                                                                <value name="condition">
                                                                  <block type="logic_compare">
                                                                    <field name="OP">GTE</field>
                                                                    <value name="A">
                                                                      <shadow type="text_noquotes">
                                                                        <field name="TEXT">0</field>
                                                                      </shadow>
                                                                      <block type="variables_get_other">
                                                                        <field name="VAR" id="v05" variabletype="other">付款</field>
                                                                      </block>
                                                                    </value>
                                                                    <value name="B">
                                                                      <shadow type="text_noquotes">
                                                                        <field name="TEXT">0</field>
                                                                      </shadow>
                                                                      <block type="variables_get_other">
                                                                        <field name="VAR" id="v02" variabletype="other">總金額</field>
                                                                      </block>
                                                                    </value>
                                                                  </block>
                                                                </value>
                                                                <statement name="statement_if">
                                                                  <block type="javascript_data_output_scratch">
                                                                    <value name="TEXT">
                                                                      <shadow type="text_noquotes">
                                                                        <field name="TEXT">應找錢</field>
                                                                      </shadow>
                                                                    </value>
                                                                    <next>
                                                                      <block type="javascript_data_output_scratch">
                                                                        <value name="TEXT">
                                                                          <shadow type="text_noquotes">
                                                                            <field name="TEXT"/>
                                                                          </shadow>
                                                                          <block type="math_arithmetic">
                                                                            <field name="OP">MINUS</field>
                                                                            <value name="A">
                                                                              <shadow type="math_number">
                                                                                <field name="NUM">0</field>
                                                                              </shadow>
                                                                              <block type="variables_get_other">
                                                                                <field name="VAR" id="v05" variabletype="other">付款</field>
                                                                              </block>
                                                                            </value>
                                                                            <value name="B">
                                                                              <shadow type="math_number">
                                                                                <field name="NUM">0</field>
                                                                              </shadow>
                                                                              <block type="variables_get_other">
                                                                                <field name="VAR" id="v02" variabletype="other">總金額</field>
                                                                              </block>
                                                                            </value>
                                                                          </block>
                                                                        </value>
                                                                      </block>
                                                                    </next>
                                                                  </block>
                                                                </statement>
                                                                <statement name="statement_else">
                                                                  <block type="javascript_data_output_scratch">
                                                                    <value name="TEXT">
                                                                      <shadow type="text_noquotes">
                                                                        <field name="TEXT">付款不足</field>
                                                                      </shadow>
                                                                    </value>
                                                                    <next>
                                                                      <block type="javascript_data_output_scratch">
                                                                        <value name="TEXT">
                                                                          <shadow type="text_noquotes">
                                                                            <field name="TEXT"/>
                                                                          </shadow>
                                                                          <block type="math_arithmetic">
                                                                            <field name="OP">MINUS</field>
                                                                            <value name="A">
                                                                              <shadow type="math_number">
                                                                                <field name="NUM">0</field>
                                                                              </shadow>
                                                                              <block type="variables_get_other">
                                                                                <field name="VAR" id="v02" variabletype="other">總金額</field>
                                                                              </block>
                                                                            </value>
                                                                            <value name="B">
                                                                              <shadow type="math_number">
                                                                                <field name="NUM">0</field>
                                                                              </shadow>
                                                                              <block type="variables_get_other">
                                                                                <field name="VAR" id="v05" variabletype="other">付款</field>
                                                                              </block>
                                                                            </value>
                                                                          </block>
                                                                        </value>
                                                                      </block>
                                                                    </next>
                                                                  </block>
                                                                </statement>
                                                              </block>
                                                            </next>
                                                          </block>
                                                        </next>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

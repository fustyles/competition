<xml xmlns="https://developers.google.com/blockly/xml" platform="blockly">
  <variables>
    <variable id="v01">N</variable>
    <variable id="l01">價格</variable>
    <variable id="v02">總金額</variable>
    <variable id="v03">編號</variable>
    <variable id="v04">數量</variable>
    <variable id="v05">付款</variable>
  </variables>
  <block x="20" y="20" type="javascript_data_input_scratch">
    <value name="TEXT">
      <shadow type="text_noquotes">
        <field name="TEXT"/>
      </shadow>
    </value>
    <next>
      <block type="variables_set_local">
        <field name="VAR" id="v01">N</field>
        <value name="VALUE">
          <block type="javascript_data_input_get_scratch"/>
        </value>
        <next>
          <block type="variables_set_local">
            <field name="VAR" id="l01">價格</field>
            <value name="VALUE">
              <block type="lists_create_with">
                <mutation items="0"/>
              </block>
            </value>
            <next>
              <block type="lists_setIndex">
                <mutation at="false"/>
                <field name="MODE">INSERT</field>
                <field name="WHERE">LAST</field>
                <value name="LIST">
                  <block type="variables_get">
                    <field name="VAR" id="l01">價格</field>
                  </block>
                </value>
                <value name="TO">
                  <block type="math_number">
                    <field name="NUM">45</field>
                  </block>
                </value>
                <next>
                  <block type="lists_setIndex">
                    <mutation at="false"/>
                    <field name="MODE">INSERT</field>
                    <field name="WHERE">LAST</field>
                    <value name="LIST">
                      <block type="variables_get">
                        <field name="VAR" id="l01">價格</field>
                      </block>
                    </value>
                    <value name="TO">
                      <block type="math_number">
                        <field name="NUM">25</field>
                      </block>
                    </value>
                    <next>
                      <block type="lists_setIndex">
                        <mutation at="false"/>
                        <field name="MODE">INSERT</field>
                        <field name="WHERE">LAST</field>
                        <value name="LIST">
                          <block type="variables_get">
                            <field name="VAR" id="l01">價格</field>
                          </block>
                        </value>
                        <value name="TO">
                          <block type="math_number">
                            <field name="NUM">30</field>
                          </block>
                        </value>
                        <next>
                          <block type="lists_setIndex">
                            <mutation at="false"/>
                            <field name="MODE">INSERT</field>
                            <field name="WHERE">LAST</field>
                            <value name="LIST">
                              <block type="variables_get">
                                <field name="VAR" id="l01">價格</field>
                              </block>
                            </value>
                            <value name="TO">
                              <block type="math_number">
                                <field name="NUM">40</field>
                              </block>
                            </value>
                            <next>
                              <block type="lists_setIndex">
                                <mutation at="false"/>
                                <field name="MODE">INSERT</field>
                                <field name="WHERE">LAST</field>
                                <value name="LIST">
                                  <block type="variables_get">
                                    <field name="VAR" id="l01">價格</field>
                                  </block>
                                </value>
                                <value name="TO">
                                  <block type="math_number">
                                    <field name="NUM">60</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="variables_set_local">
                                    <field name="VAR" id="v02">總金額</field>
                                    <value name="VALUE">
                                      <block type="math_number">
                                        <field name="NUM">0</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="controls_repeat_ext">
                                        <value name="TIMES">
                                          <block type="variables_get">
                                            <field name="VAR" id="v01">N</field>
                                          </block>
                                        </value>
                                        <statement name="DO">
                                          <block type="javascript_data_input_scratch">
                                            <value name="TEXT">
                                              <shadow type="text_noquotes">
                                                <field name="TEXT"/>
                                              </shadow>
                                            </value>
                                            <next>
                                              <block type="variables_set_local">
                                                <field name="VAR" id="v03">編號</field>
                                                <value name="VALUE">
                                                  <block type="javascript_data_input_get_scratch"/>
                                                </value>
                                                <next>
                                                  <block type="javascript_data_input_scratch">
                                                    <value name="TEXT">
                                                      <shadow type="text_noquotes">
                                                        <field name="TEXT"/>
                                                      </shadow>
                                                    </value>
                                                    <next>
                                                      <block type="variables_set_local">
                                                        <field name="VAR" id="v04">數量</field>
                                                        <value name="VALUE">
                                                          <block type="javascript_data_input_get_scratch"/>
                                                        </value>
                                                        <next>
                                                          <block type="variables_set_local">
                                                            <field name="VAR" id="v02">總金額</field>
                                                            <value name="VALUE">
                                                              <block type="math_arithmetic">
                                                                <field name="OP">ADD</field>
                                                                <value name="A">
                                                                  <block type="variables_get">
                                                                    <field name="VAR" id="v02">總金額</field>
                                                                  </block>
                                                                </value>
                                                                <value name="B">
                                                                  <block type="math_arithmetic">
                                                                    <field name="OP">MULTIPLY</field>
                                                                    <value name="A">
                                                                      <block type="lists_getIndex">
                                                                        <mutation statement="false" at="true"/>
                                                                        <field name="MODE">GET</field>
                                                                        <field name="WHERE">FROM_START</field>
                                                                        <value name="VALUE">
                                                                          <block type="variables_get">
                                                                            <field name="VAR" id="l01">價格</field>
                                                                          </block>
                                                                        </value>
                                                                        <value name="AT">
                                                                          <block type="variables_get">
                                                                            <field name="VAR" id="v03">編號</field>
                                                                          </block>
                                                                        </value>
                                                                      </block>
                                                                    </value>
                                                                    <value name="B">
                                                                      <block type="variables_get">
                                                                        <field name="VAR" id="v04">數量</field>
                                                                      </block>
                                                                    </value>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </value>
                                                          </block>
                                                        </next>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </statement>
                                        <next>
                                          <block type="javascript_data_input_scratch">
                                            <value name="TEXT">
                                              <shadow type="text_noquotes">
                                                <field name="TEXT"/>
                                              </shadow>
                                            </value>
                                            <next>
                                              <block type="variables_set_local">
                                                <field name="VAR" id="v05">付款</field>
                                                <value name="VALUE">
                                                  <block type="javascript_data_input_get_scratch"/>
                                                </value>
                                                <next>
                                                  <block type="javascript_data_output">
                                                    <value name="TEXT">
                                                      <shadow type="text"><field name="TEXT"/></shadow>
                                                      <block type="text">
                                                        <field name="TEXT">總金額</field>
                                                      </block>
                                                    </value>
                                                    <next>
                                                      <block type="javascript_data_output">
                                                        <value name="TEXT">
                                                          <shadow type="text"><field name="TEXT"/></shadow>
                                                          <block type="variables_get">
                                                            <field name="VAR" id="v02">總金額</field>
                                                          </block>
                                                        </value>
                                                        <next>
                                                          <block type="controls_if">
                                                            <mutation elseif="0" else="1"/>
                                                            <value name="IF0">
                                                              <block type="logic_compare">
                                                                <field name="OP">GTE</field>
                                                                <value name="A">
                                                                  <block type="variables_get">
                                                                    <field name="VAR" id="v05">付款</field>
                                                                  </block>
                                                                </value>
                                                                <value name="B">
                                                                  <block type="variables_get">
                                                                    <field name="VAR" id="v02">總金額</field>
                                                                  </block>
                                                                </value>
                                                              </block>
                                                            </value>
                                                            <statement name="DO0">
                                                              <block type="javascript_data_output">
                                                                <value name="TEXT">
                                                                  <shadow type="text"><field name="TEXT"/></shadow>
                                                                  <block type="text">
                                                                    <field name="TEXT">應找錢</field>
                                                                  </block>
                                                                </value>
                                                                <next>
                                                                  <block type="javascript_data_output">
                                                                    <value name="TEXT">
                                                                      <shadow type="text"><field name="TEXT"/></shadow>
                                                                      <block type="math_arithmetic">
                                                                        <field name="OP">MINUS</field>
                                                                        <value name="A">
                                                                          <block type="variables_get">
                                                                            <field name="VAR" id="v05">付款</field>
                                                                          </block>
                                                                        </value>
                                                                        <value name="B">
                                                                          <block type="variables_get">
                                                                            <field name="VAR" id="v02">總金額</field>
                                                                          </block>
                                                                        </value>
                                                                      </block>
                                                                    </value>
                                                                  </block>
                                                                </next>
                                                              </block>
                                                            </statement>
                                                            <statement name="ELSE">
                                                              <block type="javascript_data_output">
                                                                <value name="TEXT">
                                                                  <shadow type="text"><field name="TEXT"/></shadow>
                                                                  <block type="text">
                                                                    <field name="TEXT">付款不足</field>
                                                                  </block>
                                                                </value>
                                                                <next>
                                                                  <block type="javascript_data_output">
                                                                    <value name="TEXT">
                                                                      <shadow type="text"><field name="TEXT"/></shadow>
                                                                      <block type="math_arithmetic">
                                                                        <field name="OP">MINUS</field>
                                                                        <value name="A">
                                                                          <block type="variables_get">
                                                                            <field name="VAR" id="v02">總金額</field>
                                                                          </block>
                                                                        </value>
                                                                        <value name="B">
                                                                          <block type="variables_get">
                                                                            <field name="VAR" id="v05">付款</field>
                                                                          </block>
                                                                        </value>
                                                                      </block>
                                                                    </value>
                                                                  </block>
                                                                </next>
                                                              </block>
                                                            </statement>
                                                          </block>
                                                        </next>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

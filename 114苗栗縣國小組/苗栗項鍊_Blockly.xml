<xml xmlns="https://developers.google.com/blockly/xml" platform="blockly">
  <variables>
    <variable id="v01">N</variable>
    <variable id="v02">項鍊</variable>
  </variables>
  <block x="20" y="20" type="javascript_data_input_scratch">
    <value name="TEXT">
      <shadow type="text_noquotes">
        <field name="TEXT"/>
      </shadow>
    </value>
    <next>
      <block type="variables_set_local">
        <field name="VAR" id="v01">N</field>
        <value name="VALUE">
          <block type="javascript_data_input_get_scratch"/>
        </value>
        <next>
          <block type="variables_set_local">
            <field name="VAR" id="v02">項鍊</field>
            <value name="VALUE">
              <block type="text">
                <field name="TEXT"/>
              </block>
            </value>
            <next>
              <block type="controls_repeat_ext">
                <value name="TIMES">
                  <block type="variables_get">
                    <field name="VAR" id="v01">N</field>
                  </block>
                </value>
                <statement name="DO">
                  <block type="variables_set_local">
                    <field name="VAR" id="v02">項鍊</field>
                    <value name="VALUE">
                      <block type="text_join">
                        <mutation items="2"/>
                        <value name="ADD0">
                          <block type="variables_get">
                            <field name="VAR" id="v02">項鍊</field>
                          </block>
                        </value>
                        <value name="ADD1">
                          <block type="text">
                            <field name="TEXT">ML</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </statement>
                <next>
                  <block type="javascript_data_output">
                    <value name="TEXT">
                      <shadow type="text"><field name="TEXT"/></shadow>
                      <block type="variables_get">
                        <field name="VAR" id="v02">項鍊</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

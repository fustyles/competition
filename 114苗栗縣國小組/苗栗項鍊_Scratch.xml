<xml xmlns="https://developers.google.com/blockly/xml" platform="scratch">
  <variables>
    <variable type="other" id="v01">N</variable>
    <variable type="other" id="v02">項鍊</variable>
  </variables>
  <block type="javascript_start_scratch" x="20" y="20">
    <next>
      <block type="javascript_data_input_scratch">
        <value name="TEXT">
          <shadow type="text_noquotes">
            <field name="TEXT"/>
          </shadow>
        </value>
        <next>
          <block type="variables_set_other">
            <field name="VAR" id="v01" variabletype="other">N</field>
            <value name="VALUE">
              <shadow type="text_noquotes">
                <field name="TEXT">0</field>
              </shadow>
              <block type="javascript_data_input_get_scratch"/>
            </value>
            <next>
              <block type="variables_set_other">
                <field name="VAR" id="v02" variabletype="other">項鍊</field>
                <value name="VALUE">
                  <shadow type="text_noquotes">
                    <field name="TEXT"/>
                  </shadow>
                </value>
                <next>
                  <block type="controls_repeat_ext_scratch">
                    <value name="TIMES">
                      <shadow type="math_number">
                        <field name="NUM">10</field>
                      </shadow>
                      <block type="variables_get_other">
                        <field name="VAR" id="v01" variabletype="other">N</field>
                      </block>
                    </value>
                    <statement name="DO">
                      <block type="variables_set_other">
                        <field name="VAR" id="v02" variabletype="other">項鍊</field>
                        <value name="VALUE">
                          <shadow type="text_noquotes">
                            <field name="TEXT">0</field>
                          </shadow>
                          <block type="text_join_scratch">
                            <value name="VALUE1">
                              <shadow type="text_noquotes">
                                <field name="TEXT"/>
                              </shadow>
                              <block type="variables_get_other">
                                <field name="VAR" id="v02" variabletype="other">項鍊</field>
                              </block>
                            </value>
                            <value name="VALUE2">
                              <shadow type="text_noquotes">
                                <field name="TEXT">ML</field>
                              </shadow>
                            </value>
                          </block>
                        </value>
                      </block>
                    </statement>
                    <next>
                      <block type="javascript_data_output_scratch">
                        <value name="TEXT">
                          <shadow type="text_noquotes">
                            <field name="TEXT"/>
                          </shadow>
                          <block type="variables_get_other">
                            <field name="VAR" id="v02" variabletype="other">項鍊</field>
                          </block>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
